+void open(WindowApp app) {
+  switch (app) {
+    case WindowApp::Terminal:
+      if (s.terminal.lines[TerminalState::k_lines - 1][0] == 0 &&
+          s.terminal.lines[TerminalState::k_lines - 2][0] == 0) {
+        Term::reset();
+      }
+      break;
+    case WindowApp::Files:
+      s.files.confirmDelete = false;
+      break;
+    case WindowApp::SysMonitor:
+      s.sysmon.selected = 0;
+      s.sysmon.confirmKill = false;
+      break;
+    case WindowApp::Snake:
+      if (s.snake.length == 0) {
+        SnakeGame::reset(s.snake);
+      }
+      break;
+    case WindowApp::Game2048: {
+      bool empty = true;
+      for (uint16_t v : s.g2048.cells) {
+        empty = empty && v == 0;
+      }
+      if (empty) {
+        G2048::reset(s.g2048);
+      }
+      break;
+    }
+    case WindowApp::Mines:
+      if (!s.mines.started) {
+        Mines::reset(s.mines);
+      }
+      break;
+    default:
+      break;
+  }
