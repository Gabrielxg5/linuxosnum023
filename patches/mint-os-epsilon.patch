+
+}  // namespace
+
+/* ============================================================== Storage */
+
+namespace Storage {
+
+namespace {
+constexpr const char* k_extensions[] = {"py", "exp", "func", "seq", "lis",
+                                        "mat", "sys"};
+FileSystem* fs() { return FileSystem::sharedFileSystem; }
+}  // namespace
+
+int count(int section) {
+  if (section == 1) {
+    return fs()->numberOfRecordsWithExtension("py");
+  }
+  int n = 0;
+  for (const char* ext : k_extensions) {
+    if (section == 2 && strcmp(ext, "py") == 0) {
+      continue;
+    }
+    n += fs()->numberOfRecordsWithExtension(ext);
+  }
+  return n;
+}
+
+Record at(int section, int index) {
+  if (section == 1) {
+    return fs()->recordWithExtensionAtIndex("py", index);
+  }
+  for (const char* ext : k_extensions) {
+    if (section == 2 && strcmp(ext, "py") == 0) {
+      continue;
+    }
+    int n = fs()->numberOfRecordsWithExtension(ext);
+    if (index < n) {
+      return fs()->recordWithExtensionAtIndex(ext, index);
+    }
+    index -= n;
+  }
+  return Record();
+}
+
+bool find(const char* name, Record* result) {
+  int n = count(0);
+  for (int i = 0; i < n; i++) {
+    Record r = at(0, i);
+    const char* full = r.fullName();
+    if (full == nullptr) {
+      continue;
+    }
+    // Exact full name, or base name without extension
+    size_t len = strlen(name);
+    if (strcmp(full, name) == 0 ||
+        (strncmp(full, name, len) == 0 && full[len] == '.')) {
+      *result = r;
+      return true;
+    }
+  }
+  return false;
+}
+
+void sizeText(char* buffer, int size, size_t bytes) {
+  if (bytes < 1024) {
+    fmt(buffer, size, "%d o", static_cast<int>(bytes));
+  } else {
+    fmt(buffer, size, "%d,%d Ko", static_cast<int>(bytes / 1024),
+        static_cast<int>((bytes % 1024) * 10 / 1024));
+  }
+}
+
+}  // namespace Storage
+
+namespace {
+
+void launchRecord(Record r) {
+  I18n::Message app = I18n::Message::CalculApp;
+  if (r.hasExtension("py")) {
+    app = I18n::Message::CodeApp;
+  } else if (r.hasExtension("func")) {
+    app = I18n::Message::FunctionApp;
+  } else if (r.hasExtension("seq")) {
+    app = I18n::Message::SequenceApp;
+  } else if (r.hasExtension("lis")) {
+    app = I18n::Message::StatsApp;
+  }
+  requestLaunch(builtinNamed(app));
+}
+
+/* =============================================================== Files */
+
+namespace Files {
+
+constexpr int k_width = 292;
+constexpr int k_height = 162;
+constexpr int k_toolbar = 24;
+constexpr int k_sidebar = 80;
+constexpr int k_status = 16;
+constexpr int k_cellW = 52;
+constexpr int k_cellH = 46;
+constexpr int k_places = 5;
+
+// Places: 0 home, 1 documents, 2 scripts, 3 trash, 4 computer, then the
+// empty folders of the home directory
+constexpr const char* k_emptyFolders[] = {"Bureau", "Images", "Musique",
+                                          "Téléchargements", "Vidéos"};
+constexpr int k_numberOfEmptyFolders = 5;
+
+const char* placeName(int place) {
+  switch (place) {
+    case 0:
+      return "numworks";
+    case 1:
+      return "Documents";
+    case 2:
+      return "Scripts";
+    case 3:
+      return "Corbeille";
+    case 4:
+      return "Ordinateur";
+    default:
+      return k_emptyFolders[place - 5];
+  }
+}
+
+int itemCount() {
+  switch (s.files.place) {
+    case 0:
+      return 2 + k_numberOfEmptyFolders;
+    case 1:
+      return Storage::count(2);
+    case 2:
+      return Storage::count(1);
+    case 4:
+      return 2;
+    default:
+      return 0;
+  }
+}
+
+// Home folder order: Bureau, Documents, Images, Musique, Scripts,
+// Téléchargements, Vidéos (alphabetical, like Nemo)
+int homeItemPlace(int i) {
+  constexpr int k_order[7] = {5, 1, 6, 7, 2, 8, 9};
+  return k_order[i];
+}
+
+bool itemIsFolder(int i) { return s.files.place == 0 || s.files.place == 4; }
+
+const char* itemName(int i, Record* record) {
+  switch (s.files.place) {
+    case 0:
+      return placeName(homeItemPlace(i));
+    case 1:
+    case 2:
+      *record = Storage::at(s.files.place == 1 ? 2 : 1, i);
+      return record->fullName();
+    case 4:
+      return i == 0 ? "Système" : "Calculatrice";
+    default:
+      return "";
+  }
+}
+
+int columns(Rect c) {
+  int n = (c.w - k_sidebar - 4) / k_cellW;
+  return n < 1 ? 1 : n;
+}
+
+int visibleRows(Rect c) { return (c.h - k_toolbar - k_status - 4) / k_cellH; }
+
+Rect cellRect(Rect c, int i) {
+  int col = columns(c);
+  int row = i / col - s.files.scroll;
+  return {c.x + k_sidebar + 4 + (i % col) * k_cellW,
+          c.y + k_toolbar + 4 + row * k_cellH, k_cellW, k_cellH};
+}
+
+Rect sideRect(Rect c, int i) {
+  return {c.x + 2, c.y + k_toolbar + 16 + i * 18, k_sidebar - 4, 17};
+}
+
+Rect toolButton(Rect c, int i) { return {c.x + 4 + i * 22, c.y + 3, 20, 18}; }
+
+void fixScroll(Rect c) {
+  FilesState& f = s.files;
+  int col = columns(c);
+  int rows = visibleRows(c);
+  if (f.selected >= 0) {
+    int row = f.selected / col;
+    if (row < f.scroll) {
+      f.scroll = row;
+    }
+    if (row >= f.scroll + rows) {
+      f.scroll = row - rows + 1;
+    }
+  }
+}
+
+void go(int place, Rect c) {
+  s.files.place = place;
+  s.files.selected = -1;
+  s.files.scroll = 0;
+  s.files.confirmDelete = false;
+  invalidate(c);
+}
+
+uint8_t fileTile(const Record& r) {
+  return r.hasExtension("py") ? MintIcons::TilePythonFile
+                              : MintIcons::TileDocument;
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  FilesState& f = s.files;
+  fill(b, c, p.view);
+  // Toolbar: back, up, path bar
+  fill(b, {c.x, c.y, c.w, k_toolbar}, p.windowBack);
+  fill(b, {c.x, c.y + k_toolbar - 1, c.w, 1}, p.border, 120);
+  for (int i = 0; i < 2; i++) {
+    Rect r = toolButton(c, i);
+    roundFill(b, r, 3, p.button);
+    text(b, i == 0 ? "<" : "^", r.x + r.w / 2, r.y + 2, p.winText, Small,
+         Align::Center);
+  }
+  int x = c.x + 52;
+  Rect home = {x, c.y + 3, textWidth("numworks") + 10, 18};
+  roundFill(b, home, 3, f.place == 0 ? p.accent : p.button);
+  text(b, "numworks", home.x + 5, home.y + 2, f.place == 0 ? KDWhite : p.winText);
+  if (f.place != 0) {
+    Rect here = {home.right() + 4, c.y + 3, textWidth(placeName(f.place)) + 10,
+                 18};
+    if (f.place == 3 || f.place == 4) {
+      here.x = x;
+      fill(b, home, p.windowBack);
+    }
+    roundFill(b, here, 3, p.accent);
+    text(b, placeName(f.place), here.x + 5, here.y + 2, KDWhite, Small,
+         Align::Left, c.right() - here.x - 8);
+  }
+  // Sidebar
+  fill(b, {c.x, c.y + k_toolbar, k_sidebar, c.h - k_toolbar}, p.viewAlt);
+  fill(b, {c.x + k_sidebar - 1, c.y + k_toolbar, 1, c.h - k_toolbar}, p.border,
+       90);
+  text(b, "Mes dossiers", c.x + 6, c.y + k_toolbar + 1, p.winTextDim);
+  const MintIcons::Mask* icons[k_places] = {
+      &MintIcons::k_maskUser, &MintIcons::k_maskFile, &MintIcons::k_maskFolder,
+      &MintIcons::k_maskTrash, &MintIcons::k_maskDisc};
+  constexpr const char* k_side[k_places] = {"Dossier perso", "Documents",
+                                            "Scripts", "Corbeille",
+                                            "Ordinateur"};
+  for (int i = 0; i < k_places; i++) {
+    Rect r = sideRect(c, i);
+    bool sel = f.place == i;
+    if (sel) {
+      fill(b, r, p.accent);
+    }
+    const MintIcons::Mask& m = *icons[i];
+    int ms = m.size > 12 ? 12 : m.size;
+    if (m.size > 12) {
+      roundFill(b, {r.x + 5, r.y + 3, 11, 11}, 5, sel ? KDWhite : p.winTextDim);
+    } else {
+      mask(b, m, r.x + 4, r.y + 2, sel ? KDWhite : p.winTextDim);
+    }
+    (void)ms;
+    text(b, k_side[i], r.x + 19, r.y + 1, sel ? KDWhite : p.winText, Small,
+         Align::Left, r.w - 20);
+  }
+  // Items
+  int n = itemCount();
+  Rect area = {c.x + k_sidebar, c.y + k_toolbar, c.w - k_sidebar,
+               c.h - k_toolbar - k_status};
+  if (n == 0) {
+    const char* msg = f.place == 3 ? "La corbeille est vide"
+                                   : "Ce dossier est vide";
+    mask(b, f.place == 3 ? MintIcons::k_maskTrash : MintIcons::k_maskFolder,
+         area.x + area.w / 2 - 6, area.y + 40, p.winTextDim);
+    text(b, msg, area.x + area.w / 2, area.y + 58, p.winTextDim, Small,
+         Align::Center);
+  }
+  if (f.place == 4) {
+    // Computer: two drives with their usage
+    FileSystem* fsys = FileSystem::sharedFileSystem;
+    size_t total = FileSystem::k_totalSize;
+    size_t used = total - fsys->availableSize();
+    for (int i = 0; i < 2; i++) {
+      Rect r = {area.x + 6, area.y + 6 + i * 40, area.w - 12, 36};
+      if (i == f.selected) {
+        roundFill(b, r, 3, focused ? p.accent : p.hover, focused ? 90 : 255);
+      }
+      tile(b, i == 0 ? MintIcons::TileComputer : MintIcons::TileCode, 24, r.x + 4,
+           r.y + 6);
+      char line[40];
+      if (i == 0) {
+        text(b, "Système de fichiers", r.x + 34, r.y + 2, p.winText);
+        char u[12], t[12];
+        Storage::sizeText(u, sizeof(u), used);
+        Storage::sizeText(t, sizeof(t), total);
+        fmt(line, sizeof(line), "%s utilisés sur %s", u, t);
+        progressBar(b, {r.x + 34, r.y + 18, r.w - 40, 5},
+                    static_cast<int>(used * 1000 / total), p.accent);
+        text(b, line, r.x + 34, r.y + 22, p.winTextDim, Small, Align::Left,
+             r.w - 36);
+      } else {
+        text(b, "Calculatrice (flash)", r.x + 34, r.y + 2, p.winText);
+        text(b, Ion::softwareVersion(), r.x + 34, r.y + 18, p.winTextDim);
+      }
+    }
+  } else {
+    int rows = visibleRows(c);
+    int col = columns(c);
+    for (int i = f.scroll * col; i < n && i < (f.scroll + rows) * col; i++) {
+      Rect r = cellRect(c, i);
+      if (!r.intersects(b.clip())) {
+        continue;
+      }
+      Record record;
+      const char* name = itemName(i, &record);
+      bool sel = i == f.selected;
+      if (sel) {
+        roundFill(b, r.inset(1), 3, p.accent, focused ? 200 : 120);
+      }
+      uint8_t t;
+      if (f.place == 0) {
+        int place = homeItemPlace(i);
+        t = place == 1   ? MintIcons::TileDocuments
+            : place == 2 ? MintIcons::TileScripts
+                         : MintIcons::TileFiles;
+      } else {
+        t = fileTile(record);
+      }
+      tile(b, t, 24, r.x + (r.w - 24) / 2, r.y + 3);
+      text(b, name, r.x + r.w / 2, r.y + 29, sel ? KDWhite : p.winText, Small,
+           Align::Center, r.w - 2);
+    }
+  }
+  // Status bar or confirmation
+  Rect status = {c.x + k_sidebar, c.bottom() - k_status, c.w - k_sidebar,
+                 k_status};
+  fill(b, status, p.windowBack);
+  char line[48];
+  if (f.confirmDelete) {
+    fill(b, status, KDColor::RGB24(0xC0392B));
+    text(b, "Supprimer définitivement ? OK : oui", status.x + 4, status.y + 1,
+         KDWhite, Small, Align::Left, status.w - 6);
+  } else {
+    char free[12];
+    Storage::sizeText(free, sizeof(free),
+                      FileSystem::sharedFileSystem->availableSize());
+    if (f.selected >= 0 && f.selected < n && (f.place == 1 || f.place == 2)) {
+      Record r;
+      const char* name = itemName(f.selected, &r);
+      char size[12];
+      Storage::sizeText(size, sizeof(size), r.value().size);
+      fmt(line, sizeof(line), "« %s » (%s)", name, size);
+    } else {
+      fmt(line, sizeof(line), "%d éléments, libre : %s", n, free);
+    }
+    text(b, line, status.x + status.w / 2, status.y + 1, p.winTextDim, Small,
+         Align::Center, status.w - 4);
+  }
+}
+
+void openSelected(Rect c) {
+  FilesState& f = s.files;
+  int n = itemCount();
+  if (f.selected < 0 || f.selected >= n) {
+    return;
+  }
+  if (f.place == 0) {
+    go(homeItemPlace(f.selected), c);
+  } else if (f.place == 4) {
+    go(f.selected == 0 ? 0 : 2, c);
+  } else {
+    Record r;
+    itemName(f.selected, &r);
+    launchRecord(r);
+  }
+}
+
+void deleteSelected(Rect c) {
+  FilesState& f = s.files;
+  if (f.selected < 0 || (f.place != 1 && f.place != 2)) {
+    return;
+  }
+  if (!f.confirmDelete) {
+    f.confirmDelete = true;
+    invalidate(c);
+    return;
+  }
+  f.confirmDelete = false;
+  Record r;
+  itemName(f.selected, &r);
+  r.tryToDestroy();
+  int n = itemCount();
+  if (f.selected >= n) {
+    f.selected = n - 1;
+  }
+  invalidate(c);
+}
+
+void click(int x, int y, bool right, Rect c) {
+  FilesState& f = s.files;
+  int ax = c.x + x, ay = c.y + y;
+  bool wasConfirm = f.confirmDelete;
+  f.confirmDelete = false;
+  if (wasConfirm) {
+    Rect status = {c.x + k_sidebar, c.bottom() - k_status, c.w - k_sidebar,
+                   k_status};
+    if (status.contains(ax, ay)) {
+      f.confirmDelete = true;
+      deleteSelected(c);
+      return;
+    }
+    invalidate(c);
+  }
+  for (int i = 0; i < k_places; i++) {
+    if (sideRect(c, i).contains(ax, ay)) {
+      go(i, c);
+      return;
+    }
+  }
+  if (toolButton(c, 0).contains(ax, ay) || toolButton(c, 1).contains(ax, ay)) {
+    // Back and up both go to the parent
+    go(f.place == 0 ? 4 : 0, c);
+    return;
+  }
+  int n = itemCount();
+  if (f.place == 4) {
+    for (int i = 0; i < 2; i++) {
+      Rect r = {c.x + k_sidebar + 6, c.y + k_toolbar + 6 + i * 40,
+                c.w - k_sidebar - 12, 36};
+      if (r.contains(ax, ay)) {
+        bool again = f.selected == i;
+        f.selected = i;
+        invalidate(c);
+        if (again && !right) {
+          openSelected(c);
+        }
+        return;
+      }
+    }
+    return;
+  }
+  int col = columns(c);
+  int rows = visibleRows(c);
+  for (int i = f.scroll * col; i < n && i < (f.scroll + rows) * col; i++) {
+    if (cellRect(c, i).contains(ax, ay)) {
+      bool again = f.selected == i;
+      f.selected = i;
+      invalidate(c);
+      if (right) {
+        openFileContext(f.place == 1 || f.place == 2 ? 2 : 1);
+      } else if (again) {
+        openSelected(c);
+      }
+      return;
+    }
+  }
+  if (f.selected >= 0) {
+    f.selected = -1;
+    invalidate(c);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  FilesState& f = s.files;
+  int n = itemCount();
+  int col = f.place == 4 ? 1 : columns(c);
+  int delta = e == Events::Left    ? -1
+              : e == Events::Right ? 1
+              : e == Events::Up    ? -col
+              : e == Events::Down  ? col
+                                   : 0;
+  if (delta != 0) {
+    f.confirmDelete = false;
+    int next = f.selected < 0 ? 0 : f.selected + delta;
+    if (next >= 0 && next < n) {
+      f.selected = next;
+    }
+    fixScroll(c);
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (f.confirmDelete) {
+      deleteSelected(c);
+    } else {
+      openSelected(c);
+    }
+    return true;
+  }
+  if (e == Events::Backspace) {
+    deleteSelected(c);
+    return true;
+  }
+  if (e == Events::Clear || e == Events::Ans) {
+    go(0, c);
+    return true;
+  }
+  return false;
+}
