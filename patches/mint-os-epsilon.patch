@@ -0,0 +1,24 @@
+#pragma once
+
+#include <stdint.h>
+
+/* Mint-OS: the last results of the Calculation app, so that the desktop can
+ * show a notification about them and the terminal can list them in
+ * `history`. Filled by apps/calculation (see the patch). */
+
+namespace Home {
+namespace Mint {
+namespace Calc {
+
+constexpr int k_textSize = 32;
+constexpr int k_capacity = 8;
+
+void push(const char* input, const char* output);
+// Number of results pushed since the calculator started (wraps at 256)
+uint8_t count();
+// i = 0 is the most recent; false if there is no such result
+bool at(int i, const char** input, const char** output);
+
+}  // namespace Calc
+}  // namespace Mint
+}  // namespace Home
