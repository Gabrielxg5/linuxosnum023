+    text(b, info.title, r.x + 28, r.y - 1, p.winText, Small, Align::Left,
+         r.w - 104);
+    text(b, info.description, r.x + 28, r.y + 11, p.winTextDim, Small,
+         Align::Left, r.w - 104);
+    Rect a = actionRect(c, i);
+    if (sw.installing == index) {
+      progressBar(b, {a.x, a.y + 6, a.w, 6}, sw.progress, p.accent);
+    } else if (isInstalled(pk)) {
+      button(b, a, "Supprimer");
+    } else {
+      button(b, a, "Installer", true);
+    }
+  }
+  // Scroll indicator
+  int track = k_visibleRows * k_rowHeight;
+  int h = track * k_visibleRows / k_numberOfPackages;
+  int y = c.y + k_banner + 4 + track * sw.scroll / k_numberOfPackages;
+  fill(b, {c.right() - 3, y, 2, h}, p.winTextDim);
+  int installed = 0;
+  for (int i = 0; i < k_numberOfPackages; i++) {
+    installed += isInstalled(static_cast<Package>(i)) ? 1 : 0;
+  }
+  fmt(line, sizeof(line), "%d paquets installés", installed);
+  text(b, line, c.x + c.w / 2, c.bottom() - 15, p.winTextDim, Small,
+       Align::Center);
+}
+
+void act(int index, Rect c) {
+  SoftwareState& sw = s.software;
+  if (sw.installing >= 0 || index < 0 || index >= k_numberOfPackages) {
+    return;
+  }
+  sw.installing = index;
+  sw.progress = 0;
+  invalidate(c);
+}
+
+void fixScroll() {
+  SoftwareState& sw = s.software;
+  if (sw.selected < sw.scroll) {
+    sw.scroll = sw.selected;
+  }
+  if (sw.selected >= sw.scroll + k_visibleRows) {
+    sw.scroll = sw.selected - k_visibleRows + 1;
+  }
+}
+
+void click(int x, int y, bool right, Rect c) {
+  SoftwareState& sw = s.software;
+  int ax = c.x + x, ay = c.y + y;
+  for (int i = 0; i < k_visibleRows; i++) {
+    int index = sw.scroll + i;
+    if (index >= k_numberOfPackages) {
+      break;
+    }
+    if (actionRect(c, i).contains(ax, ay)) {
+      sw.selected = index;
+      act(index, c);
+      return;
+    }
+    if (rowRect(c, i).contains(ax, ay)) {
+      sw.selected = index;
+      invalidate(c);
+      return;
+    }
+  }
+  // Click under the list: scroll down, above: scroll up
+  if (ay > rowRect(c, k_visibleRows - 1).bottom()) {
+    sw.scroll = sw.scroll + k_visibleRows < k_numberOfPackages
+                    ? sw.scroll + 1
+                    : sw.scroll;
+  } else if (ay < c.y + k_banner && sw.scroll > 0) {
+    sw.scroll--;
+  }
+  invalidate(c);
+}
+
+bool handleKey(Event e, Rect c) {
+  SoftwareState& sw = s.software;
+  if (e == Events::Up || e == Events::Down) {
+    int next = sw.selected + (e == Events::Up ? -1 : 1);
+    if (next >= 0 && next < k_numberOfPackages) {
+      sw.selected = next;
+    }
+    fixScroll();
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    act(sw.selected, c);
+    return true;
+  }
+  return false;
+}
+
+bool tick(Rect c) {
+  SoftwareState& sw = s.software;
+  if (sw.installing < 0) {
+    return false;
+  }
+  sw.progress += 90 + random(60);
+  if (sw.progress >= 1000) {
+    Package pk = static_cast<Package>(sw.installing);
+    bool install = !isInstalled(pk);
+    setInstalled(pk, install);
+    char body[56];
+    fmt(body, sizeof(body), "%s a été %s.", packageInfo(pk).title,
+        install ? "installé" : "supprimé");
+    notify("Logithèque", body, packageInfo(pk).tile);
+    sw.installing = -1;
+    invalidateAll();
+  }
+  invalidate(c);
+  return true;
+}
