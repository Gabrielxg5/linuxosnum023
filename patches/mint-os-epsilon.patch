+/* ======================================================= System Monitor */
+
+namespace SysMonitor {
+
+constexpr int k_width = 282;
+constexpr int k_height = 162;
+constexpr int k_rowHeight = 15;
+
+struct Process {
+  const char* name;
+  int pid;
+  int memoryKB;
+};
+
+constexpr Process k_system[] = {
+    {"systemd", 1, 12},     {"Xorg", 712, 48},    {"cinnamon", 1024, 96},
+    {"nemo-desktop", 1101, 22}, {"epsilon", 1337, 64},
+};
+constexpr int k_numberOfSystem = sizeof(k_system) / sizeof(k_system[0]);
+
+int processCount() { return k_numberOfSystem + s.numberOfWindows; }
+
+void processInfo(int i, const char** name, int* pid, int* mem, int* cpu) {
+  if (i < k_numberOfSystem) {
+    *name = k_system[i].name;
+    *pid = k_system[i].pid;
+    *mem = k_system[i].memoryKB;
+    int last = s.sysmon.cpu[(s.sysmon.cpuHead + SysMonitorState::k_samples - 1) %
+                            SysMonitorState::k_samples];
+    *cpu = i == 2 ? last / 2 : (i == 4 ? last / 4 : (i == 1 ? last / 5 : 0));
+    return;
+  }
+  WindowApp app = s.windows[i - k_numberOfSystem].app;
+  constexpr const char* k_names[k_numberOfWindowApps] = {
+      "gnome-terminal", "nemo",          "gnome-system-mo", "mintupdate",
+      "mintinstall",    "cinnamon-sett", "mintwelcome",     "gnome-nibbles",
+      "gnome-2048",     "gnome-mines"};
+  *name = k_names[static_cast<int>(app)];
+  *pid = 2000 + static_cast<int>(app) * 37;
+  *mem = 8 + static_cast<int>(app) * 3;
+  *cpu = Apps::animating(app) ? 30 : 1;
+}
+
+Rect rowRect(Rect c, int i) {
+  return {c.x + 4, c.y + 42 + i * k_rowHeight, c.w - 8, k_rowHeight};
+}
+
+int visibleRows(Rect c) { return (c.h - 42 - 26) / k_rowHeight; }
+
+Rect killRect(Rect c) { return {c.right() - 132, c.bottom() - 22, 126, 18}; }
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  SysMonitorState& m = s.sysmon;
+  fill(b, c, p.windowBack);
+  constexpr const char* k_tabs[3] = {"Processus", "Ressources", "Fichiers"};
+  segments(b, c, k_tabs, 3, 84, m.tab);
+  char line[48];
+  if (m.tab == 0) {
+    Rect list = {c.x + 2, c.y + 26, c.w - 4, c.h - 52};
+    fill(b, list, p.view);
+    text(b, "Nom", c.x + 8, c.y + 27, p.winTextDim);
+    text(b, "% CPU", c.right() - 110, c.y + 27, p.winTextDim);
+    text(b, "Mém.", c.right() - 60, c.y + 27, p.winTextDim);
+    int rows = visibleRows(c);
+    int n = processCount();
+    for (int i = 0; i < rows; i++) {
+      int index = m.scroll + i;
+      if (index >= n) {
+        break;
+      }
+      Rect r = rowRect(c, i);
+      const char* name;
+      int pid, mem, cpu;
+      processInfo(index, &name, &pid, &mem, &cpu);
+      bool sel = index == m.selected;
+      if (sel) {
+        fill(b, r, p.accent, focused ? 255 : 170);
+      }
+      KDColor ink = sel ? KDWhite : p.winText;
+      if (index >= k_numberOfSystem) {
+        tile(b, Apps::icon(s.windows[index - k_numberOfSystem].app), 14, r.x + 2,
+             r.y);
+      } else {
+        mask(b, MintIcons::k_maskGear, r.x + 2, r.y, sel ? KDWhite : p.winTextDim);
+      }
+      text(b, name, r.x + 20, r.y, ink, Small, Align::Left, r.w - 140);
+      fmt(line, sizeof(line), "%d", cpu);
+      text(b, line, r.right() - 90, r.y, ink, Small, Align::Right);
+      fmt(line, sizeof(line), "%d Kio", mem);
+      text(b, line, r.right() - 4, r.y, ink, Small, Align::Right);
+    }
+    if (m.confirmKill) {
+      Rect bar = {c.x + 2, c.bottom() - 24, c.w - 140, 22};
+      text(b, "Vraiment ?", bar.x + 4, bar.y + 4, KDColor::RGB24(0xE04C4C));
+    }
+    button(b, killRect(c), m.confirmKill ? "Oui, terminer" : "Terminer processus",
+           m.confirmKill, m.selected >= 0);
+  } else if (m.tab == 1) {
+    // CPU history
+    int last = m.cpu[(m.cpuHead + SysMonitorState::k_samples - 1) %
+                     SysMonitorState::k_samples];
+    fmt(line, sizeof(line), "Historique CPU   CPU1 %d %%", last);
+    text(b, line, c.x + 8, c.y + 26, p.winText);
+    Rect g = {c.x + 8, c.y + 42, c.w - 16, 56};
+    fill(b, g, p.view);
+    for (int k = 1; k < 4; k++) {
+      fill(b, {g.x, g.y + k * g.h / 4, g.w, 1}, p.border, 60);
+    }
+    for (int k = 1; k < 6; k++) {
+      fill(b, {g.x + k * g.w / 6, g.y, 1, g.h}, p.border, 60);
+    }
+    int prevY = -1;
+    for (int k = 0; k < SysMonitorState::k_samples; k++) {
+      int v = m.cpu[(m.cpuHead + k) % SysMonitorState::k_samples];
+      int x = g.x + k * (g.w - 1) / (SysMonitorState::k_samples - 1);
+      int y = g.bottom() - 1 - v * (g.h - 2) / 100;
+      int nextX = g.x + (k + 1) * (g.w - 1) / (SysMonitorState::k_samples - 1);
+      fill(b, {x, y, nextX - x + 1, g.bottom() - y}, p.accent, 50);
+      if (prevY >= 0) {
+        int y0 = prevY < y ? prevY : y, y1 = prevY < y ? y : prevY;
+        fill(b, {x, y0, 2, y1 - y0 + 2}, p.accent);
+      }
+      fill(b, {x, y, nextX - x + 1, 2}, p.accent);
+      prevY = y;
+    }
+    // Memory and battery
+    int memUsed = 182 + s.numberOfWindows * 6;
+    fmt(line, sizeof(line), "Mémoire  %d Kio sur 256 Kio", memUsed);
+    text(b, line, c.x + 8, c.y + 102, p.winText);
+    progressBar(b, {c.x + 8, c.y + 118, c.w - 16, 6}, memUsed * 1000 / 256,
+                KDColor::RGB24(0xC678DD));
+    fmt(line, sizeof(line), "Batterie %d %%   Réseau 0 o/s", batteryPercent());
+    text(b, line, c.x + 8, c.y + 128, p.winText);
+    fmt(line, sizeof(line), "Affichage : %d ms par image", s.lastRedrawMs);
+    text(b, line, c.x + 8, c.y + 144, p.winTextDim);
+  } else {
+    Rect list = {c.x + 2, c.y + 26, c.w - 4, c.h - 28};
+    fill(b, list, p.view);
+    text(b, "Périphérique  Dossier  Type", c.x + 8, c.y + 28, p.winTextDim);
+    text(b, "/dev/flash0   /        nwfs", c.x + 8, c.y + 46, p.winText);
+    FileSystem* fsys = FileSystem::sharedFileSystem;
+    size_t total = FileSystem::k_totalSize;
+    size_t used = total - fsys->availableSize();
+    char u[12], t[12], a[12];
+    Storage::sizeText(u, sizeof(u), used);
+    Storage::sizeText(t, sizeof(t), total);
+    Storage::sizeText(a, sizeof(a), fsys->availableSize());
+    fmt(line, sizeof(line), "Total %s  Libre %s", t, a);
+    text(b, line, c.x + 8, c.y + 64, p.winText);
+    fmt(line, sizeof(line), "Utilisé %s", u);
+    text(b, line, c.x + 8, c.y + 82, p.winText);
+    progressBar(b, {c.x + 8, c.y + 100, c.w - 16, 8},
+                static_cast<int>(used * 1000 / total), p.accent);
+    text(b, "/dev/ram0     /tmp     tmpfs", c.x + 8, c.y + 118, p.winText);
+    text(b, "(256 Kio, dont 0 pour toi)", c.x + 8, c.y + 136, p.winTextDim);
+  }
+}
+
+void kill(Rect c) {
+  SysMonitorState& m = s.sysmon;
+  m.confirmKill = false;
+  int i = m.selected;
+  if (i < 0 || i >= processCount()) {
+    return;
+  }
+  if (i >= k_numberOfSystem) {
+    closeWindow(i - k_numberOfSystem);
+    int me = windowIndexOf(WindowApp::SysMonitor);
+    if (me >= 0) {
+      invalidate(clientRect(me));
+    }
+    if (m.selected >= processCount()) {
+      m.selected = processCount() - 1;
+    }
+    return;
+  }
+  switch (i) {
+    case 0:  // systemd: PID 1, the kernel panics
+      setMode(Mode::Panic);
+      return;
+    case 1:  // Xorg: the session dies
+      while (s.numberOfWindows > 0) {
+        closeWindow(s.numberOfWindows - 1);
+      }
+      setMode(Mode::Login);
+      return;
+    case 2:
+      crashCinnamon();
+      return;
+    case 3:
+      notify("nemo-desktop", "Le bureau a redémarré tout seul.",
+             MintIcons::TileFiles);
+      invalidateAll();
+      return;
+    default:
+      notify("epsilon", "Refusé : c'est lui qui fait tourner tout ça.",
+             MintIcons::TileCalculation);
+      invalidate(c);
+      return;
+  }
+}
+
+void click(int x, int y, bool right, Rect c) {
+  SysMonitorState& m = s.sysmon;
+  int ax = c.x + x, ay = c.y + y;
+  for (int i = 0; i < 3; i++) {
+    if (segmentRect(c, 3, i, 84).contains(ax, ay)) {
+      m.tab = i;
+      m.confirmKill = false;
+      invalidate(c);
+      return;
+    }
+  }
+  if (m.tab != 0) {
+    return;
+  }
+  if (killRect(c).contains(ax, ay)) {
+    if (m.confirmKill) {
+      kill(c);
+    } else if (m.selected >= 0) {
+      m.confirmKill = true;
+      invalidate(c);
+    }
+    return;
+  }
+  m.confirmKill = false;
+  int rows = visibleRows(c);
+  for (int i = 0; i < rows; i++) {
+    if (rowRect(c, i).contains(ax, ay) && m.scroll + i < processCount()) {
+      m.selected = m.scroll + i;
+      invalidate(c);
+      return;
+    }
+  }
+  invalidate(c);
+}
+
+bool handleKey(Event e, Rect c) {
+  SysMonitorState& m = s.sysmon;
+  if (e == Events::Left || e == Events::Right) {
+    m.tab = (m.tab + (e == Events::Left ? 2 : 1)) % 3;
+    m.confirmKill = false;
+    invalidate(c);
+    return true;
+  }
+  if (m.tab == 0 && (e == Events::Up || e == Events::Down)) {
+    int next = m.selected + (e == Events::Up ? -1 : 1);
+    if (next >= 0 && next < processCount()) {
+      m.selected = next;
+    }
+    int rows = visibleRows(c);
+    if (m.selected < m.scroll) {
+      m.scroll = m.selected;
+    }
+    if (m.selected >= m.scroll + rows) {
+      m.scroll = m.selected - rows + 1;
+    }
+    m.confirmKill = false;
+    invalidate(c);
+    return true;
+  }
+  if (m.tab == 0 && (e == Events::OK || e == Events::EXE ||
+                     e == Events::Backspace)) {
+    if (m.confirmKill) {
+      kill(c);
+    } else {
+      m.confirmKill = true;
+      invalidate(c);
+    }
+    return true;
+  }
+  return false;
+}
+
+bool tick(Rect c) {
+  if (s.ticks % 2 == 0) {
+    invalidate({c.x, c.y + 24, c.w, c.h - 24});
+    return true;
+  }
+  return false;
+}
