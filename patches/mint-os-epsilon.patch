+void dateText(char* buffer, int size, bool longForm) {
+  int32_t day = today();
+  int y, m, d;
+  civilFromDays(day, &y, &m, &d);
+  int weekday = ((day % 7) + 7) % 7;
+  if (longForm) {
+    fmt(buffer, size, "%s %d %s %d", k_dayNames[weekday], d, k_monthNames[m - 1],
+        y);
