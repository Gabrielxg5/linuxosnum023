+void notifyCalculation() {
+  uint8_t count = Calc::count();
+  if (count == s.calculationsSeen) {
+    return;
+  }
+  s.calculationsSeen = count;
+  const char* input;
+  const char* output;
+  if (!Calc::at(0, &input, &output)) {
+    return;
+  }
+  char body[64];
+  if (strcmp(output, "42") == 0) {
+    fmt(body, sizeof(body), "42 : la réponse. Fermez internet.");
+  } else if (strcmp(output, "666") == 0) {
+    fmt(body, sizeof(body), "Processus démoniaque (PID 666). sudo exorciste ?");
+  } else if (strcmp(output, "1337") == 0) {
+    fmt(body, sizeof(body), "1337 : t'es un vrai h4ck3r.");
+  } else if (strcmp(input, "1+1") == 0) {
+    fmt(body, sizeof(body), "1+1 ? Essaie : sudo apt install cerveau");
+  } else if (findText(output, "undef") || findText(output, "nonreal") ||
+             findText(output, "rror")) {
+    fmt(body, sizeof(body), "Erreur de segmentation (core dumped)");
+  } else if (strncmp(output, "3.141592", 8) == 0) {
+    fmt(body, sizeof(body), "π détecté. Mmm... de la tarte.");
+  } else {
+    fmt(body, sizeof(body), "%s = %s", input, output);
+  }
+  notify("Calculs", body, MintIcons::TileCalculation);
+}
