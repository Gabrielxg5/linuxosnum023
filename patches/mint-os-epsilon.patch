+void slider(Band& b, Rect r, int permille) {
+  const Palette& p = palette();
+  int y = r.y + r.h / 2;
+  int knob = r.x + r.w * permille / 1000;
+  roundFill(b, {r.x, y - 2, r.w, 4}, 2, p.button);
+  roundFill(b, {r.x, y - 2, knob - r.x, 4}, 2, p.accent);
+  roundFill(b, {knob - 6, y - 6, 12, 12}, 6, s.light ? KDWhite : p.winText);
+  roundFrame(b, {knob - 6, y - 6, 12, 12}, 6, p.border);
+}
