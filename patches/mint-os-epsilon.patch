+/* ---------------------------------------------------------------- bc */
+
+struct Parser {
+  const char* p;
+  bool error;
+};
+
+double expr(Parser& ps);
+
+void skip(Parser& ps) {
+  while (*ps.p == ' ') {
+    ps.p++;
+  }
+}
+
+double primary(Parser& ps) {
+  skip(ps);
+  if (*ps.p == '(') {
+    ps.p++;
+    double v = expr(ps);
+    skip(ps);
+    if (*ps.p == ')') {
+      ps.p++;
+    } else {
+      ps.error = true;
+    }
+    return v;
+  }
+  if (*ps.p == '-') {
+    ps.p++;
+    return -primary(ps);
+  }
+  if (strncmp(ps.p, "pi", 2) == 0 || strncmp(ps.p, "π", 2) == 0) {
+    ps.p += 2;
+    return M_PI;
+  }
+  constexpr const char* k_functions[] = {"sqrt", "sin", "cos", "tan", "ln",
+                                         "log", "exp", "abs", "√"};
+  for (int i = 0; i < 9; i++) {
+    size_t n = strlen(k_functions[i]);
+    if (strncmp(ps.p, k_functions[i], n) == 0) {
+      ps.p += n;
+      double v = primary(ps);
+      switch (i) {
+        case 0:
+        case 8:
+          return sqrt(v);
+        case 1:
+          return sin(v);
+        case 2:
+          return cos(v);
+        case 3:
+          return tan(v);
+        case 4:
+          return log(v);
+        case 5:
+          return log10(v);
+        case 6:
+          return exp(v);
+        default:
+          return fabs(v);
+      }
+    }
+  }
+  if ((*ps.p >= '0' && *ps.p <= '9') || *ps.p == '.') {
+    double v = 0, scale = 0;
+    while ((*ps.p >= '0' && *ps.p <= '9') || *ps.p == '.') {
+      if (*ps.p == '.') {
+        scale = 1;
+      } else if (scale > 0) {
+        scale /= 10;
+        v += (*ps.p - '0') * scale;
+      } else {
+        v = v * 10 + (*ps.p - '0');
+      }
+      ps.p++;
+    }
+    return v;
+  }
+  ps.error = true;
+  return 0;
+}
+
+double power(Parser& ps) {
+  double v = primary(ps);
+  skip(ps);
+  if (*ps.p == '^') {
+    ps.p++;
+    return pow(v, power(ps));
+  }
+  return v;
+}
+
+double term(Parser& ps) {
+  double v = power(ps);
+  while (true) {
+    skip(ps);
+    char op = *ps.p;
+    if (op != '*' && op != '/' && op != '%') {
+      return v;
+    }
+    ps.p++;
+    double r = power(ps);
+    v = op == '*' ? v * r : (op == '/' ? v / r : fmod(v, r));
+  }
+}
+
+double expr(Parser& ps) {
+  double v = term(ps);
+  while (true) {
+    skip(ps);
+    char op = *ps.p;
+    if (op != '+' && op != '-') {
+      return v;
+    }
+    ps.p++;
+    double r = term(ps);
+    v = op == '+' ? v + r : v - r;
+  }
+}
+
+void formatNumber(char* buffer, int size, double v) {
+  if (v != v) {
+    strlcpy(buffer, "Erreur d'exécution : division par zéro", size);
+    return;
+  }
+  if (v > 1e300 || v < -1e300) {
+    strlcpy(buffer, "infini (bc n'aime pas)", size);
+    return;
+  }
+  bool negative = v < 0;
+  if (negative) {
+    v = -v;
+  }
+  long long whole = static_cast<long long>(v);
+  double frac = v - static_cast<double>(whole);
+  int digits = static_cast<int>(frac * 1000000 + 0.5);
+  if (digits >= 1000000) {
+    whole++;
+    digits = 0;
+  }
+  char w[24];
+  int k = 0;
+  long long x = whole;
+  do {
+    w[k++] = '0' + x % 10;
+    x /= 10;
+  } while (x > 0 && k < 20);
+  int n = 0;
+  if (negative) {
+    buffer[n++] = '-';
+  }
+  while (k > 0 && n < size - 9) {
+    buffer[n++] = w[--k];
+  }
+  if (digits > 0) {
+    buffer[n++] = '.';
+    char f[7];
+    for (int i = 5; i >= 0; i--) {
+      f[i] = '0' + digits % 10;
+      digits /= 10;
+    }
+    int last = 5;
+    while (last > 0 && f[last] == '0') {
+      last--;
+    }
+    for (int i = 0; i <= last; i++) {
+      buffer[n++] = f[i];
+    }
+  }
+  buffer[n] = 0;
+}
+
+void evaluate(const char* text) {
+  Parser ps = {text, false};
+  double v = expr(ps);
+  skip(ps);
+  if (ps.error || *ps.p != 0) {
+    print("(standard_in) 1: erreur de syntaxe", St::Red);
+    return;
+  }
+  char line[48];
+  formatNumber(line, sizeof(line), v);
+  print(line);
+}
