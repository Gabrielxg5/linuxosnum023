+void startAnim(uint8_t anim, const char* arg = "") {
+  TerminalState& st = t();
+  st.mode = Mode::Anim;
+  st.anim = anim;
+  st.animStart = now();
+  st.step = 0;
+  st.vimTries = 0;  // lines printed by a job
+  strlcpy(st.arg, arg, sizeof(st.arg));
+  if (anim == AnimMatrix) {
+    for (int i = 0; i < k_cols; i++) {
+      st.rain[i] = -static_cast<int8_t>(rnd(14));
+      st.rainSpeed[i] = 1 + rnd(3);
+    }
+  }
+  if (anim >= JobAptUpdate) {
+    st.mode = Mode::Job;
+  }
+}
+
+void stopAnim() {
+  TerminalState& st = t();
+  st.mode = Mode::Shell;
+  st.anim = AnimNone;
+  st.root = false;
+}
