+/* The Mint-OS window apps: Files (Nemo), System Monitor, Update Manager,
+ * Software Manager, System Settings, the Welcome Screen and three games.
+ * The terminal lives in terminal.cpp. Each app draws itself in its window's
+ * client area and gets the keys when its window has the keyboard. */
+
+#include <apps/apps_container.h>
+#include <ion.h>
+#include <ion/storage/file_system.h>
