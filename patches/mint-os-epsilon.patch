+
+bool typePassword(Event e) {
+  if (e == Events::Backspace) {
+    if (s.passwordLength > 0) {
+      s.passwordLength--;
+      invalidateAll();
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (s.mode == Mode::Lock) {
+      setMode(Mode::Desktop);
+    } else {
+      login();
+    }
+    return true;
+  }
+  const char* t = e.text();
+  if (t != nullptr && t[0] != 0 && s.passwordLength < 16) {
+    s.passwordLength++;
+    invalidateAll();
+  }
+  return true;
+}
+
+void bootSelected() {
+  switch (s.grubSelection) {
+    case 0:
+    case 1:
+      s.bootLog = s.grubSelection == 1;
+      setMode(Mode::Splash);
+      return;
+    case 2:
+      s.grubMessage =
+          "error: no such device: Windows.\n"
+          "error: you need to load the kernel first.\n\n"
+          "Windows n'est pas sur cette calculatrice.\n"
+          "Bien essayé.";
+      setMode(Mode::GrubMessage);
+      return;
+    case 3:
+      setMode(Mode::Memtest);
+      return;
+    default:
+      s.grubMessage =
+          "System setup: entering firmware...\n\n"
+          "Il n'y a pas de BIOS : c'est une\n"
+          "calculatrice. Retour au menu GRUB.";
+      setMode(Mode::GrubMessage);
+      return;
+  }
+}
+
+void altTab() {
+  int n = 0;
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    n += s.windows[i].workspace == s.workspace ? 1 : 0;
+  }
+  if (n == 0) {
+    return;
+  }
+  if (s.menu != Menu::AltTab) {
+    closeMenu();
+    releaseKeyboard();
+    s.menu = Menu::AltTab;
+    s.altTabIndex = n > 1 ? 1 : 0;
+  } else {
+    s.altTabIndex = (s.altTabIndex + 1) % n;
+  }
+  s.altTabUntil = now() + 1100;
+  invalidate(altTabRect().inset(-6));
+}
+
+void finishAltTab() {
+  int k = 0;
+  for (int i = s.numberOfWindows - 1; i >= 0; i--) {
+    if (s.windows[i].workspace != s.workspace) {
+      continue;
+    }
+    if (k++ == s.altTabIndex) {
+      closeMenu();
+      focusWindow(i);
+      return;
+    }
+  }
+  closeMenu();
+}
