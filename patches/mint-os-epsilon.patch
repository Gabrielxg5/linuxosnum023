+  JobReboot,
+};
+
+TerminalState& t() { return s.terminal; }
+
+uint32_t rnd(uint32_t n) { return n == 0 ? 0 : Ion::random() % n; }
+
+/* ------------------------------------------------------------ directories */
+
+struct Dir {
+  const char* path;  // as shown in the prompt
+  int8_t parent;
+};
+
+constexpr Dir k_dirs[] = {
+    {"~", 13},         {"~/Documents", 0}, {"~/Scripts", 0}, {"/", 3},
+    {"/etc", 3},       {"~/Bureau", 0},    {"~/Images", 0},  {"~/Musique", 0},
+    {"~/Téléchargements", 0}, {"~/Vidéos", 0}, {"/bin", 3},  {"/tmp", 3},
+    {"/proc", 3},      {"/home", 3},
+};
+constexpr int k_numberOfDirs = sizeof(k_dirs) / sizeof(k_dirs[0]);
+constexpr int k_home = 0, k_documents = 1, k_scripts = 2, k_root = 3,
+              k_etc = 4, k_bin = 10, k_proc = 12, k_homes = 13;
+
+// Sub-directories of a directory
+int children(int dir, int* out) {
+  int n = 0;
+  for (int i = 0; i < k_numberOfDirs; i++) {
+    if (k_dirs[i].parent == dir && i != dir) {
+      out[n++] = i;
+    }
+  }
+  return n;
+}
+
+const char* dirName(int dir) {
+  if (dir == k_home) {
+    return "numworks";
+  }
+  const char* p = k_dirs[dir].path;
+  const char* slash = findLast(p, '/');
+  return slash && slash[1] ? slash + 1 : p;
+}
