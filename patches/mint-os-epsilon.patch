+/* ================================================================ 2048 */
+
+namespace G2048 {
+
+constexpr int k_cell = 33;
+constexpr int k_gap = 4;
+constexpr int k_board = 4 * k_cell + 5 * k_gap;  // 152
+constexpr int k_width = 276;
+constexpr int k_height = 160;
+
+void addTile(Game2048State& g) {
+  int empty[16];
+  int n = 0;
+  for (int i = 0; i < 16; i++) {
+    if (g.cells[i] == 0) {
+      empty[n++] = i;
+    }
+  }
+  if (n > 0) {
+    g.cells[empty[random(n)]] = random(10) == 0 ? 4 : 2;
+  }
+}
+
+void reset(Game2048State& g) {
+  memset(g.cells, 0, sizeof(g.cells));
+  g.score = 0;
+  g.over = false;
+  g.won = false;
+  addTile(g);
+  addTile(g);
+}
+
+bool canMove(const Game2048State& g) {
+  for (int i = 0; i < 16; i++) {
+    if (g.cells[i] == 0) {
+      return true;
+    }
+    if (i % 4 < 3 && g.cells[i] == g.cells[i + 1]) {
+      return true;
+    }
+    if (i < 12 && g.cells[i] == g.cells[i + 4]) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// direction: 0 left, 1 right, 2 up, 3 down
+bool move(Game2048State& g, int direction) {
+  bool moved = false;
+  for (int line = 0; line < 4; line++) {
+    int idx[4];
+    for (int k = 0; k < 4; k++) {
+      switch (direction) {
+        case 0:
+          idx[k] = line * 4 + k;
+          break;
+        case 1:
+          idx[k] = line * 4 + 3 - k;
+          break;
+        case 2:
+          idx[k] = k * 4 + line;
+          break;
+        default:
+          idx[k] = (3 - k) * 4 + line;
+          break;
+      }
+    }
+    uint16_t values[4] = {0, 0, 0, 0};
+    int n = 0;
+    for (int k = 0; k < 4; k++) {
+      if (g.cells[idx[k]]) {
+        values[n++] = g.cells[idx[k]];
+      }
+    }
+    uint16_t merged[4] = {0, 0, 0, 0};
+    int m = 0;
+    for (int k = 0; k < n; k++) {
+      if (k + 1 < n && values[k] == values[k + 1]) {
+        merged[m] = values[k] * 2;
+        g.score += merged[m];
+        if (merged[m] == 2048) {
+          g.won = true;
+        }
+        m++;
+        k++;
+      } else {
+        merged[m++] = values[k];
+      }
+    }
+    for (int k = 0; k < 4; k++) {
+      if (g.cells[idx[k]] != merged[k]) {
+        moved = true;
+        g.cells[idx[k]] = merged[k];
+      }
+    }
+  }
+  if (moved) {
+    addTile(g);
+    if (g.score > g.best) {
+      g.best = g.score;
+    }
+    g.over = !canMove(g);
+  }
+  return moved;
+}
+
+KDColor tileColor(int v) {
+  switch (v) {
+    case 2:
+      return KDColor::RGB24(0xEEE4DA);
+    case 4:
+      return KDColor::RGB24(0xEDE0C8);
+    case 8:
+      return KDColor::RGB24(0xF2B179);
+    case 16:
+      return KDColor::RGB24(0xF59563);
+    case 32:
+      return KDColor::RGB24(0xF67C5F);
+    case 64:
+      return KDColor::RGB24(0xF65E3B);
+    case 128:
+      return KDColor::RGB24(0xEDCF72);
+    case 256:
+      return KDColor::RGB24(0xEDCC61);
+    case 512:
+      return KDColor::RGB24(0xEDC850);
+    case 1024:
+      return KDColor::RGB24(0xEDC53F);
+    default:
+      return KDColor::RGB24(0xEDC22E);
+  }
+}
+
+Rect boardRect(Rect c) {
+  return {c.right() - k_board - 6, c.y + 4, k_board, k_board};
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  (void)p;
+  Game2048State& g = s.g2048;
+  fill(b, c, p.windowBack);
+  char buffer[24];
+  text(b, "2048", c.x + 12, c.y + 10, KDColor::RGB24(0xF59E3B),
+       KDFont::Size::Large);
+  fmt(buffer, sizeof(buffer), "Score %lu",
+           static_cast<unsigned long>(g.score));
+  text(b, buffer, c.x + 12, c.y + 40, p.text);
+  fmt(buffer, sizeof(buffer), "Record %lu",
+           static_cast<unsigned long>(g.best));
+  text(b, buffer, c.x + 12, c.y + 58, p.textDim);
+  if (g.over) {
+    text(b, "Perdu !", c.x + 12, c.y + 82, KDColor::RGB24(0xF67C5F));
+  } else if (g.won) {
+    text(b, "Gagné !", c.x + 12, c.y + 82, KDColor::RGB24(0xEDC22E));
+  }
+  text(b, focused ? "Flèches : jouer" : "OK : jouer", c.x + 12, c.y + 112,
+       p.textDim);
+  text(b, "OK : rejouer", c.x + 12, c.y + 130, p.textDim);
+  Rect board = boardRect(c);
+  roundFill(b, board, 6, KDColor::RGB24(0x2E2E2E));
+  for (int i = 0; i < 16; i++) {
+    Rect cell = {board.x + k_gap + (i % 4) * (k_cell + k_gap),
+                 board.y + k_gap + (i / 4) * (k_cell + k_gap), k_cell, k_cell};
+    if (!cell.intersects(b.clip())) {
+      continue;
+    }
+    int v = g.cells[i];
+    if (v == 0) {
+      roundFill(b, cell, 4, KDColor::RGB24(0x444444));
+      continue;
+    }
+    roundFill(b, cell, 4, tileColor(v));
+    formatInt(buffer, sizeof(buffer), v);
+    KDColor ink = v <= 4 ? KDColor::RGB24(0x5B524A) : k_white;
+    KDFont::Size f = v < 1000 ? KDFont::Size::Large : Small;
+    text(b, buffer, cell.x + k_cell / 2, cell.y + (k_cell - glyphHeight(f)) / 2,
+         ink, f, Align::Center, k_cell);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  Game2048State& g = s.g2048;
+  int direction = e == Events::Left    ? 0
+                  : e == Events::Right ? 1
+                  : e == Events::Up    ? 2
+                  : e == Events::Down  ? 3
+                                       : -1;
+  if (direction >= 0) {
+    if (!g.over && move(g, direction)) {
+      invalidate(c);
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    reset(g);
+    invalidate(c);
+    return true;
+  }
+  return false;
+}
