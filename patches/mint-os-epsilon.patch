+void drawNotification(Band& b) {
+  if (s.notification.until == 0 || !k_notification.inset(-6).intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  Rect r = k_notification;
+  shadow(b, r, 4, 120);
+  roundFill(b, r, 4, p.menu, 250);
+  roundFrame(b, r, 4, p.menuBorder);
+  tile(b, s.notification.tile, 20, r.x + 6, r.y + 6);
+  text(b, s.notification.title, r.x + 32, r.y + 3, p.text, Small, Align::Left,
+       r.w - 36);
+  // Body on up to two lines
+  const char* body = s.notification.body;
+  int perLine = (r.w - 36) / glyphWidth();
+  int len = strlen(body);
+  char line[32];
+  if (len <= perLine) {
+    text(b, body, r.x + 32, r.y + 18, p.textDim, Small, Align::Left, r.w - 36);
+  } else {
+    int cut = perLine;
+    while (cut > 0 && body[cut] != ' ') {
+      cut--;
+    }
+    if (cut == 0) {
+      cut = perLine;
+    }
+    while (cut > 0 && (static_cast<uint8_t>(body[cut]) & 0xC0) == 0x80) {
+      cut--;
+    }
+    int n = cut < static_cast<int>(sizeof(line)) - 1 ? cut : sizeof(line) - 1;
+    memcpy(line, body, n);
+    line[n] = 0;
+    text(b, line, r.x + 32, r.y + 16, p.textDim, Small, Align::Left, r.w - 36);
+    const char* rest = body + cut + (body[cut] == ' ' ? 1 : 0);
+    text(b, rest, r.x + 32, r.y + 29, p.textDim, Small, Align::Left, r.w - 36);
+  }
+}
