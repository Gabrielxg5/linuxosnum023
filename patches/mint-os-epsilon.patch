+
+void buildItems() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int appIndex = 1; appIndex < builtin && s_numberOfBuiltin < k_maxBuiltin;
+       appIndex++) {
+    I18n::Message name = builtinDescriptor(appIndex)->name();
+    uint8_t t = MintIcons::TileCode;
+    const char* d = "Application NumWorks";
+    for (const BuiltinTile& bt : k_builtinTiles) {
+      if (bt.name == name) {
+        t = bt.tile;
+        d = bt.description;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = appIndex;
+    s_builtinTile[s_numberOfBuiltin] = t;
+    s_builtinName[s_numberOfBuiltin] = name;
+    s_builtinDescription[s_numberOfBuiltin] = d;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfExternalApps();
+}
