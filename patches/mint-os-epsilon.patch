+/* ------------------------------------------------------ input helpers */
+
+void pushHistory(const char* cmd) {
+  TerminalState& st = t();
+  if (cmd[0] == 0) {
+    return;
+  }
+  if (st.historyCount > 0 && strcmp(st.history[0], cmd) == 0) {
+    return;
+  }
+  for (int i = TerminalState::k_history - 1; i > 0; i--) {
+    memcpy(st.history[i], st.history[i - 1], sizeof(st.history[i]));
+  }
+  strlcpy(st.history[0], cmd, sizeof(st.history[0]));
+  if (st.historyCount < TerminalState::k_history) {
+    st.historyCount++;
+  }
+}
+
+// Toolbox key: completion of the command or of the file name
+void complete() {
+  TerminalState& st = t();
+  char* word = findLast(st.input, ' ');
+  bool first = word == nullptr;
+  word = first ? st.input : word + 1;
+  int len = strlen(word);
+  const char* match = nullptr;
+  int matches = 0;
+  if (first) {
+    for (const char* c : k_commands) {
+      if (strncmp(c, word, len) == 0) {
+        match = c;
+        matches++;
+      }
+    }
+  } else {
+    int n = Apps::Storage::count(0);
+    for (int i = 0; i < n; i++) {
+      const char* f = Apps::Storage::at(0, i).fullName();
+      if (f && strncmp(f, word, len) == 0) {
+        match = f;
+        matches++;
+      }
+    }
+    int kids[16];
+    int count = children(st.cwd, kids);
+    for (int i = 0; i < count; i++) {
+      if (strncmp(dirName(kids[i]), word, len) == 0) {
+        match = dirName(kids[i]);
+        matches++;
+      }
+    }
+  }
+  if (matches == 1) {
+    int room = TerminalState::k_inputSize - 1 - (word - st.input);
+    strlcpy(word, match, room);
+    if (strlen(st.input) < TerminalState::k_inputSize - 2) {
+      strlcat(st.input, first ? " " : "", sizeof(st.input));
+    }
+    st.inputLength = strlen(st.input);
+  }
+}
