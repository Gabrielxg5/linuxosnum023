+
+Hit hitTest(int x, int y) {
+  // Menus are on top
+  switch (s.menu) {
+    case Menu::Dialog:
+      if (k_dialog.contains(x, y)) {
+        for (int i = 0; i < dialogButtons(); i++) {
+          if (dialogButtonRect(i).contains(x, y)) {
+            return {HitType::DialogButton, static_cast<int8_t>(i), 0};
+          }
+        }
+        return {HitType::DialogPanel, 0, 0};
+      }
+      // A dialog is modal
+      return {HitType::DialogPanel, -1, 0};
+    case Menu::Context: {
+      Rect r = contextRect();
+      if (r.contains(x, y)) {
+        for (int i = 0; i < s.numberOfContextItems; i++) {
+          if (contextItemRect(i).contains(x, y)) {
+            return {HitType::ContextItem, static_cast<int8_t>(i), 0};
+          }
+        }
+        return {HitType::ContextPanel, 0, 0};
+      }
+      break;
+    }
+    case Menu::Main:
+      if (k_menuRect.contains(x, y)) {
+        for (int i = 0; i < k_numberOfFavorites; i++) {
+          if (favoriteRect(i).contains(x, y)) {
+            return {HitType::MenuFavorite, static_cast<int8_t>(i), 0};
+          }
+        }
+        for (int i = 0; i < k_numberOfSessionButtons; i++) {
+          if (sessionRect(i).contains(x, y)) {
+            return {HitType::MenuSession, static_cast<int8_t>(i), 0};
+          }
+        }
+        if (k_searchBox.contains(x, y)) {
+          return {HitType::MenuSearch, 0, 0};
+        }
+        if (s.searchLength == 0) {
+          for (int i = 0; i < k_numberOfCategories; i++) {
+            if (categoryRect(i).contains(x, y)) {
+              return {HitType::MenuCategory, static_cast<int8_t>(i), 0};
+            }
+          }
+        }
+        int count = menuItemCount();
+        if (count > k_visibleRows) {
+          if (k_scrollUp.contains(x, y)) {
+            return {HitType::MenuScrollUp, 0, 0};
+          }
+          if (k_scrollDown.contains(x, y)) {
+            return {HitType::MenuScrollDown, 0, 0};
+          }
+        }
+        for (int i = 0; i < k_visibleRows; i++) {
+          if (s.menuScroll + i < count && menuRowRect(i).contains(x, y)) {
+            return {HitType::MenuItem, static_cast<int8_t>(i), 0};
+          }
+        }
+        return {HitType::MenuPanel, 0, 0};
+      }
+      break;
+    case Menu::Calendar:
+    case Menu::Sound:
+    case Menu::Power:
+    case Menu::Network: {
+      Rect p = popupRect();
+      if (p.contains(x, y)) {
+        if (s.menu == Menu::Sound || s.menu == Menu::Power) {
+          Rect slider = {k_sliderX - 8, sliderY() - 8, k_sliderWidth + 16, 16};
+          if (slider.contains(x, y)) {
+            int v = (x - k_sliderX) * 1000 / k_sliderWidth;
+            v = v < 0 ? 0 : (v > 1000 ? 1000 : v);
+            return {HitType::PopupSlider, 0, static_cast<int16_t>(v)};
+          }
+        }
+        if (s.menu != Menu::Calendar && popupButtonRect().contains(x, y)) {
+          return {HitType::PopupButton, 0, 0};
+        }
+        return {HitType::Popup, 0, 0};
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  if (s.notification.until && k_notification.contains(x, y)) {
+    return {HitType::Notification, 0, 0};
+  }
+  // Panel
+  if (showsPanel() && k_panel.contains(x, y)) {
+    if (k_menuButton.contains(x, y)) {
+      return {HitType::MenuButton, 0, 0};
+    }
+    Item items[k_maxTaskItems];
+    int n = taskItems(items);
+    for (int i = 0; i < n; i++) {
+      if (taskItemRect(i).contains(x, y)) {
+        return {HitType::TaskItem, static_cast<int8_t>(i), 0};
+      }
+    }
+    for (int i = 0; i < 2; i++) {
+      if (workspaceRect(i).contains(x, y)) {
+        return {HitType::Workspace, static_cast<int8_t>(i), 0};
+      }
+    }
+    if (k_trayUpdates.contains(x, y)) {
+      return {HitType::TrayUpdates, 0, 0};
+    }
+    if (k_trayNetwork.contains(x, y)) {
+      return {HitType::TrayNetwork, 0, 0};
+    }
+    if (k_traySound.contains(x, y)) {
+      return {HitType::TraySound, 0, 0};
+    }
+    if (k_trayPower.contains(x, y)) {
+      return {HitType::TrayPower, 0, 0};
+    }
+    if (k_clock.contains(x, y)) {
+      return {HitType::Clock, 0, 0};
+    }
+    if (k_showDesktop.contains(x, y)) {
+      return {HitType::ShowDesktop, 0, 0};
+    }
+    return {HitType::Panel, 0, 0};
+  }
+  // Windows, from the top
+  for (int w = s.numberOfWindows - 1; w >= 0; w--) {
+    if (!windowVisible(w) || !windowRect(w).contains(x, y)) {
+      continue;
+    }
+    if (titleButtonRect(w, 0).contains(x, y)) {
+      return {HitType::WindowClose, static_cast<int8_t>(w), 0};
+    }
+    if (Apps::canMaximize(s.windows[w].app) &&
+        titleButtonRect(w, 1).contains(x, y)) {
+      return {HitType::WindowMaximize, static_cast<int8_t>(w), 0};
+    }
+    if (titleButtonRect(w, 2).contains(x, y)) {
+      return {HitType::WindowMinimize, static_cast<int8_t>(w), 0};
+    }
+    if (y < windowRect(w).y + k_titleHeight) {
+      return {HitType::WindowTitle, static_cast<int8_t>(w), 0};
+    }
+    return {HitType::WindowClient, static_cast<int8_t>(w), 0};
+  }
+  for (int i = 0; i < k_numberOfDesktopIcons; i++) {
+    if (desktopIconRect(i).contains(x, y)) {
+      return {HitType::DesktopIcon, static_cast<int8_t>(i), 0};
+    }
+  }
+  return {HitType::Desktop, 0, 0};
+}
+
+// Area to redraw when the hover state of this hit changes
+Rect hoverRect(Hit h) {
+  switch (h.type) {
+    case HitType::MenuButton:
+      return k_menuButton;
+    case HitType::TaskItem:
+      return taskItemRect(h.index);
+    case HitType::Workspace:
+      return k_workspaces;
+    case HitType::TrayUpdates:
+      return k_trayUpdates;
+    case HitType::TrayNetwork:
+      return k_trayNetwork;
+    case HitType::TraySound:
+      return k_traySound;
+    case HitType::TrayPower:
+      return k_trayPower;
+    case HitType::Clock:
+      return k_clock;
+    case HitType::ShowDesktop:
+      return k_showDesktop;
+    case HitType::DesktopIcon:
+      return desktopIconRect(h.index);
+    case HitType::MenuCategory:
+    case HitType::MenuItem:
+    case HitType::MenuFavorite:
+    case HitType::MenuSession:
+    case HitType::MenuScrollUp:
+    case HitType::MenuScrollDown:
+      return k_menuRect;
+    case HitType::PopupButton:
+      return popupButtonRect();
+    case HitType::ContextItem:
+      return contextItemRect(h.index);
+    case HitType::DialogButton:
+      return dialogButtonRect(h.index);
+    case HitType::WindowMinimize:
+      return titleButtonRect(h.index, 2);
+    case HitType::WindowMaximize:
+      return titleButtonRect(h.index, 1);
+    case HitType::WindowClose:
+      return titleButtonRect(h.index, 0);
+    default:
+      return {0, 0, 0, 0};
+  }
+}
+
+bool isHovered(HitType type, int index = 0) {
+  Hit h = hitTest(s.cursorX, s.cursorY);
+  return h.type == type && h.index == index;
+}
+
+/* -------------------------------------------------------------- settings */
+
+/* --------------------------------------------------------------- dates */
+
+/* There is no real-time clock: the date is the day this firmware was
+ * compiled, and the time starts at 00:00 (set it with `date -s 14:30`). */
+int32_t daysFromCivil(int y, int m, int d) {
+  y -= m <= 2;
+  int era = (y >= 0 ? y : y - 399) / 400;
+  int yoe = y - era * 400;
+  int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + doe - 719468;
+}
+
+void civilFromDays(int32_t z, int* y, int* m, int* d) {
+  z += 719468;
+  int era = (z >= 0 ? z : z - 146096) / 146097;
+  int doe = z - era * 146097;
+  int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  int yy = yoe + era * 400;
+  int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  int mp = (5 * doy + 2) / 153;
+  *d = doy - (153 * mp + 2) / 5 + 1;
+  *m = mp + (mp < 10 ? 3 : -9);
+  *y = yy + (*m <= 2);
+}
+
+int32_t buildDay() {
+  const char* date = __DATE__;  // "Nov 20 2026"
+  constexpr const char* k_months = "JanFebMarAprMayJunJulAugSepOctNovDec";
+  int m = 1;
+  for (int i = 0; i < 12; i++) {
+    if (strncmp(date, k_months + 3 * i, 3) == 0) {
+      m = i + 1;
+    }
+  }
+  int d = (date[4] == ' ' ? 0 : date[4] - '0') * 10 + (date[5] - '0');
+  int y = (date[7] - '0') * 1000 + (date[8] - '0') * 100 +
+          (date[9] - '0') * 10 + (date[10] - '0');
+  return daysFromCivil(y, m, d);
+}
+
+int totalMinutes() {
+  return static_cast<int>(uptimeSeconds() / 60) + s.clockOffsetMinutes;
+}
+
+int32_t today() {
+  int minutes = totalMinutes();
+  int days = minutes >= 0 ? minutes / 1440 : -((-minutes + 1439) / 1440);
+  return buildDay() + days;
+}
+
+constexpr const char* k_dayNames[7] = {"jeudi", "vendredi", "samedi",
+                                       "dimanche", "lundi", "mardi",
+                                       "mercredi"};  // day 0 = 1970-01-01
+constexpr const char* k_monthNames[12] = {
+    "janvier", "février", "mars",      "avril",   "mai",      "juin",
+    "juillet", "août",    "septembre", "octobre", "novembre", "décembre"};
+
+/* ------------------------------------------------------------------ menus */
+
+void closeMenu() {
+  if (s.menu == Menu::None) {
+    return;
+  }
+  switch (s.menu) {
+    case Menu::Main:
+      invalidate(k_menuRect.inset(-4));
+      invalidate(k_menuButton);
+      s.searchLength = 0;
+      s.search[0] = 0;
+      setAlphaLock(false);
+      break;
+    case Menu::Context:
+      invalidate(contextRect().inset(-4));
+      break;
+    case Menu::AltTab:
+      invalidate(altTabRect().inset(-4));
+      break;
+    case Menu::Dialog:
+      invalidate(k_dialog.inset(-6));
+      break;
+    default:
+      invalidate(popupRect().inset(-4));
+      invalidate(k_panel);
+      break;
+  }
+  s.menu = Menu::None;
+}
+
+void releaseKeyboard() {
+  if (s.keyboardFocus) {
+    s.keyboardFocus = false;
+    setAlphaLock(false);
+    if (s.numberOfWindows > 0) {
+      invalidate(windowRect(s.numberOfWindows - 1));
+    }
+  }
+}
+
+void openMainMenu() {
+  closeMenu();
+  releaseKeyboard();
+  s.menu = Menu::Main;
+  s.category = 0;
+  s.menuScroll = 0;
+  s.searchLength = 0;
+  s.search[0] = 0;
+  // Like Cinnamon, typing goes straight to the search box
+  setAlphaLock(true);
+  invalidate(k_menuRect.inset(-4));
+  invalidate(k_menuButton);
+}
+
+void openPopup(Menu m) {
+  closeMenu();
+  s.menu = m;
+  invalidate(popupRect().inset(-4));
+  invalidate(k_panel);
+}
+
+void openContext(Item target, int windowIndex, const ContextAction* actions,
+                 int n) {
+  closeMenu();
+  s.menu = Menu::Context;
+  s.contextX = s.cursorX;
+  s.contextY = s.cursorY;
+  s.contextTarget = target;
+  s.contextWindow = windowIndex;
+  s.numberOfContextItems = n > k_maxContextItems ? k_maxContextItems : n;
+  for (int i = 0; i < s.numberOfContextItems; i++) {
+    s.contextActions[i] = actions[i];
+  }
+  invalidate(contextRect().inset(-4));
+}
+
+void minimizeWindow(int w) {
+  if (w < 0 || w >= s.numberOfWindows) {
+    return;
+  }
+  invalidate(windowRect(w).inset(-6));
+  s.windows[w].minimized = true;
+  if (w == s.numberOfWindows - 1) {
+    releaseKeyboard();
+  }
+  invalidate(k_panel);
+}
+
+void toggleMaximize(int w) {
+  if (w < 0 || w >= s.numberOfWindows ||
+      !Apps::canMaximize(s.windows[w].app)) {
+    return;
+  }
+  invalidate(windowRect(w).inset(-6));
+  s.windows[w].maximized = !s.windows[w].maximized;
+  invalidate(windowRect(w).inset(-6));
+}
+
+void switchWorkspace(int ws) {
+  if (ws == s.workspace) {
+    return;
+  }
+  releaseKeyboard();
+  s.workspace = ws;
+  // The window on top of the new workspace comes first
+  for (int i = s.numberOfWindows - 1; i >= 0; i--) {
+    if (s.windows[i].workspace == ws && !s.windows[i].minimized) {
+      Window w = s.windows[i];
+      for (int j = i; j + 1 < s.numberOfWindows; j++) {
+        s.windows[j] = s.windows[j + 1];
+      }
+      s.windows[s.numberOfWindows - 1] = w;
+      break;
+    }
+  }
+  invalidateAll();
+  char body[40];
+  fmt(body, sizeof(body), "Espace de travail %d", ws + 1);
+  notify("Cinnamon", body, MintIcons::TileWelcome);
+}
+
+void quitSession() {
+  // Log out: windows close, back to the login screen
+  closeMenu();
+  while (s.numberOfWindows > 0) {
+    closeWindow(s.numberOfWindows - 1);
+  }
+  s.penguinsOn = false;
+  setMode(Mode::Login);
+}
+
+void dialogButton(int i) {
+  Dialog d = s.dialog;
+  closeMenu();
+  switch (d) {
+    case Dialog::Crash:
+      if (i == 1) {
+        // Restart Cinnamon
+        s.crashed = false;
+        invalidateAll();
+        notify("Cinnamon", "Cinnamon a redémarré.", MintIcons::TileWelcome);
+      }
+      return;
+    case Dialog::Power:
+      if (i == 0) {
+        sleepNow();
+      } else if (i == 1) {
+        reboot();
+      } else if (i == 2) {
+        // Shut down: the screen goes off, and the next start is a boot
+        while (s.numberOfWindows > 0) {
+          closeWindow(s.numberOfWindows - 1);
+        }
+        s.mode = Mode::Grub;
+        s.modeStart = now();
+        s.grubSelection = 0;
+        if (!s_fakeClock) {
+          Ion::Power::suspend(true);
+          AppsContainer::sharedAppsContainer()->didSuspend();
+        }
+        s.modeStart = now();
+        invalidateAll();
+      }
+      return;
+    case Dialog::Logout:
+      if (i == 1) {
+        quitSession();
+      }
+      return;
+  }
+}
+
+void contextAction(ContextAction action) {
+  Item target = s.contextTarget;
+  int w = s.contextWindow;
+  closeMenu();
+  switch (action) {
+    case ContextAction::Open:
+      openItem(target);
+      break;
+    case ContextAction::PinPanel:
+      pin(target);
+      invalidate(k_panel);
+      break;
+    case ContextAction::UnpinPanel:
+      unpin(target);
+      invalidate(k_panel);
+      break;
+    case ContextAction::Minimize:
+      minimizeWindow(w);
+      break;
+    case ContextAction::Maximize:
+      toggleMaximize(w);
+      break;
+    case ContextAction::OtherWorkspace:
+      if (w >= 0 && w < s.numberOfWindows) {
+        invalidate(windowRect(w).inset(-6));
+        s.windows[w].workspace = 1 - s.windows[w].workspace;
+        releaseKeyboard();
+        invalidate(k_panel);
+        char body[48];
+        fmt(body, sizeof(body), "%s : espace de travail %d",
+            Apps::title(s.windows[w].app), s.windows[w].workspace + 1);
+        notify("Cinnamon", body, MintIcons::TileWelcome);
+      }
+      break;
+    case ContextAction::Close:
+      if (w >= 0 && w < s.numberOfWindows) {
+        closeWindow(w);
+      }
+      break;
+    case ContextAction::NewScript: {
+      char name[16];
+      if (createScript(name, sizeof(name))) {
+        char body[48];
+        fmt(body, sizeof(body), "%s.py créé dans Scripts", name);
+        notify("Nouveau document", body, MintIcons::TilePythonFile);
+      } else {
+        notify("Nouveau document", "Mémoire pleine", MintIcons::TilePythonFile);
+      }
+      break;
+    }
+    case ContextAction::OpenTerminal:
+      openWindow(WindowApp::Terminal);
+      break;
+    case ContextAction::Wallpaper:
+      nextWallpaper();
+      break;
+    case ContextAction::DisplaySettings:
+      s.settings.section = 1;
+      openWindow(WindowApp::Settings);
+      break;
+    case ContextAction::SystemMonitor:
+      openWindow(WindowApp::SysMonitor);
+      break;
+    case ContextAction::FileOpen:
+    case ContextAction::FileDelete:
+      Apps::fileAction(action);
+      break;
+  }
+}
+
+void sessionButton(int i) {
+  closeMenu();
+  if (i == 0) {
+    setMode(Mode::Lock);
+  } else if (i == 1) {
+    openDialog(Dialog::Logout);
+  } else {
+    openDialog(Dialog::Power);
+  }
+}
+
+void openDesktopIcon(int i) {
+  if (i == 0) {
+    s.files.place = 4;
+  } else if (i == 1) {
+    s.files.place = 0;
+  } else {
+    s.files.place = 3;
+  }
+  s.files.selected = -1;
+  s.files.scroll = 0;
+  int w = windowIndexOf(WindowApp::Files);
+  if (w >= 0) {
+    invalidate(clientRect(w));
+  }
+  openWindow(WindowApp::Files);
+}
+
+void setVolume(int v) {
+  s.volume = v < 0 ? 0 : (v > 100 ? 100 : v);
+  s.muted = false;
+}
+
+/* ----------------------------------------------------------------- clicks */
+
+void click(bool right) {
+  Hit h = hitTest(s.cursorX, s.cursorY);
+  bool inMenu = false;
+  switch (h.type) {
+    case HitType::MenuPanel:
+    case HitType::MenuSearch:
+    case HitType::MenuCategory:
+    case HitType::MenuItem:
+    case HitType::MenuFavorite:
+    case HitType::MenuSession:
+    case HitType::MenuScrollUp:
+    case HitType::MenuScrollDown:
+    case HitType::Popup:
+    case HitType::PopupSlider:
+    case HitType::PopupButton:
+    case HitType::ContextPanel:
+    case HitType::ContextItem:
+    case HitType::DialogPanel:
+    case HitType::DialogButton:
+      inMenu = true;
+      break;
+    default:
+      break;
+  }
+  if (s.menu != Menu::None && !inMenu) {
+    bool toggles =
+        (s.menu == Menu::Main && h.type == HitType::MenuButton) ||
+        (s.menu == Menu::Calendar && h.type == HitType::Clock) ||
+        (s.menu == Menu::Sound && h.type == HitType::TraySound) ||
+        (s.menu == Menu::Power && h.type == HitType::TrayPower) ||
+        (s.menu == Menu::Network && h.type == HitType::TrayNetwork);
+    closeMenu();
+    if (toggles || right) {
+      return;
+    }
+  }
+  if (h.type != HitType::DesktopIcon && s.desktopSelected >= 0) {
+    invalidate(desktopIconRect(s.desktopSelected));
+    s.desktopSelected = -1;
+  }
+
+  Item items[k_maxTaskItems];
+  switch (h.type) {
+    case HitType::MenuButton:
+      if (!right) {
+        openMainMenu();
+      }
+      return;
+    case HitType::TaskItem: {
+      taskItems(items);
+      Item it = items[h.index];
+      int w = it.kind == Item::Kind::Window
+                  ? windowIndexOf(static_cast<WindowApp>(it.index))
+                  : -1;
+      if (right) {
+        ContextAction actions[3];
+        int n = 0;
+        actions[n++] = ContextAction::Open;
+        actions[n++] =
+            isPinned(it) ? ContextAction::UnpinPanel : ContextAction::PinPanel;
+        if (w >= 0) {
+          actions[n++] = ContextAction::Close;
+        }
+        openContext(it, w, actions, n);
+        return;
+      }
+      if (w >= 0 && w == s.numberOfWindows - 1 && windowVisible(w)) {
+        // Clicking the focused window's button minimizes it
+        minimizeWindow(w);
+      } else {
+        openItem(it);
+      }
+      return;
+    }
+    case HitType::Workspace:
+      if (!right) {
+        switchWorkspace(h.index);
+      }
+      return;
+    case HitType::TrayUpdates:
+      openWindow(WindowApp::Updates);
+      return;
+    case HitType::TrayNetwork:
+      openPopup(Menu::Network);
+      return;
+    case HitType::TraySound:
+      openPopup(Menu::Sound);
+      return;
+    case HitType::TrayPower:
+      openPopup(Menu::Power);
+      return;
+    case HitType::Clock:
+      openPopup(Menu::Calendar);
+      return;
+    case HitType::ShowDesktop: {
+      // Minimize everything of this workspace, or bring it all back
+      bool any = false;
+      for (int i = 0; i < s.numberOfWindows; i++) {
+        any = any || windowVisible(i);
+      }
+      for (int i = 0; i < s.numberOfWindows; i++) {
+        if (s.windows[i].workspace == s.workspace) {
+          s.windows[i].minimized = any;
+        }
+      }
+      releaseKeyboard();
+      invalidateAll();
+      return;
+    }
+    case HitType::MenuSearch:
+      return;
+    case HitType::MenuCategory:
+      if (s.category != h.index) {
+        s.category = h.index;
+        s.menuScroll = 0;
+        invalidate(k_menuRect);
+      }
+      return;
+    case HitType::MenuScrollUp:
+    case HitType::MenuScrollDown: {
+      int count = menuItemCount();
+      int scroll = s.menuScroll + (h.type == HitType::MenuScrollDown
+                                       ? k_visibleRows - 1
+                                       : -(k_visibleRows - 1));
+      int max = count - k_visibleRows;
+      s.menuScroll = scroll < 0 ? 0 : (scroll > max ? max : scroll);
+      invalidate(k_menuRect);
+      return;
+    }
+    case HitType::MenuItem: {
+      Item it = menuItemAt(s.menuScroll + h.index);
+      if (right) {
+        ContextAction actions[2] = {
+            ContextAction::Open,
+            isPinned(it) ? ContextAction::UnpinPanel : ContextAction::PinPanel};
+        openContext(it, -1, actions, 2);
+        return;
+      }
+      closeMenu();
+      openItem(it);
+      return;
+    }
+    case HitType::MenuFavorite:
+      closeMenu();
+      openItem(favoriteAt(h.index));
+      return;
+    case HitType::MenuSession:
+      sessionButton(h.index);
+      return;
+    case HitType::PopupSlider:
+      if (s.menu == Menu::Sound) {
+        setVolume(h.value / 10);
+      } else {
+        int level = h.value * Ion::Backlight::MaxBrightness / 1000;
+        setBrightness(level < 8 ? 8 : level);
+      }
+      invalidate(popupRect());
+      invalidate(k_panel);
+      return;
+    case HitType::PopupButton:
+      if (s.menu == Menu::Sound) {
+        s.muted = !s.muted;
+        invalidate(popupRect());
+        invalidate(k_panel);
+      } else if (s.menu == Menu::Power) {
+        closeMenu();
+        s.settings.section = 2;
+        openWindow(WindowApp::Settings);
+      } else {
+        closeMenu();
+        s.terminal.mode = TerminalState::Mode::Shell;
+        openWindow(WindowApp::Terminal);
+      }
+      return;
+    case HitType::ContextItem:
+      contextAction(s.contextActions[h.index]);
+      return;
+    case HitType::DialogButton:
+      dialogButton(h.index);
+      return;
+    case HitType::Notification:
+      s.notification.until = 0;
+      invalidate(k_notification.inset(-4));
+      return;
+    case HitType::WindowClose:
+      if (!right) {
+        closeWindow(h.index);
+      }
+      return;
+    case HitType::WindowMinimize:
+      if (!right) {
+        minimizeWindow(h.index);
+      }
+      return;
+    case HitType::WindowMaximize:
+      if (!right) {
+        focusWindow(h.index);
+        toggleMaximize(s.numberOfWindows - 1);
+      }
+      return;
+    case HitType::WindowTitle: {
+      focusWindow(h.index);
+      int top = s.numberOfWindows - 1;
+      if (right) {
+        ContextAction actions[4];
+        int n = 0;
+        actions[n++] = ContextAction::Minimize;
+        if (Apps::canMaximize(s.windows[top].app)) {
+          actions[n++] = ContextAction::Maximize;
+        }
+        actions[n++] = ContextAction::OtherWorkspace;
+        actions[n++] = ContextAction::Close;
+        openContext(windowItem(s.windows[top].app), top, actions, n);
+        return;
+      }
+      if (s.windows[top].maximized) {
+        return;
+      }
+      // Grab the window: it follows the pointer until the next click
+      s.dragging = true;
+      s.dragDX = s.cursorX - s.windows[top].x;
+      s.dragDY = s.cursorY - s.windows[top].y;
+      invalidate(windowRect(top).inset(-2));
+      return;
+    }
+    case HitType::WindowClient: {
+      bool wasTop = h.index == s.numberOfWindows - 1;
+      focusWindow(h.index);
+      int top = s.numberOfWindows - 1;
+      Window& w = s.windows[top];
+      Rect c = clientRect(top);
+      if (!wasTop && !right) {
+        // The first click only brings the window to the front
+        if (Apps::wantsKeyboardOnClick(w.app)) {
+          s.keyboardFocus = true;
+          if (w.app == WindowApp::Terminal) {
+            setAlphaLock(true);
+          }
+        }
+        return;
+      }
+      Apps::click(w.app, s.cursorX - c.x, s.cursorY - c.y, right, c);
+      top = s.numberOfWindows - 1;
+      if (top >= 0 && !right && Apps::wantsKeyboardOnClick(s.windows[top].app) &&
+          !s.keyboardFocus && s.menu == Menu::None) {
+        s.keyboardFocus = true;
+        if (s.windows[top].app == WindowApp::Terminal) {
+          setAlphaLock(true);
+        }
+        invalidate(windowRect(top));
+      }
+      return;
+    }
+    case HitType::DesktopIcon:
+      if (right) {
+        s.desktopSelected = h.index;
+        invalidate(desktopIconRect(h.index));
+        ContextAction actions[1] = {ContextAction::Open};
+        openContext({Item::Kind::None, h.index}, -2, actions, 1);
+        return;
+      }
+      if (s.desktopSelected == h.index) {
+        // Second click: like a double click
+        openDesktopIcon(h.index);
+      } else {
+        if (s.desktopSelected >= 0) {
+          invalidate(desktopIconRect(s.desktopSelected));
+        }
+        s.desktopSelected = h.index;
+        invalidate(desktopIconRect(h.index));
+      }
+      return;
+    case HitType::Desktop:
+      if (right) {
+        ContextAction actions[5] = {
+            ContextAction::NewScript, ContextAction::OpenTerminal,
+            ContextAction::SystemMonitor, ContextAction::Wallpaper,
+            ContextAction::DisplaySettings};
+        openContext(k_noItem, -1, actions, 5);
+      }
+      return;
+    default:
+      return;
+  }
+}
+
+/* ----------------------------------------------------------------- moves */
+
+void updateHover() {
+  Hit h = hitTest(s.cursorX, s.cursorY);
+  uint32_t key = h.key();
+  if (key == s.hoverKey) {
+    return;
+  }
+  // Cinnamon selects a category when the pointer goes over it
+  if (h.type == HitType::MenuCategory && s.menu == Menu::Main &&
+      s.category != h.index) {
+    s.category = h.index;
+    s.menuScroll = 0;
+  }
+  Hit old = {static_cast<HitType>(s.hoverKey >> 16),
+             static_cast<int8_t>((s.hoverKey >> 8) & 0xFF), 0};
+  invalidate(hoverRect(old));
+  invalidate(hoverRect(h));
+  s.hoverKey = key;
+}
+
+Rect pointerRect(int x, int y) {
+  return {x, y, MintIcons::k_cursorWidth, MintIcons::k_cursorHeight};
+}
+
+void clampWindowPosition(Window& w) {
+  int width = Apps::clientWidth(w.app) + 2;
+  if (w.x < 40 - width) {
+    w.x = 40 - width;
+  }
+  if (w.x > k_screenWidth - 40) {
+    w.x = k_screenWidth - 40;
+  }
+  if (w.y < 0) {
+    w.y = 0;
+  }
+  if (w.y > k_panelY - k_titleHeight) {
+    w.y = k_panelY - k_titleHeight;
+  }
+}
+
+void moveCursor(int dx, int dy) {
+  int step = 1 + s.cursorSpeed;
+  int repeat = Ion::Events::longPressCounter();
+  step += repeat > 12 ? 2 * step : (repeat > 4 ? step : 0);
+  int x = s.cursorX + dx * step;
+  int y = s.cursorY + dy * step;
+  x = x < 0 ? 0 : (x > k_screenWidth - 2 ? k_screenWidth - 2 : x);
+  y = y < 0 ? 0 : (y > k_screenHeight - 2 ? k_screenHeight - 2 : y);
+  if (x == s.cursorX && y == s.cursorY) {
+    return;
+  }
+  invalidate(pointerRect(s.cursorX, s.cursorY));
+  s.cursorX = x;
+  s.cursorY = y;
+  invalidate(pointerRect(x, y));
+  if (s.dragging && s.numberOfWindows > 0) {
+    Window& w = s.windows[s.numberOfWindows - 1];
+    Rect before = windowRect(s.numberOfWindows - 1).inset(-6);
+    w.x = x - s.dragDX;
+    w.y = y - s.dragDY;
+    clampWindowPosition(w);
+    invalidate(before);
+    invalidate(windowRect(s.numberOfWindows - 1).inset(-6));
+  }
+  updateHover();
+}
+
+/* -------------------------------------------------------------- penguins */
+
+int groundBelow(int x, int fromY, int toY) {
+  // Highest surface whose top is in [fromY, toY] under x (or -1)
+  int best = -1;
+  auto consider = [&](int top, int left, int right) {
+    if (x >= left && x < right && top >= fromY && top <= toY &&
+        (best < 0 || top < best)) {
+      best = top;
+    }
+  };
+  if (showsPanel()) {
+    consider(k_panelY, 0, k_screenWidth);
+  } else {
+    consider(k_screenHeight, 0, k_screenWidth);
+  }
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    if (windowVisible(i)) {
+      Rect r = windowRect(i);
+      if (r.y > 2) {
+        consider(r.y, r.x, r.right());
+      }
+    }
+  }
+  return best;
+}
+
+constexpr int k_penguinW = 2 * MintIcons::k_penguinWidth;
+constexpr int k_penguinH = 2 * MintIcons::k_penguinHeight;
+
+Rect penguinRect(const Penguin& p) { return {p.x, p.y, k_penguinW, k_penguinH}; }
+
+void stepPenguins() {
+  constexpr int w = k_penguinW;
+  constexpr int h = k_penguinH;
+  for (int i = 0; i < k_maxPenguins; i++) {
+    Penguin& p = s.penguins[i];
+    invalidate(penguinRect(p));
+    int feetX = p.x + w / 2;
+    if (p.falling) {
+      int vy = p.vy < 5 ? p.vy + 1 : 5;
+      int bottom = p.y + h;
+      int ground = groundBelow(feetX, bottom, bottom + vy);
+      if (ground >= 0) {
+        p.y = ground - h;
+        p.falling = false;
+        p.vy = 0;
+      } else {
+        p.y += vy;
+        p.vy = vy;
+        if (p.y > k_screenHeight) {
+          // Fell off the screen: drop again from the top
+          p.y = -h;
+          p.x = static_cast<int16_t>(Ion::random() % (k_screenWidth - w));
+        }
+      }
+      p.frame = 2;
+    } else {
+      p.x += p.left ? -1 : 1;
+      if (p.x < 0 || p.x > k_screenWidth - w) {
+        p.left = !p.left;
+        p.x = p.x < 0 ? 0 : k_screenWidth - w;
+      }
+      p.frame = (p.x / 4) % 2;
+      if (groundBelow(p.x + w / 2, p.y + h, p.y + h) < 0) {
+        p.falling = true;
+        p.vy = 0;
+      }
+      // Now and then, turn around
+      if (Ion::random() % 180 == 0) {
+        p.left = !p.left;
+      }
+    }
+    invalidate(penguinRect(p));
+  }
+}
+
+/* -------------------------------------------------------------- drawing */
+
+void drawDesktopIcons(Band& b) {
+  const Palette& p = palette();
+  constexpr uint8_t k_tiles[k_numberOfDesktopIcons] = {
+      MintIcons::TileComputer, MintIcons::TileHome, MintIcons::TileTrash};
+  constexpr const char* k_labels[k_numberOfDesktopIcons] = {
+      "Ordinateur", "Personnel", "Corbeille"};
+  for (int i = 0; i < k_numberOfDesktopIcons; i++) {
+    Rect r = desktopIconRect(i);
+    if (!r.intersects(b.area())) {
+      continue;
+    }
+    if (s.desktopSelected == i) {
+      roundFill(b, r.inset(2), 5, p.accent, 150);
+    } else if (isHovered(HitType::DesktopIcon, i)) {
+      roundFill(b, r.inset(2), 5, KDWhite, 40);
+    }
+    tile(b, k_tiles[i], 24, r.x + (r.w - 24) / 2, r.y + 5);
+    // Text with a shadow, readable on any wallpaper
+    text(b, k_labels[i], r.x + r.w / 2 + 1, r.y + 32, KDBlack, Small,
+         Align::Center, r.w);
+    text(b, k_labels[i], r.x + r.w / 2, r.y + 31, KDWhite, Small,
+         Align::Center, r.w);
+  }
+}
+
+void drawTitleButton(Band& b, Rect r, const MintIcons::Mask& m, bool hover,
+                     bool close, KDColor ink) {
+  const Palette& p = palette();
+  int cx = r.x + r.w / 2, cy = r.y + r.h / 2;
+  if (close) {
+    roundFill(b, {cx - 7, cy - 7, 14, 14}, 7,
+              hover ? rgb(0xE04C4C) : (s.light ? rgb(0xC9C9C9) : rgb(0x555555)));
+    mask(b, m, cx - 5, cy - 5, hover ? KDWhite : ink);
+  } else {
+    if (hover) {
+      roundFill(b, {cx - 7, cy - 7, 14, 14}, 7, p.hover);
+    }
+    mask(b, m, cx - 5, cy - 5, ink);
+  }
+}
+
+void drawWindow(Band& b, int i) {
+  const Palette& p = palette();
+  Rect r = windowRect(i);
+  if (!r.inset(-6).intersects(b.area())) {
+    return;
+  }
+  bool top = i == s.numberOfWindows - 1;
+  Window& w = s.windows[i];
+  int radius = w.maximized ? 0 : 5;
+  if (!w.maximized) {
+    shadow(b, r, 6, top ? 120 : 60);
+  }
+  roundFill(b, r, radius, p.windowBack);
+  if (b.setClip({r.x, r.y, r.w, k_titleHeight})) {
+    roundFill(b, {r.x, r.y, r.w, k_titleHeight + 8}, radius,
+              top ? p.title : p.titleInactive);
+    KDColor ink = top ? p.text : p.textDim;
+    const char* title = Apps::title(w.app);
+    int buttons = Apps::canMaximize(w.app) ? 3 : 2;
+    int maxTitle = r.w - 2 * (buttons * 19 + 6);
+    text(b, title, r.x + r.w / 2, r.y + 3, ink, Small, Align::Center, maxTitle);
+    if (top && s.keyboardFocus) {
+      // The window has the keys: Back gives them back to the pointer
+      int tw = textWidth(title);
+      if (r.w / 2 - tw / 2 > 70) {
+        roundFill(b, {r.x + 5, r.y + 4, 12, 12}, 6, p.accent);
+        text(b, "Retour", r.x + 20, r.y + 3, p.textDim, Small, Align::Left, 48);
+      } else {
+        roundFill(b, {r.x + 6, r.y + 7, 6, 6}, 3, p.accent);
+      }
+    } else {
+      tile(b, Apps::icon(w.app), 14, r.x + 5, r.y + 3);
+    }
+    drawTitleButton(b, titleButtonRect(i, 0), MintIcons::k_maskClose,
+                    isHovered(HitType::WindowClose, i), true, ink);
+    if (Apps::canMaximize(w.app)) {
+      drawTitleButton(b, titleButtonRect(i, 1),
+                      w.maximized ? MintIcons::k_maskRestore
+                                  : MintIcons::k_maskMaximize,
+                      isHovered(HitType::WindowMaximize, i), false, ink);
+    }
+    drawTitleButton(b, titleButtonRect(i, 2), MintIcons::k_maskMinimize,
+                    isHovered(HitType::WindowMinimize, i), false, ink);
+    b.resetClip();
+  }
+  if (!w.maximized) {
+    roundFrame(b, r, radius, top ? p.border : p.panelBorder);
+  }
+  Rect c = clientRect(i);
+  if (b.setClip(c)) {
+    Apps::draw(w.app, b, c, top && s.keyboardFocus && s.menu == Menu::None);
+    b.resetClip();
+  }
+  if (top && s.dragging) {
+    roundFrame(b, r.inset(-1), radius + 1, p.accent);
+  }
+}
+
+void drawBatteryIcon(Band& b, int x, int y, KDColor color) {
+  frame(b, {x, y, 16, 9}, color);
+  fill(b, {x + 16, y + 2, 2, 5}, color);
+  int pct = batteryPercent();
+  int w = 12 * pct / 100;
+  KDColor fillColor = pct <= 15 ? rgb(0xE04C4C) : color;
+  if (Ion::Battery::isCharging()) {
+    fillColor = rgb(0x7DB83A);
+  }
+  fill(b, {x + 2, y + 2, w, 5}, fillColor);
+}
+
+void drawPanel(Band& b) {
+  if (!showsPanel() || !k_panel.intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  fill(b, k_panel, p.panel, 245);
+  fill(b, {0, k_panelY, k_screenWidth, 1}, p.panelBorder);
+  // Menu button
+  if (s.menu == Menu::Main || isHovered(HitType::MenuButton)) {
+    fill(b, k_menuButton, p.hover, s.menu == Menu::Main ? 255 : 160);
+  }
+  mask(b, MintIcons::k_maskMintLogo, k_menuButton.x + 5, k_menuButton.y + 5,
+       s.menu == Menu::Main ? p.accent : p.text);
+  // Grouped window list
+  Item items[k_maxTaskItems];
+  int n = taskItems(items);
+  for (int i = 0; i < n; i++) {
+    Rect r = taskItemRect(i);
+    int w = items[i].kind == Item::Kind::Window
+                ? windowIndexOf(static_cast<WindowApp>(items[i].index))
+                : -1;
+    bool running = w >= 0 && s.windows[w].workspace == s.workspace;
+    bool active = running && w == s.numberOfWindows - 1 && windowVisible(w);
+    if (active || isHovered(HitType::TaskItem, i)) {
+      fill(b, r, p.hover, active ? 255 : 150);
+    }
+    drawItemIcon(b, items[i], 20, r.x + 3, r.y + 3);
+    if (running) {
+      fill(b, {r.x + (active ? 3 : 8), k_screenHeight - 2, active ? 19 : 9, 2},
+           active ? p.accent : p.textDim);
+    }
+  }
+  // Workspace switcher
+  for (int i = 0; i < 2; i++) {
+    Rect r = workspaceRect(i);
+    bool current = i == s.workspace;
+    roundFill(b, r, 2, current ? p.accent : p.hover, current ? 220 : 200);
+    // A dot per window
+    int dots = 0;
+    for (int k = 0; k < s.numberOfWindows && dots < 3; k++) {
+      if (s.windows[k].workspace == i && !s.windows[k].minimized) {
+        fill(b, {r.x + 3 + dots * 4, r.bottom() - 5, 3, 3},
+             current ? KDWhite : p.textDim);
+        dots++;
+      }
+    }
+  }
+  // Tray
+  auto trayHover = [&](Rect r, HitType t, Menu m) {
+    if (isHovered(t) || (m != Menu::None && s.menu == m)) {
+      fill(b, r, p.hover, s.menu == m ? 255 : 150);
+    }
+  };
+  trayHover(k_trayUpdates, HitType::TrayUpdates, Menu::None);
+  if (updatesPending()) {
+    mask(b, MintIcons::k_maskShield, k_trayUpdates.x + 2, k_trayUpdates.y + 7,
+         rgb(0xF0A23B));
+    roundFill(b, {k_trayUpdates.x + 11, k_trayUpdates.y + 5, 5, 5}, 3,
+              rgb(0xE04C4C));
+  } else {
+    mask(b, MintIcons::k_maskShieldCheck, k_trayUpdates.x + 2,
+         k_trayUpdates.y + 7, p.textDim);
+  }
+  trayHover(k_trayNetwork, HitType::TrayNetwork, Menu::Network);
+  mask(b, MintIcons::k_maskNetwork, k_trayNetwork.x + 2, k_trayNetwork.y + 7,
+       Ion::USB::isPlugged() ? p.text : p.textDim);
+  trayHover(k_traySound, HitType::TraySound, Menu::Sound);
+  mask(b,
+       s.muted || s.volume == 0 ? MintIcons::k_maskVolumeMute
+                                : MintIcons::k_maskVolume,
+       k_traySound.x + 2, k_traySound.y + 7, p.text);
+  trayHover(k_trayPower, HitType::TrayPower, Menu::Power);
+  drawBatteryIcon(b, k_trayPower.x + 1, k_trayPower.y + 10, p.text);
+  // Clock
+  trayHover(k_clock, HitType::Clock, Menu::Calendar);
+  char clock[8];
+  clockText(clock);
+  text(b, clock, k_clock.x + k_clock.w / 2, k_clock.y + 7, p.text, Small,
+       Align::Center);
+  // Show desktop
+  fill(b, k_showDesktop, isHovered(HitType::ShowDesktop) ? p.accent : p.hover,
+       isHovered(HitType::ShowDesktop) ? 255 : 120);
+}
+
+void drawMainMenu(Band& b) {
+  if (!k_menuRect.inset(-6).intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  shadow(b, k_menuRect, 4, 120);
+  fill(b, k_menuRect, p.menu);
+  fill(b, k_menuSide, p.menuSide);
+  frame(b, k_menuRect, p.menuBorder);
+  Hit hover = hitTest(s.cursorX, s.cursorY);
+  // Favorites and session buttons
+  for (int i = 0; i < k_numberOfFavorites; i++) {
+    Rect r = favoriteRect(i);
+    if (hover.type == HitType::MenuFavorite && hover.index == i) {
+      roundFill(b, r, 3, p.hover);
+    }
+    drawItemIcon(b, favoriteAt(i), 20, r.x + 2, r.y + 2);
+  }
+  fill(b, {6, 141, 18, 1}, p.panelBorder);
+  const MintIcons::Mask* session[k_numberOfSessionButtons] = {
+      &MintIcons::k_maskLock, &MintIcons::k_maskLogout,
+      &MintIcons::k_maskPower};
+  for (int i = 0; i < k_numberOfSessionButtons; i++) {
+    Rect r = sessionRect(i);
+    bool h = hover.type == HitType::MenuSession && hover.index == i;
+    if (h) {
+      roundFill(b, r, 3, i == 2 ? rgb(0xE04C4C) : p.hover);
+    }
+    mask(b, *session[i], r.x + 5, r.y + 3, h && i == 2 ? KDWhite : p.text);
+  }
+  // Search box
+  roundFill(b, k_searchBox, 3, p.entry);
+  roundFrame(b, k_searchBox, 3, p.accent);
+  if (s.searchLength > 0) {
+    text(b, s.search, k_searchBox.x + 6, k_searchBox.y + 2, p.text);
+  } else {
+    text(b, "Rechercher : tape un nom", k_searchBox.x + 6, k_searchBox.y + 2,
+         p.textDim);
+  }
+  int caretX = k_searchBox.x + 6 + textWidth(s.search);
+  if (s.searchLength == 0) {
+    caretX = k_searchBox.x + 6;
+  }
+  fill(b, {caretX, k_searchBox.y + 3, 1, 12}, p.text);
+  mask(b, MintIcons::k_maskSearch, k_searchBox.right() - 18, k_searchBox.y + 2,
+       p.textDim);
+  // Categories
+  if (s.searchLength == 0) {
+    for (int c = 0; c < k_numberOfCategories; c++) {
+      Rect r = categoryRect(c);
+      if (c == s.category) {
+        roundFill(b, r.inset(1), 3, p.hover);
+      }
+      mask(b, categoryIcon(c), r.x + 4, r.y + 2,
+           c == s.category ? p.accent : p.textDim);
+      text(b, categoryName(c), r.x + 20, r.y + 1, p.text, Small, Align::Left,
+           r.w - 22);
+    }
+  } else {
+    text(b, "Résultats", k_categoryX + 4, k_rowsY + 1, p.textDim);
+  }
+  fill(b, {k_listX - 2, k_rowsY, 1, k_visibleRows * k_rowHeight},
+       p.panelBorder);
+  // Applications
+  int count = menuItemCount();
+  if (count == 0) {
+    text(b, "Aucun résultat", k_listX + 6, k_rowsY + 4, p.textDim);
+  }
+  Item described = k_noItem;
+  for (int i = 0; i < k_visibleRows; i++) {
+    int index = s.menuScroll + i;
+    if (index >= count) {
+      break;
+    }
+    Rect r = menuRowRect(i);
+    Item it = menuItemAt(index);
+    bool h = hover.type == HitType::MenuItem && hover.index == i;
+    if (h || (s.searchLength > 0 && index == 0 && hover.type != HitType::MenuItem)) {
+      roundFill(b, r.inset(1), 3, h ? p.accent : p.hover);
+      described = it;
+    }
+    if (!r.intersects(b.area())) {
+      continue;
+    }
+    drawItemIcon(b, it, 14, r.x + 3, r.y + 1);
+    text(b, itemLabel(it), r.x + 22, r.y + 1, h ? KDWhite : p.text, Small,
+         Align::Left, r.w - 24);
+  }
+  if (count > k_visibleRows) {
+    for (int k = 0; k < 2; k++) {
+      Rect r = k == 0 ? k_scrollUp : k_scrollDown;
+      bool h = hover.type ==
+               (k == 0 ? HitType::MenuScrollUp : HitType::MenuScrollDown);
+      bool enabled = k == 0 ? s.menuScroll > 0
+                            : s.menuScroll + k_visibleRows < count;
+      roundFill(b, r, 3, h ? p.accent : p.hover, enabled ? 255 : 90);
+      mask(b, k == 0 ? MintIcons::k_maskChevronUp : MintIcons::k_maskChevronDown,
+           r.x + 9, r.y, enabled ? p.text : p.textDim);
+    }
+    char pages[12];
+    fmt(pages, sizeof(pages), "%d/%d", s.menuScroll / (k_visibleRows - 1) + 1,
+        (count - 2) / (k_visibleRows - 1) + 1);
+    text(b, pages, k_scrollUp.x - 4, k_scrollUp.y - 2, p.textDim, Small,
+         Align::Right);
+  }
+  // Description of the item under the pointer
+  if (hover.type == HitType::MenuFavorite) {
+    described = favoriteAt(hover.index);
+  }
+  fill(b, {k_menuInfo.x, k_menuInfo.y - 1, k_menuInfo.w, 1}, p.panelBorder);
+  if (!described.isNone()) {
+    text(b, itemLabel(described), k_menuInfo.x + 2, k_menuInfo.y, p.text, Small,
+         Align::Left, k_menuInfo.w);
+    text(b, itemDescription(described), k_menuInfo.x + 2, k_menuInfo.y + 13,
+         p.textDim, Small, Align::Left, k_menuInfo.w);
+  } else if (hover.type == HitType::MenuSession) {
+    constexpr const char* k[3] = {"Verrouiller l'écran", "Fermer la session",
+                                  "Quitter"};
+    text(b, k[hover.index], k_menuInfo.x + 2, k_menuInfo.y, p.text);
+    text(b, "numworks@mint", k_menuInfo.x + 2, k_menuInfo.y + 13, p.textDim);
+  } else {
+    text(b, "Linux Mint 22 « Wilma »", k_menuInfo.x + 2, k_menuInfo.y, p.text);
+    text(b, "Cinnamon 6.2 sur NumWorks", k_menuInfo.x + 2, k_menuInfo.y + 13,
+         p.textDim);
+  }
+}
+
+void drawSlider(Band& b, int y, const MintIcons::Mask& icon, int value1000) {
+  const Palette& p = palette();
+  mask(b, icon, k_sliderX - 22, y - 7, p.text);
+  int knob = k_sliderX + value1000 * k_sliderWidth / 1000;
