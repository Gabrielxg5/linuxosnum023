+/* ======================================================== photo session */
+
+#if !PLATFORM_DEVICE
+namespace {
+
+KDColor s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    Shell::render(band);
+    memcpy(s_shot + y * k_screenWidth, band.pixels(),
+           sizeof(KDColor) * k_screenWidth * Band::k_maxHeight);
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("MINT_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void wait(int ms, const char* gif = nullptr, int every = 3) {
+  int n = 0;
+  for (int t = 0; t < ms; t += 40) {
+    s_fakeNow += 40;
+    if ((s_fakeNow / 40) % 8 == 0) {
+      Shell::tick();
+    }
+    Shell::frame();
+    if (gif && (n++ % every) == 0) {
+      char name[64];
+      snprintf(name, sizeof(name), "%s_%04d", gif, s_gifFrame++);
+      shoot(name);
+    }
+  }
+}
+
+void key(Event e, int ms = 120, const char* gif = nullptr) {
+  Shell::handleEvent(e);
+  Item it = Shell::takeLaunch();
+  (void)it;
+  wait(ms, gif);
+}
+
+void type(const char* text, const char* gif = nullptr) {
+  for (const char* p = text; *p; p++) {
+    Event e = Events::None;
+    // Find the key event that types this character
+    for (int k = 0; k < Event::k_specialEventsOffset; k++) {
+      Event ev(k);
+      const char* t = ev.text();
+      if (t && t[0] == *p && t[1] == 0) {
+        e = ev;
+        break;
+      }
+    }
+    if (e != Events::None) {
+      key(e, 40, gif);
+    }
+  }
+}
+
+void moveTo(int x, int y, const char* gif = nullptr) {
+  invalidateAll();
+  s.cursorX = x;
+  s.cursorY = y;
+  updateHover();
+  wait(40, gif);
+}
+
+void clickAt(int x, int y, bool right = false, int ms = 300,
+             const char* gif = nullptr) {
+  moveTo(x, y, gif);
+  key(right ? Events::Toolbox : Events::OK, ms, gif);
+}
+
+void photoSession() {
+  s_fakeClock = true;
+  s_fakeNow = 1000;
+  s.clockOffsetMinutes = 14 * 60 + 30;
+  s.modeStart = s_fakeNow;
+  setInstalled(Package::Snake, true);
+  // Boot
+  wait(1200);
+  shoot("grub");
+  key(Events::Down, 100);
+  key(Events::Down, 100);
+  key(Events::Down, 100);
+  key(Events::OK, 1500);
+  shoot("memtest");
+  key(Events::Back, 200);
+  key(Events::OK, 1400);
+  shoot("splash");
+  wait(1400);
+  type("calcul");
+  shoot("login");
+  key(Events::EXE, 600);
+  shoot("welcome");
+  // Desktop with the menu
+  closeWindow(windowIndexOf(WindowApp::Welcome));
+  s.notification.until = 0;
+  wait(200);
+  shoot("bureau");
+  key(Events::Var, 200);
+  moveTo(60, 70);
+  moveTo(160, 72);
+  shoot("menu");
+  moveTo(60, 123);
+  moveTo(170, 70);
+  shoot("menu_jeux");
+  type("term");
+  shoot("menu_recherche");
+  key(Events::EXE, 300);
+  // Terminal
+  type("neofetch");
+  key(Events::EXE, 300);
+  shoot("neofetch");
+  type("sudo apt install sl");
+  key(Events::EXE, 300);
+  type("calcul");
+  key(Events::EXE, 2600);
+  shoot("apt");
+  type("sl");
+  key(Events::EXE, 900);
+  shoot("sl");
+  wait(3500);
+  type("cowsay -f tux salut");
+  key(Events::EXE, 300);
+  shoot("cowsay");
+  type("vim");
+  key(Events::EXE, 300);
+  key(Events::OK, 100);
+  key(Events::OK, 100);
+  key(Events::OK, 100);
+  shoot("vim");
+  type(":q");
+  key(Events::EXE, 200);
+  type("cmatrix");
+  key(Events::EXE, 1600);
+  shoot("cmatrix");
+  key(Events::OK, 200);
+  key(Events::Back, 200);
+  // Files
+  minimizeWindow(windowIndexOf(WindowApp::Terminal));
+  openDesktopIcon(1);
+  wait(200);
+  shoot("fichiers");
+  closeWindow(windowIndexOf(WindowApp::Files));
+  // System monitor
+  openWindow(WindowApp::SysMonitor);
+  s.sysmon.tab = 1;
+  wait(3000);
+  shoot("moniteur");
+  closeWindow(windowIndexOf(WindowApp::SysMonitor));
+  // Software manager
+  openWindow(WindowApp::Software);
+  wait(200);
+  shoot("logitheque");
+  closeWindow(windowIndexOf(WindowApp::Software));
+  // Update manager
+  openWindow(WindowApp::Updates);
+  wait(200);
+  shoot("mises_a_jour");
+  closeWindow(windowIndexOf(WindowApp::Updates));
+  // Settings
+  openWindow(WindowApp::Settings);
+  s.settings.section = 0;
+  wait(200);
+  shoot("parametres");
+  closeWindow(windowIndexOf(WindowApp::Settings));
+  // Calendar
+  clickAt(290, 226);
+  shoot("calendrier");
+  key(Events::Back, 100);
+  // Context menu
+  clickAt(200, 90, true);
+  shoot("clic_droit");
+  key(Events::Back, 100);
+  // Penguins
+  setInstalled(Package::XPenguins, true);
+  openWindow(WindowApp::Snake);
+  key(Events::Back, 100);
+  togglePenguins();
+  s.notification.until = 0;
+  wait(3000, "gifpenguins", 2);
+  shoot("pingouins");
+  togglePenguins();
+  closeWindow(windowIndexOf(WindowApp::Snake));
+  // Calculation notification
+  Calc::push("6\xC3\x97" "7", "42");
+  Shell::enter();
+  wait(200);
+  shoot("notif_42");
+  s.notification.until = 0;
+  // Crash of Cinnamon
+  crashCinnamon();
+  wait(200);
+  shoot("crash");
+  dialogButton(1);
+  s.notification.until = 0;
+  // Lock screen
+  setMode(Mode::Lock);
+  wait(200);
+  shoot("verrouillage");
+  setMode(Mode::Desktop);
+  // Destruction
+  focusWindow(windowIndexOf(WindowApp::Terminal));
+  s.keyboardFocus = true;
+  type("sudo rm -rf / --no-preserve-root");
+  key(Events::EXE, 200, "gifrmrf");
+  wait(4600, "gifrmrf", 3);
+  shoot("panic_debut");
+  wait(1500);
+  shoot("panic");
+  exit(0);
+}
+
+}  // namespace
+#endif
+
+}  // namespace Mint
+}  // namespace Home
