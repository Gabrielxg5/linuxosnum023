+Rect contextRect() {
+  int h = 6 + s.numberOfContextItems * k_contextItemHeight;
+  int x = s.contextX;
+  int y = s.contextY;
+  if (y + h > k_panelY - 2) {
+    y = s.contextY - h;
+  }
+  if (y < 2) {
+    y = 2;
+  }
+  if (x + k_contextWidth > k_screenWidth - 2) {
+    x = k_screenWidth - 2 - k_contextWidth;
+  }
+  if (x < 2) {
+    x = 2;
+  }
+  return {x, y, k_contextWidth, h};
+}
