+void enter() {
+  buildItems();
+  if (!s.initialized) {
+    s.initialized = true;
+    s.cursorX = 150;
+    s.cursorY = 100;
+    s.cursorSpeed = 3;
+    s.theme = 0;
+    s.accent = 0;
+    s.volume = 70;
+    s.showWelcome = true;
+    s.desktopSelected = -1;
+    setInstalled(Package::Mines, true);
+    setInstalled(Package::Neofetch, true);
+    setInstalled(Package::Fortune, true);
+    s.calculationsSeen = Calc::count();
+    s.terminal.cwd = 0;
+    s.sysmon.cpuHead = 0;
+    s.software.installing = -1;
+    pin(windowItem(WindowApp::Files));
+    pin(windowItem(WindowApp::Terminal));
+    Item calc = builtinNamed(I18n::Message::CalculApp);
+    if (!calc.isNone()) {
+      pin(calc);
+    }
+    s.g2048.best = 0;
+    s.mode = Mode::Grub;
+    s.modeStart = now() == 0 ? 1 : now();
+  }
+  // Forget pins to games that are gone
+  for (int i = 0; i < s.numberOfPanelPins;) {
+    if (!itemIsValid(s.panelPins[i])) {
+      unpin(s.panelPins[i]);
+    } else {
+      i++;
+    }
+  }
+  updatePalette();
+  prepareWallpaper(s.theme);
+  s.menu = Menu::None;
+  s.dragging = false;
+  s.searchLength = 0;
+  s.alphaLockedByUs = false;
+  s.hoverKey = hitTest(s.cursorX, s.cursorY).key();
+  if (s.numberOfWindows == 0 ||
+      !windowVisible(s.numberOfWindows - 1)) {
+    s.keyboardFocus = false;
+  }
+  if (s.mode == Mode::Desktop) {
+    notifyCalculation();
+  } else if (s.mode == Mode::Login || s.mode == Mode::Lock) {
+    setAlphaLock(true);
+  }
+  s_launch = k_noItem;
+#if !PLATFORM_DEVICE
+  if (getenv("MINT_SHOTS") && !s_fakeClock) {
+    photoSession();
+  }
+#endif
+}
+
+void leave() {
+  setAlphaLock(false);
+  s.dragging = false;
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
