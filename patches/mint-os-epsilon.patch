+/* =============================================================== Snake */
+
+namespace SnakeGame {
+
+constexpr int k_cell = 8;
+constexpr int k_width = SnakeState::k_columns * k_cell + 8;
+constexpr int k_height = SnakeState::k_rows * k_cell + 26;
+
+void placeFood(SnakeState& g) {
+  for (int tries = 0; tries < 200; tries++) {
+    uint8_t x = random(SnakeState::k_columns);
+    uint8_t y = random(SnakeState::k_rows);
+    bool onSnake = false;
+    for (int i = 0; i < g.length; i++) {
+      onSnake = onSnake || (g.x[i] == x && g.y[i] == y);
+    }
+    if (!onSnake) {
+      g.foodX = x;
+      g.foodY = y;
+      return;
+    }
+  }
+}
+
+void reset(SnakeState& g) {
+  g.length = 4;
+  for (int i = 0; i < g.length; i++) {
+    g.x[i] = 8 - i;
+    g.y[i] = SnakeState::k_rows / 2;
+  }
+  g.direction = g.nextDirection = 0;
+  g.score = 0;
+  g.dead = false;
+  g.started = false;
+  placeFood(g);
+}
+
+Rect boardRect(Rect c) {
+  return {c.x + 4, c.y + 22, SnakeState::k_columns * k_cell,
+          SnakeState::k_rows * k_cell};
+}
+
+Rect cellRect(Rect c, int x, int y) {
+  Rect board = boardRect(c);
+  return {board.x + x * k_cell, board.y + y * k_cell, k_cell, k_cell};
+}
+
+void step(SnakeState& g, Rect c) {
+  // No U-turn
+  if ((g.nextDirection + 2) % 4 != g.direction) {
+    g.direction = g.nextDirection;
+  }
+  int dx = g.direction == 0 ? 1 : (g.direction == 2 ? -1 : 0);
+  int dy = g.direction == 1 ? 1 : (g.direction == 3 ? -1 : 0);
+  int nx = g.x[0] + dx;
+  int ny = g.y[0] + dy;
+  if (nx < 0 || ny < 0 || nx >= SnakeState::k_columns ||
+      ny >= SnakeState::k_rows) {
+    g.dead = true;
+    invalidate(c);
+    return;
+  }
+  for (int i = 0; i < g.length - 1; i++) {
+    if (g.x[i] == nx && g.y[i] == ny) {
+      g.dead = true;
+      invalidate(c);
+      return;
+    }
+  }
+  bool eat = nx == g.foodX && ny == g.foodY;
+  // Tail cell to clear
+  invalidate(cellRect(c, g.x[g.length - 1], g.y[g.length - 1]));
+  if (eat && g.length < SnakeState::k_maxLength) {
+    g.length++;
+  }
+  for (int i = g.length - 1; i > 0; i--) {
+    g.x[i] = g.x[i - 1];
+    g.y[i] = g.y[i - 1];
+  }
+  g.x[0] = nx;
+  g.y[0] = ny;
+  invalidate(cellRect(c, g.x[1], g.y[1]));
+  invalidate(cellRect(c, nx, ny));
+  if (eat) {
+    g.score++;
+    if (g.score > g.best) {
+      g.best = g.score;
+    }
+    placeFood(g);
+    invalidate(cellRect(c, g.foodX, g.foodY));
+    invalidate({c.x, c.y, c.w, 20});
+  }
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  (void)p;
+  SnakeState& g = s.snake;
+  fill(b, c, p.windowBack);
+  char buffer[32];
+  fmt(buffer, sizeof(buffer), "Score %d", g.score);
+  text(b, buffer, c.x + 6, c.y + 3, p.text);
+  fmt(buffer, sizeof(buffer), "Record %d", g.best);
+  text(b, buffer, c.right() - 6, c.y + 3, p.textDim, Small, Align::Right);
+  Rect board = boardRect(c);
+  fill(b, board, KDColor::RGB24(0x16261A));
+  // Checkerboard, lightly
+  for (int y = 0; y < SnakeState::k_rows; y++) {
+    for (int x = (y & 1); x < SnakeState::k_columns; x += 2) {
+      fill(b, cellRect(c, x, y), KDColor::RGB24(0x1B2E20));
+    }
+  }
+  Rect food = cellRect(c, g.foodX, g.foodY);
+  roundFill(b, food.inset(1), 3, KDColor::RGB24(0xE84A3C));
+  for (int i = g.length - 1; i >= 0; i--) {
+    Rect r = cellRect(c, g.x[i], g.y[i]);
+    KDColor col = i == 0 ? KDColor::RGB24(0x9BE37A) : KDColor::RGB24(0x46C26A);
+    roundFill(b, r, 2, col);
+  }
+  if (g.dead || !g.started || !focused) {
+    const char* msg = g.dead ? "Perdu ! OK : rejouer"
+                             : (focused ? "Flèches : partir" : "OK : jouer");
+    int w = textWidth(msg) + 16;
+    Rect box = {board.x + (board.w - w) / 2, board.y + board.h / 2 - 11, w,
+                22};
+    roundFill(b, box, 5, KDBlack, 180);
+    text(b, msg, box.x + box.w / 2, box.y + 4, k_white, Small, Align::Center);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  SnakeState& g = s.snake;
+  int direction = e == Events::Right  ? 0
+                  : e == Events::Down ? 1
+                  : e == Events::Left ? 2
+                  : e == Events::Up   ? 3
+                                      : -1;
+  if (direction >= 0 && !g.dead) {
+    if (!g.started) {
+      g.started = true;
+      invalidate(c);
+    }
+    if ((direction + 2) % 4 != g.direction) {
+      g.nextDirection = direction;
+      // Turning moves right away: holding a key makes the snake run
+      step(g, c);
+    }
+    return true;
+  }
+  if ((e == Events::OK || e == Events::EXE) && g.dead) {
+    reset(g);
+    invalidate(c);
+    return true;
+  }
+  return false;
+}
+
+bool tick(bool focused, Rect c) {
+  SnakeState& g = s.snake;
+  if (!focused || g.dead || !g.started) {
+    return false;
+  }
+  step(g, c);
+  return true;
+}
