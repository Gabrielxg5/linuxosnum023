+// One line of output of a job at this step; false when the job is over
+bool jobLine(uint8_t job, int step, char* line, int size, uint8_t* style) {
+  TerminalState& st = t();
+  *style = St::Normal;
+  switch (job) {
+    case JobAptUpdate: {
+      constexpr const char* k[] = {
+          "Atteint:1 http://packages.linuxmint.com wilma InRelease",
+          "Atteint:2 http://archive.ubuntu.com noble InRelease",
+          "Réception de:3 http://archive.ubuntu.com noble-updates [126 kB]",
+          "Réception de:4 http://security.ubuntu.com noble-security [126 kB]",
+          "252 ko réceptionnés en 1s (252 ko/s)",
+          "Lecture des listes de paquets... Fait",
+          nullptr};
+      if (step >= 6) {
+        if (step == 6) {
+          fmt(line, size, "%s", s.updates.phase == 2
+                                    ? "Tous les paquets sont à jour."
+                                    : "5 paquets peuvent être mis à jour.");
+          *style = St::Bold;
+          return true;
+        }
+        return false;
+      }
+      fmt(line, size, "%s", k[step]);
+      return true;
+    }
+    case JobAptInstall:
+    case JobAptRemove: {
+      Package pk;
+      packageNamed(st.arg, &pk);
+      const PackageInfo& info = packageInfo(pk);
+      bool install = job == JobAptInstall;
+      switch (step) {
+        case 0:
+          fmt(line, size, "Lecture des listes de paquets... Fait");
+          return true;
+        case 1:
+          fmt(line, size, "Construction de l'arbre des dépendances... Fait");
+          return true;
+        case 2:
+          fmt(line, size, install ? "Les NOUVEAUX paquets suivants seront installés :"
+                                  : "Les paquets suivants seront ENLEVÉS :");
+          return true;
+        case 3:
+          fmt(line, size, "  %s", info.apt);
+          return true;
+        case 4:
+          fmt(line, size, install ? "Réception de:1 http://archive.ubuntu.com %s [%d kB]"
+                                  : "%s%d ko d'espace disque seront libérés.",
+              install ? info.apt : "", static_cast<int>(info.sizeKB));
+          return true;
+        case 5:
+          fmt(line, size, install ? "Dépaquetage de %s ..." : "Suppression de %s ...",
+              info.apt);
+          return true;
+        case 6:
+          if (!install) {
+            return false;
+          }
+          fmt(line, size, "Paramétrage de %s ...", info.apt);
+          return true;
+        case 7:
+          if (!install) {
+            return false;
+          }
+          fmt(line, size, "Traitement des actions différées pour man-db ...");
+          *style = St::Dim;
+          return true;
+        default:
+          return false;
+      }
+    }
+    case JobAptUpgrade: {
+      constexpr const char* k[] = {
+          "Lecture des listes de paquets... Fait",
+          "Calcul de la mise à jour... Fait",
+          "Les paquets suivants seront mis à jour :",
+          "  cinnamon epsilon-numworks firefox",
+          "  linux-image-6.8.0 mint-themes",
+          "Paramétrage de cinnamon (6.2.9) ...",
+          "Paramétrage de epsilon-numworks (26.4.1) ...",
+          "Paramétrage de firefox (132.0) ...",
+          nullptr};
+      if (s.updates.phase == 2 && step == 2) {
+        fmt(line, size, "0 mis à jour, 0 nouvellement installés.");
+        return true;
+      }
+      if (s.updates.phase == 2 && step > 2) {
+        return false;
+      }
+      if (step >= 8) {
+        return false;
+      }
+      fmt(line, size, "%s", k[step]);
+      return true;
+    }
+    case JobRmRf: {
+      constexpr const char* k[] = {
+          "/usr/bin/cinnamon", "/usr/bin/python3", "/usr/lib/firefox",
+          "/etc/fstab", "/boot/vmlinuz-6.8.0", "/usr/share/icons/Mint-Y",
+          "/home/numworks/Scripts", "/usr/lib/systemd", "/bin/bash",
+          "/lib/modules", "/usr/bin/sudo", "/sbin/init"};
+      if (step >= 40) {
+        return false;
+      }
+      fmt(line, size, "rm: suppression de '%s'", k[step % 12]);
+      if (step == 18) {
+        fmt(line, size, "rm: suppression de '/usr/bin/rm'");
+      }
+      return true;
+    }
+    case JobPing: {
+      if (step == 0) {
+        fmt(line, size, "PING %s (127.3.14.15) 56(84) octets", st.arg);
+        return true;
+      }
+      if (step <= 4) {
+        int ms = 3 + rnd(40);
+        fmt(line, size, "64 octets de %s : icmp_seq=%d ttl=64 temps=%d ms",
+            st.arg, step, ms);
+        return true;
+      }
+      if (step == 5) {
+        fmt(line, size, "--- %s : 4 paquets, 0 %% de perte ---", st.arg);
+        return true;
+      }
+      return false;
+    }
+    case JobReboot:
+      if (step == 0) {
+        fmt(line, size, "Broadcast message from root@mint:");
+        return true;
+      }
+      if (step == 1) {
+        fmt(line, size, "The system will reboot now!");
+        *style = St::Bold;
+        return true;
+      }
+      return false;
+    default:
+      return false;
+  }
+}
+
+int jobDelay(uint8_t job) {
+  switch (job) {
+    case JobRmRf:
+      return 70;
+    case JobPing:
+      return 600;
+    case JobReboot:
+      return 700;
+    default:
+      return 260;
+  }
+}
+
+void finishJob(uint8_t job) {
+  TerminalState& st = t();
+  switch (job) {
+    case JobAptInstall:
+    case JobAptRemove: {
+      Package pk;
+      if (packageNamed(st.arg, &pk)) {
+        setInstalled(pk, job == JobAptInstall);
+        invalidateAll();
+      }
+      break;
+    }
+    case JobAptUpgrade:
+      if (s.updates.phase != 2) {
+        s.updates.phase = 2;
+        notify("Mises à jour", "Système à jour (via apt).",
+               MintIcons::TileUpdates);
+        invalidateAll();
+      }
+      break;
+    case JobReboot:
+      stopAnim();
+      reboot();
+      return;
+    default:
+      break;
+  }
+  stopAnim();
+}
