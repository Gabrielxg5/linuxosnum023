+/* -------------------------------------------------------------- parsing */
+
+constexpr int k_maxArgs = 8;
+
+struct Args {
+  char buffer[TerminalState::k_inputSize + 8];
+  const char* argv[k_maxArgs];
+  int argc;
+  const char* redirect;  // file after > or >>
+  bool append;
+  const char* rest;      // everything after the command name
+};
+
+void parse(const char* cmd, Args* a) {
+  strlcpy(a->buffer, cmd, sizeof(a->buffer));
+  a->argc = 0;
+  a->redirect = nullptr;
+  a->append = false;
+  a->rest = "";
+  char* p = a->buffer;
+  // The × key types a multiplication sign: make it a star
+  for (char* q = p; *q; q++) {
+    if (static_cast<uint8_t>(q[0]) == 0xC3 && static_cast<uint8_t>(q[1]) == 0x97) {
+      q[0] = '*';
+      memmove(q + 1, q + 2, strlen(q + 2) + 1);
+    }
+  }
+  const char* original = cmd;
+  while (*original == ' ') {
+    original++;
+  }
+  const char* space = strchr(original, ' ');
+  if (space) {
+    while (*space == ' ') {
+      space++;
+    }
+    a->rest = cmd + (space - cmd);
+  }
+  while (*p && a->argc < k_maxArgs) {
+    while (*p == ' ') {
+      p++;
+    }
+    if (!*p) {
+      break;
+    }
+    if (*p == '>') {
+      a->append = p[1] == '>';
+      p += a->append ? 2 : 1;
+      while (*p == ' ') {
+        p++;
+      }
+      a->redirect = p;
+      char* end = strchr(p, ' ');
+      if (end) {
+        *end = 0;
+      }
+      break;
+    }
+    if (*p == '"' || *p == '\'') {
+      char quote = *p++;
+      a->argv[a->argc++] = p;
+      while (*p && *p != quote) {
+        p++;
+      }
+    } else {
+      a->argv[a->argc++] = p;
+      while (*p && *p != ' ' && *p != '>') {
+        p++;
+      }
+      if (*p == '>') {
+        // "echo hi>a.py": keep the > for the next round
+        char c = *p;
+        *p = 0;
+        if (c == '>') {
+          *p = 0;
+          a->append = p[1] == '>';
+          char* r = p + (a->append ? 2 : 1);
+          while (*r == ' ') {
+            r++;
+          }
+          a->redirect = r;
+          char* end = strchr(r, ' ');
+          if (end) {
+            *end = 0;
+          }
+          return;
+        }
+      }
+    }
+    if (*p) {
+      *p++ = 0;
+    }
+  }
+}
+
+bool is(const char* a, const char* b) { return a && strcmp(a, b) == 0; }
+
+bool hasFlag(const Args& a, char flag) {
+  for (int i = 1; i < a.argc; i++) {
+    if (a.argv[i][0] == '-' && strchr(a.argv[i], flag)) {
+      return true;
+    }
+  }
+  return false;
+}
