+
+void apt(const Args& a, bool root) {
+  const char* sub = a.argc > 1 ? a.argv[1] : "";
+  if (is(sub, "moo")) {
+    printLines(
+        "                 (__)\n                 (oo)\n           /------\\/\n"
+        "          / |    ||\n         *  /\\---/\\\n            ~~   ~~\n"
+        "...\"Have you mooed today?\"...",
+        St::Normal);
+    return;
+  }
+  if (is(sub, "list")) {
+    for (int i = 0; i < k_numberOfPackages; i++) {
+      Package p = static_cast<Package>(i);
+      out(isInstalled(p) ? St::Green : St::Normal, "%s/wilma %s",
+          packageInfo(p).apt, isInstalled(p) ? "[installé]" : "");
+    }
+    return;
+  }
+  if (is(sub, "search")) {
+    for (int i = 0; i < k_numberOfPackages; i++) {
+      const PackageInfo& info = packageInfo(static_cast<Package>(i));
+      if (a.argc < 3 || findText(info.apt, a.argv[2]) ||
+          findText(info.title, a.argv[2])) {
+        out(St::Green, "%s", info.apt);
+        out(St::Normal, "  %s", info.description);
+      }
+    }
+    return;
+  }
+  bool known = is(sub, "update") || is(sub, "upgrade") ||
+               is(sub, "install") || is(sub, "remove") || is(sub, "purge") ||
+               is(sub, "full-upgrade");
+  if (!known) {
+    print("apt 2.7.14 (arm64)");
+    print("Usage : apt [options] commande");
+    print("Commandes : list search install remove");
+    print("            update upgrade (et peut-être moo)");
+    return;
+  }
+  if (!root) {
+    permissionDenied(is(sub, "update") ? "/var/lib/apt/lists/lock"
+                                       : "/var/lib/dpkg/lock-frontend");
+    return;
+  }
+  if (is(sub, "update")) {
+    startAnim(JobAptUpdate);
+    return;
+  }
+  if (is(sub, "upgrade") || is(sub, "full-upgrade")) {
+    startAnim(JobAptUpgrade);
+    return;
+  }
+  if (a.argc < 3) {
+    print("0 mis à jour, 0 nouvellement installés.");
+    return;
+  }
+  const char* name = a.argv[2];
+  Package p;
+  if (is(name, "cerveau") || is(name, "brain")) {
+    print("E: Le paquet « cerveau » n'a pas de version", St::Red);
+    print("disponible. Essaie de réviser.", St::Red);
+    return;
+  }
+  if (is(name, "windows") || is(name, "windows11")) {
+    print("E: Paquet incompatible : nécessite 4 Go", St::Red);
+    print("de RAM et une puce TPM 2.0. Tu as 256 Ko.", St::Red);
+    return;
+  }
+  if (is(name, "steam")) {
+    print("E: steam : architecture x86 requise.", St::Red);
+    print("Ceci est une calculatrice ARM.", St::Red);
+    return;
+  }
+  if (!packageNamed(name, &p)) {
+    print("Lecture des listes de paquets... Fait");
+    out(St::Red, "E: Impossible de trouver le paquet %s", name);
+    return;
+  }
+  bool install = is(sub, "install");
+  if (install == isInstalled(p)) {
+    out(St::Normal, install ? "%s est déjà la version la plus récente."
+                            : "Le paquet « %s » n'est pas installé.",
+        packageInfo(p).apt);
+    return;
+  }
+  startAnim(install ? JobAptInstall : JobAptRemove, packageInfo(p).apt);
+}
