+void drawFetchLine(Band& b, const char* line, int x, int y, bool palette) {
+  if (palette) {
+    constexpr uint32_t k_colors[8] = {0x2E3436, 0xCC0000, 0x4E9A06, 0xC4A000,
+                                      0x3465A4, 0x75507B, 0x06989A, 0xD3D7CF};
+    for (int i = 0; i < 8; i++) {
+      fill(b, {x + 16 * glyphWidth() + i * 14, y + 1, 14, 12}, rgb(k_colors[i]));
+    }
+    return;
+  }
+  char logo[20];
+  int n = fit(line, 16);
+  memcpy(logo, line, n);
+  logo[n] = 0;
+  text(b, logo, x, y, k_green);
+  const char* info = line + n;
+  x += 16 * glyphWidth();
+  const char* colon = strchr(info, ':');
+  const char* at = strchr(info, '@');
+  if (at && !colon) {
+    text(b, info, x, y, k_green);
+    return;
+  }
+  if (!colon) {
+    text(b, info, x, y, k_fore);
+    return;
+  }
+  char key[24];
+  int k = colon - info + 1;
+  k = k < 23 ? k : 23;
+  memcpy(key, info, k);
+  key[k] = 0;
+  text(b, key, x, y, k_green);
+  text(b, colon + 1, x + columnsOf(key) * glyphWidth(), y, k_fore);
+}
+
+// The train, drawn by Mint-OS (in the spirit of sl, not a copy)
+constexpr const char* k_train[] = {
+    "      (@@@)  (  )   (@)  ( )        ",
+    "     ====        ________         ",
+    "  _D _|  |______/        \\___     ",
+    "   |(_)---  |  H\\________/   |    ",
+    "   /     |  |  H  |    |     |___ ",
+    "  |______|__|__H__|____|_____|   |",
+    "   \\_O=O=O=O_/    \\_O_/ \\_O_/    ",
+};
+constexpr int k_trainLines = sizeof(k_train) / sizeof(k_train[0]);
+constexpr int k_trainWidth = 36;
+
+void drawSl(Band& b, Rect c) {
+  TerminalState& st = t();
+  // sl clears the screen while the train goes by
+  fill(b, c, k_back);
+  uint32_t elapsed = now() - st.animStart;
+  int gw = glyphWidth();
+  int x = c.right() - static_cast<int>(elapsed / 7);
+  int y0 = c.y + (c.h - k_trainLines * k_lineHeight) / 2;
+  for (int i = 0; i < k_trainLines; i++) {
+    const char* row = k_train[i];
+    if (i == 0) {
+      // Smoke puffs
+      if ((elapsed / 200) % 2) {
+        row = "     (  )  (@@)  ( )   (@@)       ";
+      }
+    }
+    if (i == k_trainLines - 1 && (elapsed / 150) % 2) {
+      row = "   \\_o=o=o=o_/    \\_o_/ \\_o_/    ";
+    }
+    text(b, row, x, y0 + i * k_lineHeight, k_fore, Small, Align::Left,
+         k_trainWidth * gw);
+  }
+}
+
+void drawMatrix(Band& b, Rect c) {
+  TerminalState& st = t();
+  fill(b, c, KDBlack);
+  int rows = c.h / k_lineHeight;
+  int cols = c.w / glyphWidth();
+  if (cols > k_cols) {
+    cols = k_cols;
+  }
+  char ch[2] = {0, 0};
+  constexpr const char* k_glyphs = "01アイウエオカキクケコｱｲｳ$#@%&*+=<>?ZXQ";
+  (void)k_glyphs;
+  for (int col = 0; col < cols; col++) {
+    int head = st.rain[col];
+    for (int row = 0; row < rows; row++) {
+      int d = head - row;
+      if (d < 0 || d > 9) {
+        continue;
+      }
+      Rect cell = {c.x + col * glyphWidth(), c.y + row * k_lineHeight,
+                   glyphWidth(), k_lineHeight};
+      if (!cell.intersects(b.clip())) {
+        continue;
+      }
+      uint32_t h = (col * 7919 + row * 104729 + (st.step / 3) * (d == 0)) % 62;
+      ch[0] = h < 10 ? '0' + h : (h < 36 ? 'a' + h - 10 : 'A' + h - 36);
+      KDColor color = d == 0 ? KDColor::RGB24(0xD8FFD8)
+                             : KDColor::Blend(KDColor::RGB24(0x22DD22),
+                                              KDBlack,
+                                              static_cast<uint8_t>(255 - d * 24));
+      text(b, ch, cell.x, cell.y, color);
+    }
+  }
+}
+
+void drawVim(Band& b, Rect c) {
+  TerminalState& st = t();
+  int rows = c.h / k_lineHeight;
+  fill(b, {c.x + 2, c.y + 2, glyphWidth(), 12}, k_fore);
+  for (int i = 1; i < rows - 1; i++) {
+    text(b, "~", c.x + 2, c.y + 2 + i * k_lineHeight, k_blue);
+  }
+  if (rows > 6) {
+    int mid = c.y + 2 + (rows / 2 - 2) * k_lineHeight;
+    text(b, "VIM - Vi IMproved", c.x + c.w / 2, mid, k_fore, Small, Align::Center);
+    text(b, "version 9.1.0016", c.x + c.w / 2, mid + 14, k_fore, Small,
+         Align::Center);
+    text(b, "tape :q<EXE> pour sortir", c.x + c.w / 2, mid + 42, k_dim, Small,
+         Align::Center);
+  }
+  int y = c.y + 2 + (rows - 1) * k_lineHeight;
+  if (st.vimTyping) {
+    char line[16];
+    fmt(line, sizeof(line), ":%s", st.vimCommand);
+    text(b, line, c.x + 2, y, k_fore);
+    fill(b, {c.x + 2 + (1 + st.vimCommandLength) * glyphWidth(), y + 1, 1, 12},
+         k_fore);
+  } else if (st.vimMessage) {
+    text(b, st.vimMessage, c.x + 2, y, st.vimTries > 2 ? k_red : k_fore,
+         Small, Align::Left, c.w - 4);
+  }
+}
+
+}  // namespace
+
+/* =============================================================== public */
+
+void print(const char* line, uint8_t style) {
+  TerminalState& st = t();
+  // Wrap long lines
+  int len = strlen(line);
+  do {
+    scroll();
+    int n = fit(line, k_cols);
+    if (n > len) {
+      n = len;
+    }
+    memcpy(st.lines[TerminalState::k_lines - 1], line, n);
+    st.lines[TerminalState::k_lines - 1][n] = 0;
+    st.style[TerminalState::k_lines - 1] = style;
+    line += n;
+    len -= n;
+  } while (len > 0);
+}
+
+void reset() {
+  TerminalState& st = t();
+  memset(st.lines, 0, sizeof(st.lines));
+  memset(st.style, 0, sizeof(st.style));
+  st.inputLength = 0;
+  st.input[0] = 0;
+  st.historyPos = -1;
+  st.mode = Mode::Shell;
+  print("Bienvenue sur Linux Mint 22 (NumWorks)", St::Bold);
+  print("Tape help. Boîte à outils : compléter.", St::Dim);
+  print("Alpha : lettres/chiffres. Retour : souris.", St::Dim);
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  TerminalState& st = t();
+  fill(b, c, k_back);
+  if (st.mode == Mode::Anim && st.anim == AnimMatrix) {
+    drawMatrix(b, c);
+    return;
+  }
+  if (st.mode == Mode::Vim) {
+    drawVim(b, c);
+    return;
+  }
+  int rows = (c.h - 4) / k_lineHeight;
+  bool promptLine = st.mode == Mode::Shell || st.mode == Mode::Password ||
+                    st.mode == Mode::Bc;
+  int outputRows = promptLine ? rows - 1 : rows;
+  int first = TerminalState::k_lines - outputRows;
+  if (first < 0) {
+    first = 0;
+  }
+  int x = c.x + 3;
+  for (int i = first; i < TerminalState::k_lines; i++) {
+    int y = c.y + 2 + (i - first) * k_lineHeight;
+    if (y + k_lineHeight < b.clip().y || y > b.clip().bottom()) {
+      continue;
+    }
+    uint8_t style = st.style[i];
+    if (style == St::Prompt) {
+      drawPrompt(b, st.lines[i], x, y, findText(st.lines[i], "root@") == st.lines[i]);
+    } else if (style == St::Fetch || style == St::Palette) {
+      drawFetchLine(b, st.lines[i], x, y, style == St::Palette);
+    } else {
+      text(b, st.lines[i], x, y, styleColor(style), Small, Align::Left,
+           c.w - 4);
+    }
+  }
+  if (st.mode == Mode::Anim && st.anim == AnimSl) {
+    drawSl(b, c);
+    return;
+  }
+  if (!promptLine) {
+    return;
+  }
+  int y = c.y + 2 + outputRows * k_lineHeight;
+  char line[96];
+  int cursorCol;
+  if (st.mode == Mode::Password) {
+    fmt(line, sizeof(line), "[sudo] Mot de passe de %s : ", userName());
+    text(b, line, x, y, k_fore, Small, Align::Left, c.w - 4);
+    cursorCol = columnsOf(line);
+  } else if (st.mode == Mode::Bc) {
+    text(b, st.input, x, y, k_white, Small, Align::Left, c.w - 4);
+    cursorCol = columnsOf(st.input);
+  } else {
+    char prompt[48];
+    promptText(prompt, sizeof(prompt), false);
+    // Long inputs: only the end is shown, like a scrolling line
+    int maxCols = (c.w - 6) / glyphWidth() - 1;
+    int total = columnsOf(prompt) + columnsOf(st.input);
+    if (total > maxCols) {
+      const char* tail = st.input;
+      int skip = total - maxCols;
+      while (skip-- > 0 && *tail) {
+        tail += fit(tail, 1);
+      }
+      text(b, tail, x, y, k_white);
+      cursorCol = columnsOf(tail);
+    } else {
+      fmt(line, sizeof(line), "%s%s", prompt, st.input);
+      drawPrompt(b, line, x, y, false);
+      cursorCol = total;
+    }
+  }
+  if (focused && (now() / 500) % 2 == 0) {
+    fill(b, {x + cursorCol * glyphWidth(), y + 1, glyphWidth(), 12}, k_fore);
+  } else if (!focused) {
+    frame(b, {x + cursorCol * glyphWidth(), y + 1, glyphWidth(), 12}, k_dim);
+  }
+}
+
+bool animating() {
+  TerminalState& st = t();
+  return st.mode == Mode::Anim || st.mode == Mode::Job;
+}
+
+void frame(Rect c) {
+  TerminalState& st = t();
+  uint32_t elapsed = now() - st.animStart;
+  st.step++;
+  switch (st.mode) {
+    case Mode::Anim:
+      switch (st.anim) {
+        case AnimSl: {
+          int x = c.right() - static_cast<int>(elapsed / 7);
+          if (x + k_trainWidth * glyphWidth() < c.x) {
+            stopAnim();
+          }
+          invalidate(c);
+          return;
+        }
+        case AnimMatrix: {
+          int rows = c.h / k_lineHeight;
+          for (int i = 0; i < k_cols; i++) {
+            if (st.step % st.rainSpeed[i] == 0) {
+              st.rain[i]++;
+              if (st.rain[i] - 10 > rows) {
+                st.rain[i] = -static_cast<int8_t>(rnd(8));
+                st.rainSpeed[i] = 1 + rnd(3);
+              }
+            }
+          }
+          invalidate(c);
+          return;
+        }
+        case AnimYes:
+          print(st.arg);
+          print(st.arg);
+          invalidate(c);
+          return;
+        default:
+          stopAnim();
+          return;
+      }
+    case Mode::Job: {
+      int delay = jobDelay(st.anim);
+      int target = static_cast<int>(elapsed / delay);
+      // st.vimTries is free during jobs: lines printed so far
+      while (st.vimTries <= target) {
+        char line[96];
+        uint8_t style;
+        if (!jobLine(st.anim, st.vimTries, line, sizeof(line), &style)) {
+          uint8_t job = st.anim;
+          st.vimTries = 0;
+          finishJob(job);
+          invalidate(c);
+          return;
+        }
+        print(line, style);
+        st.vimTries++;
+      }
+      invalidate(c);
+      return;
+    }
+    default:
+      return;
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  TerminalState& st = t();
+  switch (st.mode) {
+    case Mode::Anim:
+      if (st.anim == AnimSl) {
+        // Like the real sl: Ctrl-C does not stop the train
+        return true;
+      }
+      stopAnim();
+      if (st.anim == AnimNone) {
+        print("^C");
+      }
+      invalidate(c);
+      return true;
+    case Mode::Job:
+      if (e == Events::Clear || e == Events::Backspace) {
+        if (st.anim != JobRmRf && st.anim != JobReboot) {
+          print("^C");
+          st.vimTries = 0;
+          stopAnim();
+          invalidate(c);
+        }
+      }
+      return true;
+    case Mode::Vim: {
+      if (e == Events::EXE || e == Events::OK) {
+        if (st.vimTyping) {
+          st.vimTyping = false;
+          const char* cmd = st.vimCommand;
+          if (is(cmd, "q") || is(cmd, "q!") || is(cmd, "wq") || is(cmd, "x") ||
+              is(cmd, "wq!") || is(cmd, "qa") || is(cmd, "qa!")) {
+            st.mode = Mode::Shell;
+            st.vimTries = 0;
+            print("(tu as réussi à quitter vim, bravo)", St::Dim);
+          } else if (is(cmd, "help")) {
+            st.vimMessage = ":help → tape :q pour sortir";
+          } else {
+            st.vimMessage = "E492: Pas une commande d'éditeur";
+          }
+          st.vimCommandLength = 0;
+          st.vimCommand[0] = 0;
+        } else {
+          st.vimTries++;
+          st.vimMessage = st.vimTries > 2 ? "Astuce : tape :q puis EXE (deux-points)"
+                                          : "E37: Modifications non enregistrées";
+        }
+        invalidate(c);
+        return true;
+      }
+      if (e == Events::Backspace) {
+        if (st.vimTyping && st.vimCommandLength > 0) {
+          st.vimCommand[--st.vimCommandLength] = 0;
+        } else {
+          st.vimTyping = false;
+        }
+        invalidate(c);
+        return true;
+      }
+      const char* txt = e.text();
+      if (txt && txt[0] && !txt[1]) {
+        if (txt[0] == ':' && !st.vimTyping) {
+          st.vimTyping = true;
+          st.vimCommandLength = 0;
+          st.vimCommand[0] = 0;
+        } else if (st.vimTyping && st.vimCommandLength < 10) {
+          st.vimCommand[st.vimCommandLength++] = txt[0];
+          st.vimCommand[st.vimCommandLength] = 0;
+        } else if (!st.vimTyping) {
+          st.vimTries++;
+          st.vimMessage = st.vimTries > 2 ? "Astuce : tape :q puis EXE (deux-points)"
+                                          : "-- INSERTION -- (enfin, presque)";
+        }
+        invalidate(c);
+      }
+      return true;
+    }
+    default:
+      break;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    char cmd[TerminalState::k_inputSize];
+    strlcpy(cmd, st.input, sizeof(cmd));
+    st.inputLength = 0;
+    st.input[0] = 0;
+    st.historyPos = -1;
+    if (st.mode == Mode::Password) {
+      int typed = st.passwordLength;
+      st.passwordLength = 0;
+      char line[64];
+      fmt(line, sizeof(line), "[sudo] Mot de passe de %s : ", userName());
+      print(line);
+      if (typed == 0) {
+        print("Désolé, essayez de nouveau.");
+      } else {
+        st.mode = Mode::Shell;
+        st.sudoUntil = now() + 5 * 60 * 1000;
+        char pending[TerminalState::k_inputSize];
+        strlcpy(pending, st.pending, sizeof(pending));
+        runAsRoot(pending);
+      }
+      invalidate(c);
+      return true;
+    }
+    if (st.mode == Mode::Bc) {
+      print(cmd);
+      if (is(cmd, "quit") || is(cmd, "exit")) {
+        st.mode = Mode::Shell;
+      } else if (cmd[0]) {
+        evaluate(cmd);
+      }
+      invalidate(c);
+      return true;
+    }
+    echoCommand(cmd);
+    pushHistory(cmd);
+    invalidate(c);
+    run(cmd, false, c);
+    return true;
+  }
+  if (e == Events::Backspace) {
+    if (st.mode == Mode::Password) {
+      if (st.passwordLength > 0) {
+        st.passwordLength--;
+      }
+    } else if (st.inputLength > 0) {
+      // Remove a whole UTF-8 character
+      int n = st.inputLength - 1;
+      while (n > 0 && (static_cast<uint8_t>(st.input[n]) & 0xC0) == 0x80) {
+        n--;
+      }
+      st.inputLength = n;
+      st.input[n] = 0;
+    }
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::Clear) {
+    if (st.mode == Mode::Password || st.mode == Mode::Bc) {
+      print("^C");
+      st.mode = Mode::Shell;
+    }
+    st.inputLength = 0;
+    st.input[0] = 0;
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::Up || e == Events::Down) {
+    if (st.historyCount == 0) {
+      return true;
+    }
+    int pos = st.historyPos + (e == Events::Up ? 1 : -1);
+    if (pos >= st.historyCount) {
+      pos = st.historyCount - 1;
+    }
+    if (pos < 0) {
+      st.historyPos = -1;
+      st.input[0] = 0;
+      st.inputLength = 0;
+    } else {
+      st.historyPos = pos;
+      strlcpy(st.input, st.history[pos], sizeof(st.input));
+      st.inputLength = strlen(st.input);
+    }
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    if (st.mode == Mode::Shell) {
+      complete();
+      invalidate(c);
+    }
+    return true;
+  }
+  const char* txt = e.text();
+  if (txt != nullptr && txt[0] != 0) {
+    if (st.mode == Mode::Password) {
+      if (st.passwordLength < 32) {
+        st.passwordLength++;
+      }
+      invalidate(c);
+      return true;
+    }
+    // Only plain characters: functions like "sin(" are typed letter by letter
+    int len = strlen(txt);
+    bool plain = true;
+    for (const char* p = txt; *p; p++) {
+      plain = plain && static_cast<uint8_t>(*p) != 0x11;
+    }
+    if (plain && st.inputLength + len < TerminalState::k_inputSize - 1) {
+      memcpy(st.input + st.inputLength, txt, len);
+      st.inputLength += len;
+      st.input[st.inputLength] = 0;
+    }
+    invalidate(c);
+    return true;
+  }
+  return false;
+}
