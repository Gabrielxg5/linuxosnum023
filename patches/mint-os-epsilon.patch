+constexpr KDColor k_cyan = KDColor::RGB24(0x34E2E2);
+constexpr KDColor k_dim = KDColor::RGB24(0x888A85);
+constexpr KDColor k_white = KDColor::RGB24(0xFFFFFF);
+
+enum Anim : uint8_t {
+  AnimNone,
+  AnimSl,
+  AnimMatrix,
+  AnimYes,
+  JobAptUpdate,
+  JobAptInstall,
+  JobAptRemove,
+  JobAptUpgrade,
+  JobRmRf,
