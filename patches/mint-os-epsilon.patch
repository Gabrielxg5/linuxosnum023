+char lower(char c) { return (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c; }
+
+bool matches(const char* label, const char* query, int length) {
+  if (length == 0) {
+    return true;
+  }
+  for (const char* p = label; *p; p++) {
+    int k = 0;
+    while (k < length && p[k] && lower(p[k]) == lower(query[k])) {
+      k++;
+    }
+    if (k == length) {
+      return true;
+    }
+  }
+  return false;
+}
