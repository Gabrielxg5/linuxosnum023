+bool isFavorite(Item it) {
+  if (it.kind == Item::Kind::Window) {
+    WindowApp a = static_cast<WindowApp>(it.index);
+    return a == WindowApp::Terminal || a == WindowApp::Files ||
+           a == WindowApp::Software || a == WindowApp::Settings;
+  }
+  return it.kind == Item::Kind::Builtin &&
+         it == builtinNamed(I18n::Message::CalculApp);
