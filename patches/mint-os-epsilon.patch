+namespace Home {
+namespace Mint {
+
+/* Something to start from the desktop: a calculator app, one of the Mint-OS
+ * window apps, an external app (.nwa game) or a menu action. */
+struct Item {
+  enum class Kind : uint8_t { None, Builtin, Window, External, Action };
+  Kind kind;
+  int16_t index;  // app index in AppsContainer, WindowApp, external, Action
+  bool operator==(const Item& o) const {
+    return kind == o.kind && index == o.index;
+  }
+  bool isNone() const { return kind == Kind::None; }
+};
+
+constexpr Item k_noItem = {Item::Kind::None, 0};
+
+/* The Mint-OS desktop (Cinnamon-like). All its state is static: it survives
+ * leaving the home app to run a calculator app or a game. */
+namespace Shell {
+
+// The home app became active: refresh the list of apps and games
+void enter();
+// The home app is going away
+void leave();
+// Returns true if the event was used
+bool handleEvent(Ion::Events::Event event);
+// Called every Escher tick (300 ms). Returns true to redraw.
+bool tick();
+// Animation period in ms (0: nothing is animated, wait for events)
+int framePeriod();
+// One animation step. Returns true to redraw.
+bool frame();
+// Draws everything that intersects the band
+void render(Band& band);
+// An app to open, set by handleEvent; the caller opens it right away
+Item takeLaunch();
