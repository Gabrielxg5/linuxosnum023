+  for (int i = 0; i < n; i++) {
+    Rect r = segmentRect(c, n, i, width);
+    fill(b, r, i == selected ? p.accent : p.button);
+    text(b, labels[i], r.x + r.w / 2, r.y + 2,
+         i == selected ? KDWhite : p.winText, Small, Align::Center, r.w - 2);
+  }
+  Rect all = {segmentRect(c, n, 0, width).x, c.y + 4, n * width, 18};
+  roundFrame(b, all, 2, p.border, 160);
