+  KDColor ink = rgb(0xCCCCCC);
+  constexpr const char* k_lines[] = {
+      "[ 1337.000042] Kernel panic - not syncing:",
+      "Attempted to kill init! exitcode=0x00009",
+      "CPU: 0 PID: 1 Comm: systemd Not tainted",
+      "6.8.0-numworks #1 SMP PREEMPT_DYNAMIC",
+      "Hardware name: NumWorks n0120/STM32F730",
+      "Call Trace:",
+      " <TASK>",
+      " dump_stack_lvl+0x48/0x70",
+      " panic+0x1337/0x2a0",
+      " do_exit.cold+0x15/0x15",
+      " sudo_rm_rf_slash+0x42/0x42",
+      " </TASK>",
+      "---[ end Kernel panic - not syncing ]---",
+  };
+  int n = sizeof(k_lines) / sizeof(k_lines[0]);
+  uint32_t t = now() - s.modeStart;
+  int shown = static_cast<int>(t / 60) + 1;
+  for (int i = 0; i < n && i < shown; i++) {
+    text(b, k_lines[i], 2, 2 + i * 15, ink, Small, Align::Left, 318);
+  }
+  if (t > 3200) {
+    text(b, "Redémarrage... (rien n'a été effacé)", 2, 212, rgb(0x55FF55));
+  }
+}
