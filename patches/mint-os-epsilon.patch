+enum class HitType : uint8_t {
+  None,
+  Desktop,
+  DesktopIcon,
+  MenuButton,
+  TaskItem,
+  Workspace,
+  TrayUpdates,
+  TrayNetwork,
+  TraySound,
+  TrayPower,
+  Clock,
+  ShowDesktop,
+  Panel,
+  MenuPanel,
+  MenuSearch,
+  MenuCategory,
+  MenuItem,
+  MenuFavorite,
+  MenuSession,
+  MenuScrollUp,
+  MenuScrollDown,
+  Popup,
+  PopupSlider,
+  PopupButton,
+  ContextPanel,
+  ContextItem,
+  DialogPanel,
+  DialogButton,
+  Notification,
+  WindowTitle,
+  WindowMinimize,
+  WindowMaximize,
+  WindowClose,
+  WindowClient,
+};
+
+struct Hit {
+  HitType type;
+  int8_t index;
+  int16_t value;
+  uint32_t key() const {
+    return (static_cast<uint32_t>(type) << 16) |
+           (static_cast<uint8_t>(index) << 8);
+  }
+};
