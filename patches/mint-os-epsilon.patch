+bool createScript(char* name, int size) {
+  using Ion::Storage::FileSystem;
+  FileSystem* fs = FileSystem::sharedFileSystem;
+  for (int i = 1; i < 100; i++) {
+    fmt(name, size, "script%d", i);
+    char full[24];
+    fmt(full, sizeof(full), "%s.py", name);
+    if (!fs->hasRecord(fs->recordNamed(full))) {
+      constexpr char k_content[] = "\x01from math import *\n";
+      return fs->createRecordWithExtension(name, "py", k_content,
+                                           sizeof(k_content)) ==
+             Ion::Storage::Record::ErrorStatus::None;
+    }
+  }
+  return false;
+}
