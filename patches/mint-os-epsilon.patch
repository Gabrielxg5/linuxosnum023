+/* All the items of the menu: calculator apps, Mint apps, games, then
+ * XPenguins. Games that are not installed are left out. */
+int numberOfAllItems() {
+  int n = s_numberOfBuiltin + s_numberOfGames;
+  for (int i = 0; i < k_numberOfWindowApps; i++) {
+    n += windowAppAvailable(static_cast<WindowApp>(i)) ? 1 : 0;
+  }
+  n += isInstalled(Package::XPenguins) ? 1 : 0;
+  return n;
+}
+
+Item allItemAtIndex(int i) {
+  if (i < s_numberOfBuiltin) {
+    return {Item::Kind::Builtin, s_builtin[i]};
+  }
+  i -= s_numberOfBuiltin;
+  for (int a = 0; a < k_numberOfWindowApps; a++) {
+    if (windowAppAvailable(static_cast<WindowApp>(a)) && i-- == 0) {
+      return windowItem(static_cast<WindowApp>(a));
+    }
+  }
+  if (i < s_numberOfGames) {
+    return {Item::Kind::External, static_cast<int16_t>(i)};
+  }
+  return actionItem(Action::XPenguins);
+}
+
+bool itemByName(const char* name, Item* result) {
+  int total = numberOfAllItems();
+  int len = strlen(name);
+  if (len == 0) {
+    return false;
+  }
+  for (int i = 0; i < total; i++) {
+    Item it = allItemAtIndex(i);
+    const char* label = itemLabel(it);
+    int k = 0;
+    while (k < len && label[k] && lower(label[k]) == lower(name[k])) {
+      k++;
+    }
+    if (k == len) {
+      *result = it;
+      return true;
+    }
+  }
+  return false;
+}
