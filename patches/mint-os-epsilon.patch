+}  // namespace
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    // Let the container update the shift / alpha state
+    return false;
+  }
+  switch (s.mode) {
+    case Mode::Grub:
+      if (e == Events::Up || e == Events::Down) {
+        s.grubSelection = (s.grubSelection + (e == Events::Up ? 4 : 1)) % 5;
+        // Like GRUB, touching a key stops the countdown
+        s.modeStart = 0;
+        invalidateAll();
+      } else if (e == Events::OK || e == Events::EXE) {
+        bootSelected();
+      }
+      return true;
+    case Mode::GrubMessage:
+      setMode(Mode::Grub);
+      s.modeStart = 0;
+      return true;
+    case Mode::Memtest:
+      if (e == Events::Back || e == Events::Home || e == Events::OK ||
+          e == Events::EXE) {
+        reboot();
+      }
+      return true;
+    case Mode::Splash:
+      if (e == Events::Toolbox || e == Events::Back || e == Events::Home) {
+        // Esc in Plymouth shows the boot messages
+        s.bootLog = !s.bootLog;
+        invalidateAll();
+      }
+      return true;
+    case Mode::Login:
+    case Mode::Lock:
+      return typePassword(e);
+    case Mode::Destroying:
+    case Mode::Panic:
+      return true;
+    default:
+      break;
+  }
+  int top = s.numberOfWindows - 1;
+  if (s.menu == Menu::AltTab) {
+    if (e == Events::XNT) {
+      altTab();
+    } else if (e == Events::Back || e == Events::Home) {
+      closeMenu();
+    } else {
+      finishAltTab();
+    }
+    return true;
+  }
+  // Keys go to the focused window app
+  if (s.keyboardFocus && top >= 0 && windowVisible(top) &&
+      s.menu == Menu::None) {
+    if (e == Events::Back || e == Events::Home) {
+      releaseKeyboard();
+      return true;
+    }
+    Apps::handleKey(s.windows[top].app, e, clientRect(top));
+    return true;
+  }
+  s.keyboardFocus = false;
+  // Typing in the menu search box
+  if (s.menu == Menu::Main) {
+    if (e == Events::Backspace) {
+      if (s.searchLength > 0) {
+        s.search[--s.searchLength] = 0;
+        s.menuScroll = 0;
+        invalidate(k_menuRect);
+      }
+      return true;
+    }
+    if (e == Events::EXE || (e == Events::OK && s.searchLength > 0 &&
+                             hitTest(s.cursorX, s.cursorY).type !=
+                                 HitType::MenuItem)) {
+      Item it = menuItemAt(0);
+      if (!it.isNone() && s.searchLength > 0) {
+        closeMenu();
+        openItem(it);
+        return true;
+      }
+    }
+    const char* t = e.text();
+    if (t != nullptr && t[0] >= ' ' && t[0] < 127 && t[1] == 0 &&
+        s.searchLength < k_maxSearch) {
+      s.search[s.searchLength++] = t[0];
+      s.search[s.searchLength] = 0;
+      s.menuScroll = 0;
+      invalidate(k_menuRect);
+      return true;
+    }
+  }
+  if (e == Events::Back || e == Events::Home) {
+    if (s.dragging) {
+      s.dragging = false;
+      if (top >= 0) {
+        invalidate(windowRect(top).inset(-2));
+      }
+    } else if (s.menu == Menu::Dialog && s.dialog == Dialog::Crash) {
+      // The fallback mode stays until Cinnamon is restarted
+    } else if (s.menu != Menu::None) {
+      closeMenu();
+    } else if (s.crashed) {
+      openDialog(Dialog::Crash);
+    } else {
+      /* On the calculator, Home comes back here as Back (the kernel jumps to
+       * the Home checkpoint): both open the menu, like the Super key. */
+      openMainMenu();
+    }
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right || e == Events::Up ||
+      e == Events::Down) {
+    int dx = e == Events::Left ? -1 : (e == Events::Right ? 1 : 0);
+    int dy = e == Events::Up ? -1 : (e == Events::Down ? 1 : 0);
+    moveCursor(dx, dy);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (s.dragging) {
+      s.dragging = false;
+      if (top >= 0) {
+        invalidate(windowRect(top).inset(-2));
+      }
+      return true;
+    }
+    click(false);
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    if (!s.dragging) {
+      click(true);
+    }
+    return true;
+  }
+  if (e == Events::Var) {
+    // The Super key
+    if (s.crashed) {
+      openDialog(Dialog::Crash);
+    } else if (s.menu == Menu::Main) {
+      closeMenu();
+    } else {
+      openMainMenu();
+    }
+    return true;
+  }
+  if (e == Events::XNT) {
+    // Alt+Tab
+    altTab();
+    return true;
+  }
+  // Other keys are swallowed so that they do not leave the desktop
+  return true;
+}
+
+bool tick() {
+  s.ticks++;
+  bool redraw = false;
+  uint32_t t = now();
+  switch (s.mode) {
+    case Mode::Grub:
+      if (s.modeStart != 0) {
+        if (t - s.modeStart >= k_grubTimeout) {
+          bootSelected();
+        }
+        invalidate({0, 190, k_screenWidth, 40});
+        redraw = true;
+      }
+      return redraw;
+    case Mode::Login:
+    case Mode::Lock:
+      invalidateAll();
+      if (s.mode == Mode::Lock && s.ticks % 3 == 0) {
+        invalidateAll();
+      }
+      return true;
+    case Mode::Desktop:
+      break;
+    default:
+      return false;
+  }
+  // Desktop: system monitor samples, apps, clock, battery, notifications
+  SysMonitorState& m = s.sysmon;
+  int load = 4 + Ion::random() % 9;
+  if (s.penguinsOn) {
+    load += 18;
+  }
+  if (Term::animating()) {
+    load += 35;
+  }
+  load += s.numberOfWindows * 3;
+  m.cpu[m.cpuHead] = load > 100 ? 100 : load;
+  m.cpuHead = (m.cpuHead + 1) % SysMonitorState::k_samples;
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    bool focused = i == s.numberOfWindows - 1 && s.keyboardFocus &&
+                   s.menu == Menu::None && windowVisible(i);
+    if (Apps::tick(s.windows[i].app, focused, clientRect(i))) {
+      redraw = true;
+    }
+  }
+  uint16_t minute = static_cast<uint16_t>(totalMinutes());
+  if (minute != s.lastClockMinute) {
+    s.lastClockMinute = minute;
+    invalidate(k_clock);
+    redraw = true;
+  }
+  if (s.notification.until && static_cast<int32_t>(t - s.notification.until) > 0) {
+    s.notification.until = 0;
+    invalidate(k_notification.inset(-6));
+    redraw = true;
+  }
+  if (s.menu == Menu::AltTab && static_cast<int32_t>(t - s.altTabUntil) > 0) {
+    finishAltTab();
+    redraw = true;
+  }
+  if (s.ticks % 10 == 0) {
+    int pc = batteryPercent();
+    if (pc != s.lastBatteryPercent) {
+      s.lastBatteryPercent = pc;
+      invalidate(k_trayPower);
+      redraw = true;
+    }
+  }
+  return redraw;
+}
+
+int framePeriod() {
+  switch (s.mode) {
+    case Mode::Splash:
+    case Mode::Destroying:
+    case Mode::Panic:
+    case Mode::Memtest:
+      return 40;
+    case Mode::Desktop:
+      break;
+    default:
+      return 0;
+  }
+  if (s.penguinsOn) {
+    return 50;
+  }
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    if (Apps::animating(s.windows[i].app)) {
+      return 40;
+    }
+  }
+  return 0;
+}
+
+bool frame() {
+  uint32_t t = now() - s.modeStart;
+  switch (s.mode) {
+    case Mode::Splash: {
+      uint32_t duration = s.bootLog ? 14 * k_bootLogStep + 500 : k_splashDuration;
+      if (t >= duration) {
+        setMode(Mode::Login);
+      } else {
+        invalidateAll();
+      }
+      return true;
+    }
+    case Mode::Memtest:
+      invalidate({0, 60, k_screenWidth, 120});
+      return true;
+    case Mode::Destroying: {
+      // The terminal keeps printing what it removes
+      for (int i = 0; i < s.numberOfWindows; i++) {
+        if (s.windows[i].app == WindowApp::Terminal) {
+          Apps::frame(WindowApp::Terminal, clientRect(i));
+        }
+      }
+      if (t >= k_destroyDuration) {
+        setMode(Mode::Panic);
+      } else {
+        invalidateAll();
+      }
+      return true;
+    }
+    case Mode::Panic:
+      if (t >= k_panicDuration) {
+        reboot();
+      } else {
+        invalidateAll();
+      }
+      return true;
+    case Mode::Desktop:
+      break;
+    default:
+      return false;
+  }
+  bool redraw = false;
+  if (s.penguinsOn) {
+    stepPenguins();
+    redraw = true;
+  }
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    if (Apps::animating(s.windows[i].app)) {
+      Apps::frame(s.windows[i].app, clientRect(i));
+      redraw = true;
+    }
+  }
+  return redraw;
+}
+
+void render(Band& b) {
+  switch (s.mode) {
+    case Mode::Grub:
+      drawGrub(b);
+      break;
+    case Mode::GrubMessage:
+      drawGrubMessage(b);
+      break;
+    case Mode::Memtest:
+      drawMemtest(b);
+      break;
+    case Mode::Splash:
+      drawSplash(b);
+      break;
+    case Mode::Login:
+      drawLogin(b);
+      break;
+    case Mode::Lock:
+      drawLock(b);
+      break;
+    case Mode::Destroying:
+      drawDestruction(b);
+      break;
+    case Mode::Panic:
+      drawPanic(b);
+      break;
+    default: {
+      wallpaper(b);
+      drawDesktopIcons(b);
+      for (int i = 0; i < s.numberOfWindows; i++) {
+        if (windowVisible(i)) {
+          drawWindow(b, i);
+        }
+      }
+      if (s.penguinsOn) {
+        for (int i = 0; i < k_maxPenguins; i++) {
+          const Penguin& p = s.penguins[i];
+          penguin(b, p.frame, p.x, p.y, p.left);
+        }
+      }
+      drawPanel(b);
+      drawNotification(b);
+      switch (s.menu) {
+        case Menu::Main:
+          drawMainMenu(b);
+          break;
+        case Menu::Calendar:
+          drawCalendar(b);
+          break;
+        case Menu::Sound:
+          drawSoundPopup(b);
+          break;
+        case Menu::Power:
+          drawPowerPopup(b);
+          break;
+        case Menu::Network:
+          drawNetworkPopup(b);
+          break;
+        case Menu::Context:
+          drawContextMenu(b);
+          break;
+        case Menu::AltTab:
+          drawAltTab(b);
+          break;
+        case Menu::Dialog:
+          drawDialog(b);
+          break;
+        default:
+          break;
+      }
+      bool busy = s.software.installing >= 0 || s.updates.phase == 1;
+      pointer(b, s.cursorX, s.cursorY, busy && s.menu == Menu::None &&
+                                           (now() / 400) % 3 == 0);
+      break;
+    }
+  }
+  if (s.night) {
+    warmFilter(b);
+  }
+}
