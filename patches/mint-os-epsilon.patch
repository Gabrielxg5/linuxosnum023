+const PackageInfo& packageInfo(Package p) {
+  return k_packages[static_cast<int>(p)];
+}
+
+bool isInstalled(Package p) {
+  return (s.installed >> static_cast<int>(p)) & 1;
+}
+
+void setInstalled(Package p, bool installed) {
+  uint16_t bit = 1 << static_cast<int>(p);
+  s.installed = installed ? (s.installed | bit) : (s.installed & ~bit);
+  if (!installed) {
+    // Close the game if it was running
+    WindowApp app = WindowApp::NumberOfWindowApps;
+    if (p == Package::Snake) {
+      app = WindowApp::Snake;
+    } else if (p == Package::Game2048) {
+      app = WindowApp::Game2048;
+    } else if (p == Package::Mines) {
+      app = WindowApp::Mines;
+    } else if (p == Package::XPenguins && s.penguinsOn) {
+      togglePenguins();
+    }
+    int w = app == WindowApp::NumberOfWindowApps ? -1 : windowIndexOf(app);
+    if (w >= 0) {
+      closeWindow(w);
+    }
+  }
+}
+
+bool packageNamed(const char* apt, Package* result) {
+  for (int i = 0; i < k_numberOfPackages; i++) {
+    const PackageInfo& info = k_packages[i];
+    if (strcmp(apt, info.apt) == 0 || strcmp(apt, info.title) == 0 ||
+        (i == static_cast<int>(Package::Fortune) && strcmp(apt, "fortune") == 0)) {
+      *result = static_cast<Package>(i);
+      return true;
+    }
+  }
+  return false;
+}
