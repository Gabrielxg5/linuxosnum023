+      return Software::draw(b, client, focused);
+    case WindowApp::Settings:
+      return Settings::draw(b, client, focused);
+    case WindowApp::Welcome:
+      return Welcome::draw(b, client, focused);
+    case WindowApp::Snake:
+      return SnakeGame::draw(b, client, focused);
+    case WindowApp::Game2048:
+      return G2048::draw(b, client, focused);
+    case WindowApp::Mines:
+      return Mines::draw(b, client, focused);
+    default:
+      return;
+  }
+}
+
+bool handleKey(WindowApp app, Event e, Rect client) {
+  switch (app) {
+    case WindowApp::Terminal:
+      return Term::handleKey(e, client);
+    case WindowApp::Files:
+      return Files::handleKey(e, client);
+    case WindowApp::SysMonitor:
+      return SysMonitor::handleKey(e, client);
+    case WindowApp::Updates:
+      return Updates::handleKey(e, client);
+    case WindowApp::Software:
+      return Software::handleKey(e, client);
+    case WindowApp::Settings:
+      return Settings::handleKey(e, client);
+    case WindowApp::Snake:
+      return SnakeGame::handleKey(e, client);
+    case WindowApp::Game2048:
+      return G2048::handleKey(e, client);
+    case WindowApp::Mines:
+      return Mines::handleKey(e, client);
+    default:
+      return false;
+  }
+}
+
+void click(WindowApp app, int x, int y, bool right, Rect client) {
+  switch (app) {
+    case WindowApp::Files:
+      return Files::click(x, y, right, client);
+    case WindowApp::SysMonitor:
+      return SysMonitor::click(x, y, right, client);
+    case WindowApp::Updates:
+      return Updates::click(x, y, right, client);
+    case WindowApp::Software:
+      return Software::click(x, y, right, client);
+    case WindowApp::Settings:
+      return Settings::click(x, y, right, client);
+    case WindowApp::Welcome:
+      return Welcome::click(x, y, right, client);
+    case WindowApp::Mines:
+      return Mines::click(x, y, right, client);
+    case WindowApp::Snake:
+    case WindowApp::Game2048:
+    case WindowApp::Terminal:
+      // The click gives the keyboard to the app; redraw its hint
+      invalidate(client);
+      return;
+    default:
+      return;
+  }
+}
+
+bool tick(WindowApp app, bool focused, Rect client) {
+  switch (app) {
+    case WindowApp::Snake:
+      return SnakeGame::tick(focused, client);
+    case WindowApp::Mines:
+      return Mines::tick(client);
+    case WindowApp::SysMonitor:
+      return SysMonitor::tick(client);
+    case WindowApp::Updates:
+      return Updates::tick(client);
+    case WindowApp::Software:
+      return Software::tick(client);
+    default:
+      return false;
+  }
+}
+
+bool animating(WindowApp app) {
+  return app == WindowApp::Terminal && Term::animating();
+}
+
+void frame(WindowApp app, Rect client) {
+  if (app == WindowApp::Terminal) {
+    Term::frame(client);
+  }
+}
+
+void fileAction(ContextAction action) {
+  int w = windowIndexOf(WindowApp::Files);
+  if (w < 0) {
+    return;
+  }
+  Rect c = clientRect(w);
+  if (action == ContextAction::FileOpen) {
+    Files::openSelected(c);
+  } else {
+    // Asks for a confirmation in the status bar first
+    s.files.confirmDelete = false;
+    Files::deleteSelected(c);
+  }
+}
+
+}  // namespace Apps
+}  // namespace Mint
+}  // namespace Home
diff --git a/epsilon/apps/home/mint/calc.cpp b/epsilon/apps/home/mint/calc.cpp
new file mode 100644
index 0000000000..e0df684647
--- /dev/null
+++ b/epsilon/apps/home/mint/calc.cpp
@@ -0,0 +1,40 @@
+#include "calc.h"
+
+#include <string.h>
+
+namespace Home {
+namespace Mint {
+namespace Calc {
+
+namespace {
+char s_inputs[k_capacity][k_textSize];
+char s_outputs[k_capacity][k_textSize];
+uint8_t s_count = 0;
+uint8_t s_stored = 0;
+}  // namespace
+
+void push(const char* input, const char* output) {
+  int slot = s_count % k_capacity;
+  strlcpy(s_inputs[slot], input, k_textSize);
+  strlcpy(s_outputs[slot], output, k_textSize);
+  s_count++;
+  if (s_stored < k_capacity) {
+    s_stored++;
+  }
+}
+
+uint8_t count() { return s_count; }
+
+bool at(int i, const char** input, const char** output) {
+  if (i < 0 || i >= s_stored) {
+    return false;
+  }
+  int slot = (s_count - 1 - i + 256 * k_capacity) % k_capacity;
+  *input = s_inputs[slot];
+  *output = s_outputs[slot];
+  return true;
+}
+
+}  // namespace Calc
+}  // namespace Mint
+}  // namespace Home
