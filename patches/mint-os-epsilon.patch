+int menuItemCount();
+Item menuItemAt(int index);
+
+bool menuFilter(Item it) {
+  if (s.searchLength > 0) {
+    return matches(itemLabel(it), s.search, s.searchLength);
+  }
+  if (s.category == 0) {
+    return true;
+  }
+  if (s.category == 1) {
+    return isFavorite(it);
+  }
+  return itemCategory(it) == s.category;
+}
+
+int menuItemCount() {
+  int n = 0;
+  int total = numberOfAllItems();
+  for (int i = 0; i < total; i++) {
+    n += menuFilter(allItemAtIndex(i)) ? 1 : 0;
+  }
+  return n;
+}
+
+Item menuItemAt(int index) {
+  int total = numberOfAllItems();
+  for (int i = 0; i < total; i++) {
+    Item it = allItemAtIndex(i);
+    if (menuFilter(it) && index-- == 0) {
+      return it;
+    }
+  }
+  return k_noItem;
+}
