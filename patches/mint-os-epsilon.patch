+Item favoriteAt(int i) {
+  constexpr WindowApp k_favorites[k_numberOfFavorites] = {
+      WindowApp::Software, WindowApp::Settings, WindowApp::Terminal,
+      WindowApp::Files};
+  return windowItem(k_favorites[i]);
+}
+
+// Panel: pinned items, then open windows of this workspace not pinned
+int taskItems(Item* items) {
+  int n = 0;
+  for (int i = 0; i < s.numberOfPanelPins && n < k_maxTaskItems; i++) {
+    items[n++] = s.panelPins[i];
+  }
+  for (int w = 0; w < s.numberOfWindows && n < k_maxTaskItems; w++) {
+    if (s.windows[w].workspace != s.workspace) {
+      continue;
+    }
+    Item it = windowItem(s.windows[w].app);
+    bool found = false;
+    for (int i = 0; i < n; i++) {
+      found = found || items[i] == it;
+    }
+    if (!found) {
+      items[n++] = it;
+    }
+  }
+  return n;
+}
+
+bool isPinned(Item item) {
+  for (int i = 0; i < s.numberOfPanelPins; i++) {
+    if (s.panelPins[i] == item) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void pin(Item item) {
+  if (isPinned(item) || s.numberOfPanelPins >= k_maxPanelPins) {
+    return;
+  }
+  s.panelPins[s.numberOfPanelPins++] = item;
+}
+
+void unpin(Item item) {
+  for (int i = 0; i < s.numberOfPanelPins; i++) {
+    if (s.panelPins[i] == item) {
+      for (int j = i; j + 1 < s.numberOfPanelPins; j++) {
+        s.panelPins[j] = s.panelPins[j + 1];
+      }
+      s.numberOfPanelPins--;
+      return;
+    }
+  }
+}
