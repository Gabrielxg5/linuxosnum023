+void cal() {
+  char date[48];
+  dateText(date, sizeof(date), false);
+  int d = (date[0] - '0') * 10 + (date[1] - '0');
+  int m = (date[3] - '0') * 10 + (date[4] - '0');
+  int y = (date[6] - '0') * 1000 + (date[7] - '0') * 100 +
+          (date[8] - '0') * 10 + (date[9] - '0');
+  constexpr const char* k_months[12] = {
+      "janvier", "février", "mars",      "avril",   "mai",      "juin",
+      "juillet", "août",    "septembre", "octobre", "novembre", "décembre"};
+  char line[48];
+  fmt(line, sizeof(line), "    %s %d", k_months[m - 1], y);
+  print(line);
+  print("lu ma me je ve sa di");
+  // Day of the week of the 1st (Monday = 0), Zeller-like
+  int yy = m < 3 ? y - 1 : y;
+  int mm = m < 3 ? m + 12 : m;
+  int h = (1 + 13 * (mm + 1) / 5 + yy + yy / 4 - yy / 100 + yy / 400) % 7;
+  int col = (h + 5) % 7;
+  constexpr int k_lengths[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  int length = k_lengths[m - 1];
+  if (m == 2 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0)) {
+    length = 29;
+  }
+  char row[32];
+  int k = 0;
+  for (int i = 0; i < col; i++) {
+    row[k++] = ' ';
+    row[k++] = ' ';
+    row[k++] = ' ';
+  }
+  for (int day = 1; day <= length; day++) {
+    if (day == d) {
+      row[k++] = '[';
+    } else {
+      row[k++] = day < 10 ? ' ' : '0' + day / 10;
+    }
+    if (day == d && day >= 10) {
+      row[k++] = '0' + day / 10;
+    }
+    row[k++] = '0' + day % 10;
+    row[k++] = day == d ? ']' : ' ';
+    if (++col == 7 || day == length) {
+      row[k] = 0;
+      print(row);
+      k = 0;
+      col = 0;
+    }
+  }
+}
