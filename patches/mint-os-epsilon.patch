+void clockText(char* buffer) {
+  int minutes = totalMinutes() % (24 * 60);
+  if (minutes < 0) {
+    minutes += 24 * 60;
+  }
+  int h = minutes / 60, m = minutes % 60;
+  buffer[0] = '0' + h / 10;
+  buffer[1] = '0' + h % 10;
+  buffer[2] = ':';
+  buffer[3] = '0' + m / 10;
+  buffer[4] = '0' + m % 10;
+  buffer[5] = 0;
+}
