+void scroll() {
+  TerminalState& st = t();
+  for (int i = 0; i + 1 < TerminalState::k_lines; i++) {
+    memcpy(st.lines[i], st.lines[i + 1], sizeof(st.lines[i]));
+    st.style[i] = st.style[i + 1];
+  }
+}
+
+// Number of bytes of s that fit in n columns (UTF-8 aware)
+int fit(const char* s, int columns) {
+  int bytes = 0, cols = 0;
+  while (s[bytes] && cols < columns) {
+    bytes++;
+    while ((static_cast<uint8_t>(s[bytes]) & 0xC0) == 0x80) {
+      bytes++;
+    }
+    cols++;
+  }
+  return bytes;
+}
+
+int columnsOf(const char* s) {
+  int n = 0;
+  for (; *s; s++) {
+    n += (static_cast<uint8_t>(*s) & 0xC0) != 0x80 ? 1 : 0;
+  }
+  return n;
+}
+
+void printLines(const char* text, uint8_t style) {
+  // Splits on \n
+  while (true) {
+    const char* nl = strchr(text, '\n');
+    char line[128];
+    int n = nl ? nl - text : strlen(text);
+    if (n > static_cast<int>(sizeof(line)) - 1) {
+      n = sizeof(line) - 1;
+    }
+    memcpy(line, text, n);
+    line[n] = 0;
+    // Tabs become spaces
+    for (int i = 0; i < n; i++) {
+      if (line[i] == '\t') {
+        line[i] = ' ';
+      }
+    }
+    print(line, style);
+    if (!nl) {
+      return;
+    }
+    text = nl + 1;
+  }
+}
+
+template <typename... A>
+void out(uint8_t style, const char* f, A... args) {
+  char line[128];
+  fmt(line, sizeof(line), f, args...);
+  printLines(line, style);
+}
