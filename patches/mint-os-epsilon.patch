+void drawPrompt(Band& b, const char* line, int x, int y, bool root) {
+  // user@host in green (red for root), the path in blue, the rest white
+  const char* at = strchr(line, ':');
+  const char* end = findText(line, root ? "# " : "$ ");
+  if (!at || !end || end < at) {
+    text(b, line, x, y, k_fore);
+    return;
+  }
+  char part[64];
+  int n = at - line;
+  memcpy(part, line, n);
+  part[n] = 0;
+  text(b, part, x, y, root ? k_red : k_green);
+  x += columnsOf(part) * glyphWidth();
+  text(b, ":", x, y, k_fore);
+  x += glyphWidth();
+  n = end - at - 1;
+  memcpy(part, at + 1, n);
+  part[n] = 0;
+  text(b, part, x, y, k_blue);
+  x += columnsOf(part) * glyphWidth();
+  text(b, root ? "# " : "$ ", x, y, k_fore);
+  x += 2 * glyphWidth();
+  text(b, end + 2, x, y, k_white);
+}
