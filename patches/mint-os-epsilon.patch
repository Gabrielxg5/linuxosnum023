+void click(int x, int y, bool right, Rect c) {
+  SettingsState& st = s.settings;
+  int ax = c.x + x, ay = c.y + y;
+  for (int i = 0; i < k_sections; i++) {
+    if (sideRect(c, i).contains(ax, ay)) {
+      st.section = i;
+      invalidate(c);
+      return;
+    }
+  }
+  switch (st.section) {
+    case 0:
+      for (int i = 0; i < 2; i++) {
+        if (modeRect(c, i).contains(ax, ay)) {
+          s.light = i == 1;
+          applyAppearance();
+          return;
+        }
+      }
+      for (int i = 0; i < k_numberOfAccents; i++) {
+        if (swatchRect(c, i).inset(-2).contains(ax, ay)) {
+          s.accent = i;
+          applyAppearance();
+          return;
+        }
+      }
+      return;
+    case 1:
+      for (int i = 0; i < k_numberOfWallpapers; i++) {
+        if (thumbRect(c, i).contains(ax, ay)) {
+          s.theme = i;
+          prepareWallpaper(i);
+          invalidateAll();
+          return;
+        }
+      }
+      return;
+    case 2: {
+      Rect sl = sliderRect(c, 26);
+      if (sl.inset(-6).contains(ax, ay)) {
+        int level = sliderValue(sl, ax) * Ion::Backlight::MaxBrightness / 1000;
+        setBrightness(level < 8 ? 8 : level);
+        invalidate(c);
+      } else if (toggleRect(c, 54).inset(-4).contains(ax, ay)) {
+        s.night = !s.night;
+        invalidateAll();
+      }
+      return;
+    }
+    case 3: {
+      Rect sl = sliderRect(c, 26);
+      if (sl.inset(-6).contains(ax, ay)) {
+        s.cursorSpeed = 1 + (sliderValue(sl, ax) * 4 + 500) / 1000;
+        invalidate(c);
+      }
+      return;
+    }
+    default:
+      return;
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  SettingsState& st = s.settings;
+  if (e == Events::Up || e == Events::Down) {
+    st.section = (st.section + (e == Events::Up ? k_sections - 1 : 1)) % k_sections;
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right) {
+    int d = e == Events::Left ? -1 : 1;
+    switch (st.section) {
+      case 0:
+        s.accent = (s.accent + d + k_numberOfAccents) % k_numberOfAccents;
+        applyAppearance();
+        break;
+      case 1:
+        s.theme = (s.theme + d + k_numberOfWallpapers) % k_numberOfWallpapers;
+        prepareWallpaper(s.theme);
+        invalidateAll();
+        break;
+      case 2: {
+        int level = brightness() + d * Ion::Backlight::MaxBrightness / 10;
+        int max = Ion::Backlight::MaxBrightness;
+        setBrightness(level < 8 ? 8 : (level > max ? max : level));
+        invalidate(c);
+        break;
+      }
+      case 3: {
+        int v = s.cursorSpeed + d;
+        s.cursorSpeed = v < 1 ? 1 : (v > 5 ? 5 : v);
+        invalidate(c);
+        break;
+      }
+      default:
+        break;
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (st.section == 0) {
+      s.light = !s.light;
+      applyAppearance();
+    } else if (st.section == 2) {
+      s.night = !s.night;
+      invalidateAll();
+    }
+    return true;
+  }
+  return false;
+}
