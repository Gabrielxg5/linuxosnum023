+void progressBar(Band& b, Rect r, int permille, KDColor color) {
+  const Palette& p = palette();
+  roundFill(b, r, r.h / 2, p.button);
+  int w = r.w * (permille < 0 ? 0 : (permille > 1000 ? 1000 : permille)) / 1000;
+  if (w > 0) {
