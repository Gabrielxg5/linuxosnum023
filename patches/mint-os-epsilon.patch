+/* The NumWorks font has no accented letters: French text is written without
+ * accents (é -> e, « » -> "), the way it is typed on the calculator. */
+void plainText(const char* in, char* out, int size) {
+  int n = 0;
+  while (*in && n < size - 1) {
+    uint8_t c = static_cast<uint8_t>(*in);
+    if (c == 0xC3 && in[1]) {
+      uint8_t d = static_cast<uint8_t>(in[1]);
+      const char* map =
+          "AAAAAAACEEEEIIII"  // C3 80..8F
+          "DNOOOOO*OUUUUYTs"  // C3 90..9F
+          "aaaaaaaceeeeiiii"  // C3 A0..AF
+          "dnooooo/ouuuuyty";  // C3 B0..BF
+      if (d >= 0x80 && d <= 0xBF) {
+        char r = map[d - 0x80];
+        if (d == 0x97) {
+          // × exists in the font: keep it
+          if (n + 2 < size) {
+            out[n++] = *in;
+            out[n++] = in[1];
+          }
+        } else {
+          out[n++] = r;
+        }
+        in += 2;
+        continue;
+      }
+    }
+    if (c == 0xC2 && (static_cast<uint8_t>(in[1]) == 0xAB ||
+                      static_cast<uint8_t>(in[1]) == 0xBB)) {
+      out[n++] = '"';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC2 && static_cast<uint8_t>(in[1]) == 0xA0) {
+      out[n++] = ' ';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC5 && (static_cast<uint8_t>(in[1]) == 0x93 ||
+                      static_cast<uint8_t>(in[1]) == 0x92)) {
+      // œ
+      out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'o' : 'O';
+      if (n < size - 1) {
+        out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'e' : 'E';
+      }
+      in += 2;
+      continue;
+    }
+    if (c == 0xE2 && static_cast<uint8_t>(in[1]) == 0x80) {
+      uint8_t d = static_cast<uint8_t>(in[2]);
+      // ’ ‘ -> ', “ ” -> ", … -> ..., – — -> -
+      char r = (d == 0x98 || d == 0x99) ? '\''
+               : (d == 0x9C || d == 0x9D) ? '"'
+               : (d == 0x93 || d == 0x94) ? '-'
+                                          : 0;
+      if (d == 0xA6) {
+        for (int k = 0; k < 3 && n < size - 1; k++) {
+          out[n++] = '.';
+        }
+        in += 3;
+        continue;
+      }
+      if (r) {
+        out[n++] = r;
+        in += 3;
+        continue;
+      }
+    }
+    out[n++] = *in++;
+  }
+  out[n] = 0;
+}
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  return KDFont::Font(font)->stringSize(plain).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth) {
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  // Cut the text so that it fits in maxWidth (and in the buffer)
+  constexpr int k_maxChars = 48;
+  char buffer[k_maxChars + 4];
+  int gw = glyphWidth(font);
+  int limit = (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  int len = strlen(s);
+  if (limit <= 0) {
+    return;
+  }
+  if (len > limit || len > k_maxChars) {
+    int keep = (limit < k_maxChars ? limit : k_maxChars) - 1;
+    if (keep < 1) {
+      keep = 1;
+    }
+    // Do not cut a UTF-8 sequence in the middle
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    // Cut like the reference ("Calcul", "Equati"), with no ellipsis
+    keep++;
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    memcpy(buffer, s, keep);
+    buffer[keep] = 0;
+    s = buffer;
+  }
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align) {
+  KDFont::Size font = KDFont::Size::Large;
+  char plain[64];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height() : k_textBufferHeight;
+  if (align == Align::Center) {
+    x -= w * scale / 2;
+  } else if (align == Align::Right) {
+    x -= w * scale;
+  }
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite, .backgroundColor = KDBlack, .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    // Bilinear sampling of the coverage, for smooth big digits
+    int fy = ((yy - y) * 256 + 128) / scale - 128;
+    int y0 = fy >> 8, ty = fy & 255;
+    if (fy < 0) {
+      y0 = 0;
+      ty = 0;
+    }
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * 256 + 128) / scale - 128;
+      int x0 = fx >> 8, tx = fx & 255;
+      if (fx < 0) {
+        x0 = 0;
+        tx = 0;
+      }
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = s_textBuffer[y0 * k_textBufferWidth + x0].green();
+      int a10 = s_textBuffer[y0 * k_textBufferWidth + x1].green();
+      int a01 = s_textBuffer[y1 * k_textBufferWidth + x0].green();
+      int a11 = s_textBuffer[y1 * k_textBufferWidth + x1].green();
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      // Sharpen the edges a little
+      a = (a - 64) * 2;
+      if (a > 0) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+void pointer(Band& b, int x, int y, bool busy) {
+  using namespace MintIcons;
+  const uint8_t* data = busy ? k_busy : k_cursor;
+  int w = busy ? k_busyWidth : k_cursorWidth;
+  int h = busy ? k_busyHeight : k_cursorHeight;
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* src = data + (yy - y) * w - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      if (src[xx] == 1) {
+        row[xx] = KDWhite;
+      } else if (src[xx] == 2) {
+        row[xx] = KDColor::RGB24(0x1A1A1A);
+      }
+    }
+  }
+}
+
+void avatar(Band& b, int x, int y) {
+  using namespace MintIcons;
+  Rect z = Rect{x, y, k_avatarSize, k_avatarSize}.intersection(b.clip());
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int offset = (yy - y) * k_avatarSize - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = k_avatarAlphas[offset + xx];
+      if (a) {
+        blendPixel(row + xx, KDColor::RGB16(k_avatarColors[offset + xx]),
+                   a == 255 ? 256 : a);
+      }
+    }
+  }
+}
+
+void penguin(Band& b, int frame, int x, int y, bool left) {
+  using namespace MintIcons;
+  constexpr int w = k_penguinWidth, h = k_penguinHeight;
+  // Drawn twice as big: 20 x 24 pixels
+  Rect z = Rect{x, y, 2 * w, 2 * h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = k_penguin + frame * w * h;
+  constexpr KDColor colors[4] = {KDBlack, KDColor::RGB24(0x151515),
+                                 KDColor::RGB24(0xF2F2F2),
+                                 KDColor::RGB24(0xF5A623)};
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int sx = (xx - x) / 2;
+      sx = left ? w - 1 - sx : sx;
+      uint8_t v = data[((yy - y) / 2) * w + sx];
+      if (v) {
+        row[xx] = colors[v];
+      }
+    }
+  }
+}
+
+void warmFilter(Band& b) {
+  const Rect& z = b.area();
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      KDColor c = row[x];
+      row[x] = KDColor::RGB888(c.red(), static_cast<uint8_t>(c.green() * 205 / 256),
+                               static_cast<uint8_t>(c.blue() * 140 / 256));
+    }
+  }
+}
+
+/* ------------------------------------------------------------- wallpaper */
+
+const char* wallpaperName(int theme) {
+  constexpr const char* k_names[k_numberOfWallpapers] = {"Wilma", "Aurore",
+                                                         "Montagnes", "Mint-X"};
+  return k_names[clampi(theme, 0, k_numberOfWallpapers - 1)];
+}
+
+void prepareWallpaper(int theme) {
+  s_theme = clampi(theme, 0, k_numberOfWallpapers - 1);
+  for (int i = 0; i < k_gradientSteps; i++) {
+    int t = i * 256 / k_gradientSteps;
+    switch (s_theme) {
+      case 0:  // Wilma: dark slate, a green ribbon of light
+        s_gradient[i] = t < 128 ? mix(0x2B3A31, 0x18201C, t * 2)
+                                : mix(0x18201C, 0x0D110F, (t - 128) * 2);
+        break;
+      case 1:  // Aurora: night sky
+        s_gradient[i] = mix(0x0B1630, 0x02040C, t);
+        break;
+      case 2:  // Mountains at dusk
+        s_gradient[i] = t < 128 ? mix(0x2B1F4A, 0x8A4A6B, t * 2)
+                                : mix(0x8A4A6B, 0xF2A65A, (t - 128) * 2);
+        break;
+      default:  // Mint-X: soft grey-green
+        s_gradient[i] = mix(0xB7C9A8, 0x6F8C5C, t);
+        break;
+    }
+  }
+  for (int x = 0; x < k_screenWidth; x++) {
+    float fx = static_cast<float>(x);
+    if (s_theme == 2) {
+      s_curveA[x] = static_cast<int16_t>(118 - 30 * sinf(fx / 41.f + 1.1f) -
+                                         12 * sinf(fx / 13.f) -
+                                         5 * sinf(fx / 5.3f));
+      s_curveB[x] = static_cast<int16_t>(152 - 22 * sinf(fx / 29.f + 2.f) -
+                                         9 * sinf(fx / 9.7f + 1.f) -
+                                         3 * sinf(fx / 3.9f));
+      s_curveC[x] = static_cast<int16_t>(178 - 14 * sinf(fx / 37.f + 0.4f) -
+                                         6 * sinf(fx / 7.1f));
+    } else {
+      s_curveA[x] = static_cast<int16_t>(150 - 0.25f * fx + 26 * sinf(fx / 46.f) +
+                                         8 * sinf(fx / 17.f));
+      s_curveB[x] = static_cast<int16_t>(96 + 30 * sinf(fx / 57.f + 1.7f) +
+                                         10 * sinf(fx / 21.f + 0.5f));
+      s_curveC[x] = static_cast<int16_t>(60 + 18 * sinf(fx / 33.f + 3.f));
+    }
+  }
+}
+
+// Soft band of half-height h around a curve: 256 on it, 0 at h pixels
+static inline int softBand(int dy, int h) {
+  if (dy < 0) {
+    dy = -dy;
+  }
+  return dy >= h ? 0 : (h - dy) * 256 / h;
+}
+
+void wallpaper(Band& b) {
+  const Rect& z = b.clip();
+  constexpr int k_logoScale = 2;
+  constexpr int k_logoSize = 52 * k_logoScale;
+  constexpr int k_logoX = (k_screenWidth - k_logoSize) / 2 + 40;
+  constexpr int k_logoY = 50;
+  const uint8_t* logo = MintIcons::k_maskMintLogoBig.data;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      KDColor c = s_gradient[x + y];
+      switch (s_theme) {
+        case 0: {
+          int a = softBand(y - s_curveA[x], 30) / 3 +
+                  softBand(y - s_curveA[x] - 6, 4) / 4;
+          if (a) {
+            c = KDColor::Blend(KDColor::RGB24(0x5FA83A), c,
+                               static_cast<uint8_t>(a > 255 ? 255 : a));
+          }
+          break;
+        }
+        case 1: {
+          int a = softBand(y - s_curveB[x], 34) * 2 / 3;
+          int a2 = softBand(y - s_curveC[x], 18) / 2;
+          if (a) {
+            int t = (y - s_curveB[x] + 34) * 255 / 68;
+            t = t < 0 ? 0 : (t > 255 ? 255 : t);
+            KDColor g = KDColor::Blend(KDColor::RGB24(0x3CE08A),
+                                       KDColor::RGB24(0x24A0C8),
+                                       static_cast<uint8_t>(t));
+            c = KDColor::Blend(g, c, static_cast<uint8_t>(a));
+          }
+          if (a2) {
+            c = KDColor::Blend(KDColor::RGB24(0x9A5CE0), c,
+                               static_cast<uint8_t>(a2));
+          }
+          uint32_t h = hash(y * 331 + x);
+          if ((h & 511) == 0 && y < 150) {
+            c = KDColor::RGB24((h >> 9) & 1 ? 0xFFFFFF : 0xBFD4FF);
+          }
+          break;
+        }
+        case 2:
+          if (y > s_curveC[x]) {
+            c = KDColor::RGB24(0x1B1426);
+          } else if (y > s_curveB[x]) {
+            c = KDColor::RGB24(0x2E2140);
+          } else if (y > s_curveA[x]) {
+            c = KDColor::RGB24(0x4B3358);
+          } else {
+            int sx = x - 230, sy = y - 104;
+            int d = sx * sx + sy * sy;
+            if (d < 15 * 15) {
+              c = KDColor::RGB24(0xFFE2A0);
+            } else if (d < 40 * 40) {
+              c = KDColor::Blend(KDColor::RGB24(0xFFC48A), c,
+                                 static_cast<uint8_t>(110 - d * 110 / 1600));
+            }
+          }
+          break;
+        default:
+          break;
+      }
+      // The Mint leaf, faint, on Wilma and Mint-X
+      if ((s_theme == 0 || s_theme == 3) && x >= k_logoX &&
+          x < k_logoX + k_logoSize && y >= k_logoY &&
+          y < k_logoY + k_logoSize) {
+        int m = logo[((y - k_logoY) / k_logoScale) * 52 +
+                     (x - k_logoX) / k_logoScale];
+        if (m) {
+          c = KDColor::Blend(s_theme == 0 ? KDColor::RGB24(0x8BCB52) : KDWhite,
+                             c,
+                             static_cast<uint8_t>(m * (s_theme == 0 ? 40 : 80) / 255));
+        }
+      }
+      row[x] = c;
+    }
+  }
+}
+
+}  // namespace Mint
+}  // namespace Home
diff --git a/epsilon/apps/home/mint/gfx.h b/epsilon/apps/home/mint/gfx.h
new file mode 100644
index 0000000000..a480c037d3
--- /dev/null
+++ b/epsilon/apps/home/mint/gfx.h
@@ -0,0 +1,103 @@
+#pragma once
+
+/* Mint-OS drawing primitives.
+ *
+ * The desktop is composed in RAM one horizontal band at a time (wallpaper,
+ * windows, panel, menus, mouse pointer) and every finished band is pushed to
+ * the LCD in one go: no flicker, and redrawing a small dirty rectangle (the
+ * pointer, a button) only costs that rectangle. */
+
+#include <ion/display.h>
+#include <ion/external_apps.h>
+#include <kandinsky/color.h>
+#include <kandinsky/font.h>
+#include <stdint.h>
+
+#include "mint_icons.h"
+
+namespace Home {
+namespace Mint {
+
+constexpr int k_screenWidth = Ion::Display::Width;
+constexpr int k_screenHeight = Ion::Display::Height;
+
+struct Rect {
+  int x, y, w, h;
+  int right() const { return x + w; }
+  int bottom() const { return y + h; }
+  bool isEmpty() const { return w <= 0 || h <= 0; }
+  bool contains(int px, int py) const {
+    return px >= x && py >= y && px < x + w && py < y + h;
+  }
+  bool intersects(const Rect& o) const {
+    return x < o.right() && o.x < right() && y < o.bottom() && o.y < bottom();
+  }
+  Rect intersection(const Rect& o) const;
+  Rect inset(int d) const { return {x + d, y + d, w - 2 * d, h - 2 * d}; }
+  Rect translated(int dx, int dy) const { return {x + dx, y + dy, w, h}; }
+};
+
+constexpr Rect k_screen = {0, 0, k_screenWidth, k_screenHeight};
+
+// The band being composed, and the clipping rectangle inside it
+class Band {
+ public:
+  constexpr static int k_maxHeight = 12;
+  void begin(Rect area);
+  const Rect& area() const { return m_area; }
+  const Rect& clip() const { return m_clip; }
+  // Restricts drawing to r (intersected with the band). Returns false if empty.
+  bool setClip(Rect r);
+  void resetClip() { m_clip = m_area; }
+  // Pointer to pixel (0, y) of the band, valid for x in [area.x, area.right)
+  KDColor* row(int y) const;
+  const KDColor* pixels() const;
+
+ private:
+  Rect m_area;
+  Rect m_clip;
+};
+
+enum class Align : uint8_t { Left, Center, Right };
+
+void fill(Band& b, Rect r, KDColor c, int alpha = 256);
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void frame(Band& b, Rect r, KDColor c, int alpha = 256);
+// Soft drop shadow around r
+void shadow(Band& b, Rect r, int radius, int strength);
+void mask(Band& b, const MintIcons::Mask& m, int x, int y, KDColor c,
+          int alpha = 256);
+// Coloured app tile; size is 24, 20 or 14
+void tile(Band& b, int icon, int size, int x, int y, int alpha = 256);
+// Icon of an external app (.nwa), scaled to size x size
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size);
+// Text whose top-left corner is (x, y), cut at maxWidth pixels ("..." added)
+void text(Band& b, const char* s, int x, int y, KDColor c,
+          KDFont::Size font = KDFont::Size::Small, Align align = Align::Left,
+          int maxWidth = k_screenWidth);
+// Large font magnified scale times (clocks, titles)
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align = Align::Left);
+int textWidth(const char* s, KDFont::Size font = KDFont::Size::Small);
+int glyphWidth(KDFont::Size font = KDFont::Size::Small);
+int glyphHeight(KDFont::Size font = KDFont::Size::Small);
+void pointer(Band& b, int x, int y, bool busy = false);
+// Login avatar (40 x 40)
+void avatar(Band& b, int x, int y);
+// XPenguins sprite (frames 0, 1 walking, 2 falling)
+void penguin(Band& b, int frame, int x, int y, bool left);
+// Night light: warm colours over the whole band
+void warmFilter(Band& b);
+
+// Wallpapers
+constexpr int k_numberOfWallpapers = 4;
+const char* wallpaperName(int theme);
+void prepareWallpaper(int theme);
+void wallpaper(Band& b);
+
+inline KDColor rgb(uint32_t c) { return KDColor::RGB24(c); }
+
+}  // namespace Mint
+}  // namespace Home
