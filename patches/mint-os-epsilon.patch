+  text(b, "Logithèque", c.x + 40, c.y + 2, KDWhite, Large);
+  text(b, "Choix de la rédaction", c.right() - 6, c.y + 19, KDWhite, Small,
+       Align::Right);
+  char line[40];
+  for (int i = 0; i < k_visibleRows; i++) {
+    int index = sw.scroll + i;
+    if (index >= k_numberOfPackages) {
+      break;
