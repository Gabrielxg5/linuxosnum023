+#!/usr/bin/env python3
+"""Generate the Mint-OS icons for the NumWorks home screen (the desktop).
+
+Everything is drawn as vector shapes in a 100x100 design space and rendered
+with 8x supersampling. Nothing comes from Linux Mint: these are original
+drawings in the spirit of the Mint-Y theme (flat colours, green folders).
+
+  - app tiles: colourful rounded squares (or folders, a monitor, a trash can)
+    exported as RGB565 + 8-bit alpha at three sizes (24, 20, 14);
+  - UI glyphs: single-colour 8-bit alpha masks (A8) tinted at runtime
+    (Mint logo, window buttons, panel applets, menu categories...);
+  - two pictures: the login avatar (Tux-like penguin, 40 px) and the
+    XPenguins sprites (pixel art);
+  - the mouse pointer, black with a white outline like Bibata.
+
+Usage: gen_icons.py <output_header.h> [--preview preview.png]
+"""
+
+import math
+import sys
+
+from PIL import Image, ImageDraw, ImageFont
+
+SS = 8
+D = 100
+TILE_SIZES = (24, 20, 14)
+
+FONT_PATHS = [
+    ("/System/Library/Fonts/Helvetica.ttc", 1),
+    ("/System/Library/Fonts/Supplemental/Arial Bold.ttf", 0),
+    ("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 0),
+]
+
+
+def font(size):
+    for path, index in FONT_PATHS:
+        try:
+            return ImageFont.truetype(path, size, index=index)
+        except Exception:
+            continue
+    return ImageFont.load_default()
+
+
+class Canvas:
+    """Drawing in 100x100 design units, supersampled."""
+
+    def __init__(self, mode="RGBA"):
+        self.n = D * SS
+        bg = (0, 0, 0, 0) if mode == "RGBA" else 0
+        self.img = Image.new(mode, (self.n, self.n), bg)
+        self.d = ImageDraw.Draw(self.img)
+        self.white = (255, 255, 255, 255) if mode == "RGBA" else 255
+        self.clear = (0, 0, 0, 0) if mode == "RGBA" else 0
+
+    def s(self, v):
+        return v * SS
+
+    def box(self, x0, y0, x1, y1):
+        return [self.s(x0), self.s(y0), self.s(x1), self.s(y1)]
+
+    def col(self, fill):
+        return self.white if fill is None else fill
+
+    def rrect(self, x0, y0, x1, y1, r, fill=None, outline=None, width=0):
+        self.d.rounded_rectangle(self.box(x0, y0, x1, y1), radius=self.s(r),
+                                 fill=self.col(fill) if outline is None else fill,
+                                 outline=outline,
+                                 width=int(round(self.s(width))) if width else 0)
+
+    def rect(self, x0, y0, x1, y1, fill=None):
+        self.d.rectangle(self.box(x0, y0, x1, y1), fill=self.col(fill))
+
+    def circle(self, cx, cy, r, fill=None, outline=None, width=0):
+        self.d.ellipse(self.box(cx - r, cy - r, cx + r, cy + r),
+                       fill=self.col(fill) if outline is None else fill,
+                       outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def ellipse(self, x0, y0, x1, y1, fill=None):
+        self.d.ellipse(self.box(x0, y0, x1, y1), fill=self.col(fill))
+
+    def line(self, pts, width, fill=None, caps=True):
+        c = self.col(fill)
+        self.d.line([(self.s(x), self.s(y)) for x, y in pts], fill=c,
+                    width=int(round(self.s(width))), joint="curve")
+        if caps:
+            for x, y in (pts[0], pts[-1]):
+                self.circle(x, y, width / 2, fill=c)
+
+    def poly(self, pts, fill=None):
+        self.d.polygon([(self.s(x), self.s(y)) for x, y in pts], fill=self.col(fill))
+
+    def arc(self, cx, cy, r, start, end, width, fill=None):
+        self.d.arc(self.box(cx - r, cy - r, cx + r, cy + r), start, end,
+                   fill=self.col(fill), width=int(round(self.s(width))))
+
+    def pieslice(self, cx, cy, r, start, end, fill=None):
+        self.d.pieslice(self.box(cx - r, cy - r, cx + r, cy + r), start, end,
+                        fill=self.col(fill))
+
+    def text(self, cx, cy, txt, size, fill=None):
+        f = font(self.s(size))
+        bb = self.d.textbbox((0, 0), txt, font=f)
+        w, h = bb[2] - bb[0], bb[3] - bb[1]
+        self.d.text((self.s(cx) - w / 2 - bb[0], self.s(cy) - h / 2 - bb[1]),
+                    txt, font=f, fill=self.col(fill))
+
+
+def rgb(h, a=255):
+    return ((h >> 16) & 255, (h >> 8) & 255, h & 255, a)
+
+
+MINT = 0x87CF3E
+MINT_DARK = 0x5A9E2A
+
+# ------------------------------------------------------------- Mint logo
+
+
+def mint_logo(c, fill=None, glyph=None, x0=8, y0=10, x1=92, y1=90):
+    """The Mint leaf: a rounded square whose top-left corner is square, with
+    the letters "lm" drawn in one stroke. glyph=None cuts the letters out
+    (masks), otherwise they are painted in that colour."""
+    w = x1 - x0
+    k = w / 84.0
+    c.rrect(x0, y0, x1, y1, 22 * k, fill=fill)
+    c.rect(x0, y0, x0 + 30 * k, y0 + 30 * k, fill=fill)
+    ink = glyph if glyph is not None else c.clear
+    sw = 8.5 * k
+
+    def p(x, y):
+        return (x0 + x * k, y0 + y * k)
+
+    # "l" going down, turning into the base line, rising into the "m"
+    c.line([p(14, 12), p(14, 52)], sw, fill=ink)
+    c.arc(*p(26, 52), 12 * k, 90, 180, sw, fill=ink)
+    c.line([p(26, 64), p(58, 64)], sw, fill=ink, caps=False)
+    c.arc(*p(58, 52), 12 * k, 0, 90, sw, fill=ink)
+    c.line([p(70, 52), p(70, 38)], sw, fill=ink, caps=False)
+    # humps of the "m"
+    c.arc(*p(60, 38), 10 * k, 180, 360, sw, fill=ink)
+    c.arc(*p(40, 38), 10 * k, 180, 360, sw, fill=ink)
+    c.line([p(50, 38), p(50, 52)], sw, fill=ink)
+    c.line([p(30, 38), p(30, 52)], sw, fill=ink)
+
+
+# ------------------------------------------------------------------ tiles
+
+
+def tile(color, color2=None, radius=22):
+    """Rounded square with a soft vertical gradient."""
+    c = Canvas()
+    top = rgb(color)
+    bottom = rgb(color2 if color2 is not None else color)
+    grad = Image.new("RGBA", (c.n, c.n))
+    gd = ImageDraw.Draw(grad)
+    for y in range(c.n):
+        t = y / (c.n - 1)
+        gd.line([(0, y), (c.n, y)],
+                fill=tuple(int(top[i] * (1 - t) + bottom[i] * t) for i in range(4)))
+    mask = Image.new("L", (c.n, c.n), 0)
+    ImageDraw.Draw(mask).rounded_rectangle(c.box(3, 3, 97, 97), radius=c.s(radius), fill=255)
+    c.img.paste(grad, (0, 0), mask)
+    # Mint-Y style: a light band at the top
+    hl = Image.new("RGBA", (c.n, c.n), (0, 0, 0, 0))
+    ImageDraw.Draw(hl).rounded_rectangle(c.box(3, 3, 97, 50), radius=c.s(radius),
+                                         fill=(255, 255, 255, 28))
+    hm = Image.new("L", (c.n, c.n), 0)
+    ImageDraw.Draw(hm).rectangle(c.box(3, 3, 97, 50), fill=255)
+    c.img.paste(Image.alpha_composite(c.img, hl), (0, 0), Image.composite(mask, hm, hm))
+    return c
+
+
+def folder(c, back, front, tab=None):
+    tab = tab if tab is not None else back
+    c.rrect(6, 16, 46, 38, 6, fill=rgb(tab))
+    c.rrect(6, 24, 94, 88, 7, fill=rgb(back))
+    c.rrect(6, 34, 94, 88, 7, fill=rgb(front))
+
+
+# Calculator apps -----------------------------------------------------------
+
+def t_calculation(c):
+    c.line([(30, 18), (30, 40)], 7)
+    c.line([(19, 29), (41, 29)], 7)
+    c.line([(59, 29), (81, 29)], 7)
+    c.line([(21, 61), (39, 79)], 7)
+    c.line([(39, 61), (21, 79)], 7)
+    c.line([(60, 63), (80, 63)], 7)
+    c.line([(60, 77), (80, 77)], 7)
+
+
+def t_graph(c):
+    c.line([(16, 18), (16, 84), (86, 84)], 5, fill=(255, 255, 255, 150))
+    pts = []
+    for i in range(41):
+        x = 18 + i * 1.7
+        y = 52 - 28 * math.sin((x - 18) / 68 * 2 * math.pi)
+        pts.append((x, y))
+    c.line(pts, 8)
+
+
+def t_solver(c):
+    c.text(50, 50, "x=?", 34)
+
+
+def t_statistics(c):
+    c.rrect(16, 54, 32, 86, 3)
+    c.rrect(36, 30, 52, 86, 3)
+    c.rrect(56, 44, 72, 86, 3)
+    c.rrect(76, 62, 88, 86, 3)
+
+
+def t_settings_calc(c):
+    for i in range(8):
+        a = i * math.pi / 4
+        c.line([(50 + 22 * math.cos(a), 50 + 22 * math.sin(a)),
+                (50 + 34 * math.cos(a), 50 + 34 * math.sin(a))], 13, caps=False)
+    c.circle(50, 50, 26)
+    c.circle(50, 50, 11, fill=rgb(0x6B7380))
+
+
+def t_sequence(c):
+    c.text(50, 52, "un", 46)
+
+
+def t_regression(c):
+    for (x, y) in ((22, 74), (36, 60), (46, 66), (58, 46), (70, 40), (80, 26)):
+        c.circle(x, y, 6)
+    c.line([(14, 84), (88, 20)], 4)
+
+
+def t_distributions(c):
+    pts = [(10, 84)]
+    for i in range(41):
+        x = 10 + i * 2
+        y = 84 - 62 * math.exp(-((x - 50) / 15) ** 2)
+        pts.append((x, y))
+    pts.append((90, 84))
+    c.poly(pts)
+
+
+def t_inference(c):
+    c.text(50, 50, "p", 64)
+
+
+def t_finance(c):
+    c.text(50, 52, "$", 66)
+
+
+def t_code(c):
+    c.text(50, 50, "py", 50)
+
+
+def t_elements(c):
+    c.rrect(18, 18, 82, 82, 8, fill=None, outline=(255, 255, 255, 255), width=7)
+    c.text(50, 52, "H", 44)
+
+
+# Mint apps ------------------------------------------------------------------
+
+def t_terminal(c):
+    # Dark window with a title strip and a green prompt
+    c.rect(3, 3, 97, 22, fill=(255, 255, 255, 30))
+    c.line([(20, 40), (36, 54), (20, 68)], 8, fill=rgb(MINT))
+    c.line([(44, 72), (72, 72)], 8)
+
+
+def t_files(c):
+    folder(c, 0x6FB33F, 0x8BCB52, 0x5E9E33)
+    c.rrect(6, 34, 94, 40, 0, fill=(255, 255, 255, 40))
+
+
+def t_home(c):
+    folder(c, 0x6FB33F, 0x8BCB52, 0x5E9E33)
+    w = (255, 255, 255, 235)
+    c.poly([(50, 42), (70, 58), (30, 58)], fill=w)
+    c.rect(35, 57, 65, 78, fill=w)
+    c.rect(46, 65, 54, 78, fill=rgb(0x8BCB52))
+
+
+def t_documents(c):
+    folder(c, 0x6FB33F, 0x8BCB52, 0x5E9E33)
+    w = (255, 255, 255, 235)
+    c.rrect(36, 44, 64, 80, 3, fill=w)
+    for y in (53, 61, 69):
+        c.line([(41, y), (59, y)], 3, fill=rgb(0x6FB33F))
+
+
+def t_scripts(c):
+    folder(c, 0x3E8ED0, 0x5AA5E6, 0x2F76B5)
+    c.text(50, 61, "py", 30, fill=(255, 255, 255, 240))
+
+
+def t_computer(c):
+    c.rrect(8, 14, 92, 72, 6, fill=rgb(0x3C4048))
+    c.rrect(13, 19, 87, 66, 3, fill=rgb(0x2A7AB8))
+    c.poly([(13, 66), (87, 19), (87, 66)], fill=rgb(0x3A8FD0))
+    c.rect(42, 72, 58, 82, fill=rgb(0x9AA1AA))
+    c.rrect(28, 82, 72, 90, 3, fill=rgb(0xC5CBD3))
+
+
+def t_trash(c):
+    c.rrect(20, 22, 80, 30, 3, fill=rgb(0xA9B0B9))
+    c.rrect(40, 14, 60, 24, 3, fill=rgb(0xA9B0B9))
+    c.poly([(24, 32), (76, 32), (70, 90), (30, 90)], fill=rgb(0xD5DADF))
+    for x in (38, 50, 62):
+        c.line([(x, 42), (x - (x - 50) * 0.15, 80)], 4, fill=rgb(0x8E959E))
+
+
+def t_trash_full(c):
+    t_trash(c)
+    c.rect(26, 26, 74, 32, fill=rgb(0xD5DADF))
+    c.poly([(30, 30), (46, 12), (58, 22), (70, 14), (76, 30)], fill=rgb(0xF0E6C8))
+    c.line([(40, 24), (52, 22)], 3, fill=rgb(0x9E9686))
+
+
+def t_document(c):
+    c.poly([(22, 8), (62, 8), (80, 26), (80, 92), (22, 92)], fill=rgb(0xF2F2F2))
+    c.poly([(62, 8), (80, 26), (62, 26)], fill=rgb(0xC8C8C8))
+    for y in (40, 52, 64, 76):
+        c.line([(32, y), (70, y)], 4, fill=rgb(0x9A9A9A))
+
+
+def t_python_file(c):
+    c.poly([(22, 8), (62, 8), (80, 26), (80, 92), (22, 92)], fill=rgb(0xF2F2F2))
+    c.poly([(62, 8), (80, 26), (62, 26)], fill=rgb(0xC8C8C8))
+    c.rrect(30, 40, 72, 84, 8, fill=rgb(0x3E7CC0))
+    c.text(51, 62, "py", 26, fill=rgb(0xFFD43B))
+
+
+def t_sysmonitor(c):
+    c.rrect(14, 18, 86, 82, 4, fill=rgb(0x1E2226))
+    for x in (32, 50, 68):
+        c.line([(x, 22), (x, 78)], 1.5, fill=(255, 255, 255, 40), caps=False)
+    c.line([(18, 64), (30, 64), (38, 36), (48, 72), (58, 44), (66, 56), (82, 56)],
+           6, fill=rgb(MINT))
+
+
+def t_updates(c):
+    # Shield with a check, like the update manager
+    c.poly([(50, 10), (84, 22), (82, 52), (70, 74), (50, 90), (30, 74), (18, 52),
+            (16, 22)], fill=(255, 255, 255, 255))
+    c.poly([(50, 18), (76, 27), (75, 51), (65, 69), (50, 81), (35, 69), (25, 51),
+            (24, 27)], fill=rgb(0x2F8FD8))
+    c.line([(36, 50), (47, 61), (66, 38)], 8)
+
+
+def t_software(c):
+    # Shopping bag with the Mint leaf
+    c.line([(36, 34), (36, 22), (64, 22), (64, 34)], 6, fill=rgb(0xE8EDF2), caps=False)
+    c.arc(50, 26, 14, 180, 360, 6, fill=rgb(0xE8EDF2))
+    c.rrect(14, 30, 86, 90, 10, fill=rgb(0xF5F7FA))
+    mint_logo(c, fill=rgb(MINT), glyph=rgb(0xF5F7FA), x0=30, y0=44, x1=70, y1=82)
+
+
+def t_system_settings(c):
+    # Sliders
+    for i, (y, k) in enumerate(((28, 62), (50, 34), (72, 54))):
+        c.line([(18, y), (82, y)], 6, fill=(255, 255, 255, 140))
+        c.circle(k, y, 10)
+
+
+def t_welcome(c):
+    mint_logo(c, fill=(255, 255, 255, 255), glyph=rgb(0x4F9A2C), x0=18, y0=18, x1=82, y1=82)
+
+
+def t_snake(c):
+    c.line([(72, 24), (34, 24), (26, 32), (26, 44), (34, 52), (66, 52),
+            (74, 60), (74, 70), (66, 78), (26, 78)], 12)
+    c.circle(78, 24, 4, fill=rgb(0x1E7D32))
+
+
+def t_2048(c):
+    for (x, y, a) in ((14, 14, 255), (52, 14, 170), (14, 52, 170), (52, 52, 255)):
+        c.rrect(x, y, x + 34, y + 34, 6, fill=(255, 255, 255, a))
+
