+void drawCalendar(Band& b) {
+  Rect r = k_calendarPopup;
+  if (!r.inset(-6).intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  drawPopupBase(b, r, nullptr);
+  int32_t day = today();
+  int y, m, d;
+  civilFromDays(day, &y, &m, &d);
+  char line[48];
+  int weekday = ((day % 7) + 7) % 7;
+  fmt(line, sizeof(line), "%s %d %s", k_dayNames[weekday], d,
+      k_monthNames[m - 1]);
+  text(b, line, r.x + r.w / 2, r.y + 5, p.text, Small, Align::Center);
+  fmt(line, sizeof(line), "%d", y);
+  text(b, line, r.x + r.w / 2, r.y + 19, p.textDim, Small, Align::Center);
+  constexpr const char* k_heads[7] = {"L", "M", "M", "J", "V", "S", "D"};
+  int cellW = 22, x0 = r.x + 9, y0 = r.y + 38;
+  for (int i = 0; i < 7; i++) {
+    text(b, k_heads[i], x0 + i * cellW + cellW / 2, y0, p.textDim, Small,
+         Align::Center);
+  }
+  int32_t first = daysFromCivil(y, m, 1);
+  // 1970-01-01 was a Thursday: Monday-based column of the first day
+  int col0 = ((first % 7) + 7 + 3) % 7;
+  int nextMonth = m == 12 ? daysFromCivil(y + 1, 1, 1) : daysFromCivil(y, m + 1, 1);
+  int length = nextMonth - first;
+  for (int k = 0; k < length; k++) {
+    int cell = col0 + k;
+    int cx = x0 + (cell % 7) * cellW + cellW / 2;
+    int cy = y0 + 15 + (cell / 7) * 15;
+    fmt(line, sizeof(line), "%d", k + 1);
+    if (k + 1 == d) {
+      roundFill(b, {cx - 9, cy - 1, 18, 15}, 4, p.accent);
+    }
+    text(b, line, cx, cy, k + 1 == d ? KDWhite : p.text, Small, Align::Center);
+  }
+}
