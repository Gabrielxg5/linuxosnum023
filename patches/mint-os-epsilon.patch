+
+def emit_array(out, ctype, name, values, per_line=24):
+    out.append(f"constexpr {ctype} {name}[{len(values)}] = {{")
+    for i in range(0, len(values), per_line):
+        out.append("  " + ", ".join(str(v) for v in values[i:i + per_line]) + ",")
+    out.append("};")
+
+
+def rgb565(r, g, b):
+    return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
+
+
+def emit_pixmap(out, name, rows, legend):
+    w = max(len(r) for r in rows)
+    h = len(rows)
+    data = []
+    for line in rows:
+        line = line.ljust(w)
+        for ch in line:
+            data.append(legend.get(ch, 0))
+    out.append(f"constexpr int k_{name}Width = {w};")
+    out.append(f"constexpr int k_{name}Height = {h};")
+    emit_array(out, "uint8_t", f"k_{name}", data)
+    return w, h, data
