+def main():
+    if len(sys.argv) < 2:
+        raise SystemExit(__doc__)
+    out_path = sys.argv[1]
+    preview = sys.argv[sys.argv.index("--preview") + 1] if "--preview" in sys.argv else None
+
+    out = ["// Generated by apps/home/mint/gen_icons.py - do not edit",
+           "#pragma once", "#include <stdint.h>", "",
+           "namespace Home {", "namespace MintIcons {", ""]
+
+    out.append("enum Tile : uint8_t {")
+    for i, (name, *_rest) in enumerate(TILES):
+        out.append(f"  Tile{name} = {i},")
+    out.append(f"  NumberOfTiles = {len(TILES)}")
+    out.append("};")
+    out.append("")
+
+    previews = []
+    for size in TILE_SIZES:
+        colors, alphas = [], []
+        row = []
+        for (name, c1, c2, fn) in TILES:
+            img = render_tile(c1, c2, fn, size)
+            row.append(img)
+            for (r, g, b, a) in img.getdata():
+                colors.append(rgb565(r, g, b) if a else 0)
+                alphas.append(a)
+        previews.append(row)
+        out.append(f"constexpr int k_tile{size}Size = {size};")
+        emit_array(out, "uint16_t", f"k_tile{size}Colors", colors)
+        emit_array(out, "uint8_t", f"k_tile{size}Alphas", alphas)
+        out.append("")
+
+    out.append("struct Mask {")
+    out.append("  uint8_t size;")
+    out.append("  const uint8_t* data;")
+    out.append("};")
+    out.append("")
+    mask_imgs = []
+    for (name, size, fn) in MASKS:
+        img = render_mask(fn, size)
+        mask_imgs.append(img)
+        emit_array(out, "uint8_t", f"k_mask{name}Data", list(img.getdata()))
+        out.append(f"constexpr Mask k_mask{name} = {{{size}, k_mask{name}Data}};")
+    out.append("")
+
+    avatar = tux_avatar()
+    out.append(f"constexpr int k_avatarSize = {avatar.width};")
+    emit_array(out, "uint16_t", "k_avatarColors",
+               [rgb565(r, g, b) if a else 0 for (r, g, b, a) in avatar.getdata()])
+    emit_array(out, "uint8_t", "k_avatarAlphas", [a for (_r, _g, _b, a) in avatar.getdata()])
+    out.append("")
+
+    out.append("// Pointers. 0: transparent, 1: outline (white), 2: fill (black)")
