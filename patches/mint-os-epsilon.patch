+KDColor styleColor(uint8_t style) {
+  switch (style) {
+    case St::Green:
+      return k_green;
+    case St::Red:
+      return k_red;
+    case St::Yellow:
+      return k_yellow;
+    case St::Blue:
+      return k_blue;
+    case St::Dim:
+      return k_dim;
+    case St::Bold:
+      return k_white;
+    case St::Cyan:
+      return k_cyan;
+    default:
+      return k_fore;
+  }
+}
