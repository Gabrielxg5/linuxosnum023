+
+// Resolves a path to a directory, -1 if it is not one
+int resolveDir(const char* path) {
+  if (path == nullptr || path[0] == 0 || is(path, "~")) {
+    return k_home;
+  }
+  int dir = t().cwd;
+  if (path[0] == '/') {
+    dir = k_root;
+    path++;
+  } else if (path[0] == '~' && path[1] == '/') {
+    dir = k_home;
+    path += 2;
+  }
+  char part[32];
+  while (*path) {
+    const char* slash = strchr(path, '/');
+    int n = slash ? slash - path : strlen(path);
+    if (n >= static_cast<int>(sizeof(part))) {
+      return -1;
+    }
+    memcpy(part, path, n);
+    part[n] = 0;
+    path += n + (slash ? 1 : 0);
+    if (n == 0 || is(part, ".")) {
+      continue;
+    }
+    if (is(part, "..")) {
+      dir = dir == k_root ? k_root : k_dirs[dir].parent;
+      continue;
+    }
+    if (dir == k_homes && is(part, "numworks")) {
+      dir = k_home;
+      continue;
+    }
+    int kids[16];
+    int count = children(dir, kids);
+    int found = -1;
+    for (int i = 0; i < count; i++) {
+      if (strcmp(dirName(kids[i]), part) == 0) {
+        found = kids[i];
+      }
+    }
+    if (found < 0) {
+      return -1;
+    }
+    dir = found;
+  }
+  return dir;
+}
+
+void printColumns(const char* const* names, int n, const KDColor* colors,
+                  uint8_t style) {
+  // Names on as many columns as fit, like ls
+  char line[k_cols + 1];
+  line[0] = 0;
+  int used = 0;
+  for (int i = 0; i < n; i++) {
+    int w = columnsOf(names[i]);
+    if (used > 0 && used + 2 + w > k_cols) {
+      print(line, style);
+      line[0] = 0;
+      used = 0;
+    }
+    if (used > 0) {
+      strlcat(line, "  ", sizeof(line));
+      used += 2;
+    }
+    strlcat(line, names[i], sizeof(line));
+    used += w;
+  }
+  if (used > 0) {
+    print(line, style);
+  }
+  (void)colors;
+}
+
+void ls(const Args& a) {
+  int dir = t().cwd;
+  const char* target = nullptr;
+  for (int i = 1; i < a.argc; i++) {
+    if (a.argv[i][0] != '-') {
+      target = a.argv[i];
+    }
+  }
+  if (target) {
+    dir = resolveDir(target);
+    if (dir < 0) {
+      Record r;
+      if (findRecord(target, &r)) {
+        print(r.fullName());
+        return;
+      }
+      out(St::Normal, "ls: impossible d'accéder à '%s': Aucun fichier ou dossier de ce type", target);
+      return;
+    }
+  }
+  bool all = hasFlag(a, 'a');
+  bool longForm = hasFlag(a, 'l');
+  const char* names[40];
+  bool isDir[40];
+  int n = 0;
+  if (all) {
+    names[n] = ".";
+    isDir[n++] = true;
+    names[n] = "..";
+    isDir[n++] = true;
+  }
+  int kids[16];
+  int count = children(dir, kids);
+  for (int i = 0; i < count && n < 40; i++) {
+    names[n] = dirName(kids[i]);
+    isDir[n++] = true;
+  }
+  if (dir == k_homes) {
+    names[n] = "numworks";
+    isDir[n++] = true;
+  }
+  for (int i = 0; i < k_numberOfFakeFiles && n < 40; i++) {
+    if (k_files[i].dir == dir && (all || k_files[i].name[0] != '.')) {
+      names[n] = k_files[i].name;
+      isDir[n++] = false;
+    }
+  }
+  if (dir == k_bin) {
+    for (const char* b : k_binaries) {
+      if (n < 40) {
+        names[n] = b;
+        isDir[n++] = false;
+      }
+    }
+  }
+  int section = recordSection(dir);
+  int records = section < 0 ? 0 : Apps::Storage::count(section);
+  int firstRecord = n;
+  for (int i = 0; i < records && n < 40; i++) {
+    names[n] = Apps::Storage::at(section, i).fullName();
+    isDir[n++] = false;
+  }
+  if (longForm) {
+    char line[96];
+    out(St::Normal, "total %s", records > 0 ? "8" : "0");
+    for (int i = 0; i < n; i++) {
+      int size = isDir[i] ? 4096 : 220;
+      if (i >= firstRecord) {
+        size = static_cast<int>(
+            Apps::Storage::at(section, i - firstRecord).value().size);
+      }
+      fmt(line, sizeof(line), "%s 1 numworks %5d %s",
+          isDir[i] ? "drwxr-xr-x" : "-rw-r--r--", size, names[i]);
+      print(line, isDir[i] ? St::Blue : St::Normal);
+    }
+    return;
+  }
+  if (n == 0) {
+    return;
+  }
+  // Directories in blue first, then files
+  const char* dirs[40];
+  const char* files[40];
+  int nd = 0, nf = 0;
+  for (int i = 0; i < n; i++) {
+    if (isDir[i]) {
+      dirs[nd++] = names[i];
+    } else {
+      files[nf++] = names[i];
+    }
+  }
+  printColumns(dirs, nd, nullptr, St::Blue);
+  printColumns(files, nf, nullptr, St::Normal);
+}
+
+void cat(const Args& a) {
+  if (a.argc < 2) {
+    print("cat: il manque un nom de fichier");
+    return;
+  }
+  for (int i = 1; i < a.argc; i++) {
+    const char* name = a.argv[i];
+    // /etc/xxx and friends
+    const char* slash = findLast(name, '/');
+    int dir = t().cwd;
+    const char* base = name;
+    if (slash) {
+      char path[40];
+      int n = slash - name;
+      if (n >= static_cast<int>(sizeof(path))) {
+        n = sizeof(path) - 1;
+      }
+      memcpy(path, name, n);
+      path[n] = 0;
+      dir = n == 0 ? k_root : resolveDir(path);
+      base = slash + 1;
+    }
+    const FakeFile* fake = dir >= 0 ? findFake(dir, base) : nullptr;
+    if (fake) {
+      if (fake->rootOnly && !t().root) {
+        out(St::Normal, "cat: %s: Permission non accordée", name);
+      } else {
+        printLines(fake->content, St::Normal);
+      }
+      continue;
+    }
+    if (dir >= 0 && resolveDir(name) >= 0) {
+      out(St::Normal, "cat: %s: est un dossier", name);
+      continue;
+    }
+    Record r;
+    if (!findRecord(base, &r)) {
+      out(St::Normal, "cat: %s: Aucun fichier ou dossier de ce type", name);
+      continue;
+    }
+    Record::Data d = r.value();
+    const char* p = static_cast<const char*>(d.buffer);
+    size_t size = d.size;
+    // Python scripts start with one status byte
+    if (r.hasExtension("py") && size > 0) {
+      p++;
+      size--;
+    } else if (!r.hasExtension("py")) {
+      out(St::Dim, "(%s : fichier binaire de la calculatrice)", r.fullName());
+      continue;
+    }
+    char line[k_cols + 1];
+    int n = 0, shown = 0;
+    for (size_t k = 0; k < size && shown < 40; k++) {
+      char ch = p[k];
+      if (ch == 0) {
+        break;
+      }
+      if (ch == '\n' || n == k_cols) {
+        line[n] = 0;
+        print(line);
+        shown++;
+        n = 0;
+        if (ch == '\n') {
+          continue;
+        }
+      }
+      if (ch == '\t') {
+        ch = ' ';
+      }
+      if (static_cast<uint8_t>(ch) >= ' ') {
+        line[n++] = ch;
+      }
+    }
+    if (n > 0) {
+      line[n] = 0;
+      print(line);
+    }
+  }
+}
+
+bool validScriptName(const char* name) {
+  int len = strlen(name);
+  return len > 3 && strcmp(name + len - 3, ".py") == 0 && len < 24 &&
+         strchr(name, '/') == nullptr;
+}
+
+// Writes a Python script (content without the status byte)
+bool writeScript(const char* name, const char* content, bool append) {
+  FileSystem* fs = FileSystem::sharedFileSystem;
+  char data[400];
+  int n = 0;
+  data[n++] = 1;  // auto-import status, like the Code app
+  Record existing = fs->recordNamed(name);
+  if (append && fs->hasRecord(existing)) {
+    Record::Data d = existing.value();
+    const char* old = static_cast<const char*>(d.buffer) + 1;
+    int max = d.size > 1 ? static_cast<int>(d.size) - 1 : 0;
+    int len = 0;
+    while (len < max && old[len]) {
+      len++;
+    }
+    if (len > static_cast<int>(sizeof(data)) - 80) {
+      len = sizeof(data) - 80;
+    }
+    memcpy(data + n, old, len);
+    n += len;
+  }
+  int len = strlen(content);
+  if (n + len + 2 > static_cast<int>(sizeof(data))) {
+    return false;
+  }
+  memcpy(data + n, content, len);
+  n += len;
+  data[n++] = '\n';
+  data[n++] = 0;
+  if (fs->hasRecord(existing)) {
+    existing.tryToDestroy();
+  }
+  char base[24];
+  strlcpy(base, name, sizeof(base));
+  base[strlen(base) - 3] = 0;
+  return fs->createRecordWithExtension(base, "py", data, n) ==
+         Record::ErrorStatus::None;
+}
