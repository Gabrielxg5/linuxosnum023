+void setAlphaLock(bool on) {
+  if (s_fakeClock) {
+    s.alphaLockedByUs = on;
+    return;
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  using Status = Ion::Events::ShiftAlphaStatus;
+  if (on) {
+    container->setShiftAlphaStatus(
+        Status(Status::ShiftStatus::Inactive, Status::AlphaStatus::Locked));
+    s.alphaLockedByUs = true;
+  } else if (s.alphaLockedByUs) {
+    container->setShiftAlphaStatus(Status());
+    s.alphaLockedByUs = false;
+  }
+}
