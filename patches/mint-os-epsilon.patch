+inline void blendPixel(KDColor* p, KDColor c, int alpha) {
+  if (alpha >= 256) {
+    *p = c;
+  } else if (alpha > 0) {
+    *p = KDColor::Blend(c, *p, static_cast<uint8_t>(alpha > 255 ? 255 : alpha));
+  }
+}
