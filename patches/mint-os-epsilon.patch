+namespace Updates {
+
+constexpr int k_width = 270;
+constexpr int k_height = 152;
+
+struct Update {
+  const char* name;
+  const char* version;
+  int sizeKB;
+  bool security;
+};
+
+constexpr Update k_batches[2][5] = {
+    {{"linux-image-6.8.0", "6.8.0-49", 14200, true},
+     {"cinnamon", "6.2.9", 5120, false},
+     {"firefox", "132.0+mint1", 68300, true},
+     {"mint-themes", "2.1.9", 3400, false},
+     {"epsilon-numworks", "26.4.1", 1337, false}},
+    {{"mintupdate", "6.0.8", 420, false},
+     {"python3-numworks", "3.4.2", 980, false},
+     {"openssl", "3.0.13-0ubuntu3", 2050, true},
+     {"calculatrice-motivation", "4.2", 42, false},
+     {"tux-pinguin-data", "1.0.1", 666, false}}};
+
+constexpr int k_updates = 5;
+
+Rect installRect(Rect c) { return {c.right() - 106, c.bottom() - 22, 100, 18}; }
+Rect refreshRect(Rect c) { return {c.x + 6, c.bottom() - 22, 80, 18}; }
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  UpdatesState& u = s.updates;
+  fill(b, c, p.windowBack);
+  char line[48];
+  tile(b, MintIcons::TileUpdates, 24, c.x + 8, c.y + 6);
+  const Update* batch = k_batches[u.generation % 2];
+  if (u.phase == 2) {
+    text(b, "Votre système est à jour", c.x + 40, c.y + 10, p.winText);
+    roundFill(b, {c.x + c.w / 2 - 22, c.y + 46, 44, 44}, 22, p.accent);
+    mask(b, MintIcons::k_maskCheck, c.x + c.w / 2 - 5, c.y + 63, KDWhite);
+    text(b, "Aucune mise à jour disponible.", c.x + c.w / 2, c.y + 98,
+         p.winTextDim, Small, Align::Center);
+  } else {
+    text(b, u.phase == 1 ? "Installation des mises à jour..."
+                         : "Mises à jour disponibles",
+         c.x + 40, c.y + 4, p.winText);
+    int total = 0;
+    for (int i = 0; i < k_updates; i++) {
+      total += batch[i].sizeKB;
+    }
+    fmt(line, sizeof(line), "%d paquets, %d Mo", k_updates, total / 1024);
+    text(b, line, c.x + 40, c.y + 18, p.winTextDim);
+    Rect list = {c.x + 4, c.y + 36, c.w - 8, k_updates * 16 + 2};
+    fill(b, list, p.view);
+    for (int i = 0; i < k_updates; i++) {
+      Rect r = {list.x + 2, list.y + 1 + i * 16, list.w - 4, 16};
+      bool done = u.phase == 1 && u.progress * k_updates / 1000 > i;
+      checkbox(b, {r.x + 2, r.y + 2, 12, 12}, !done);
+      if (batch[i].security) {
+        mask(b, MintIcons::k_maskShield, r.x + 18, r.y + 1,
+             KDColor::RGB24(0xE04C4C));
+      }
+      text(b, batch[i].name, r.x + 34, r.y + 1, done ? p.winTextDim : p.winText,
+           Small, Align::Left, r.w - 120);
+      text(b, batch[i].version, r.right() - 2, r.y + 1, p.winTextDim, Small,
+           Align::Right, 86);
+    }
+    if (u.phase == 1) {
+      progressBar(b, {c.x + 8, c.bottom() - 18, c.w - 16, 8}, u.progress,
+                  p.accent);
+      return;
+    }
+  }
+  button(b, refreshRect(c), "Rafraîchir");
+  if (u.phase == 0) {
+    button(b, installRect(c), "Installer", true);
+  }
+}
+
+void install(Rect c) {
+  if (s.updates.phase == 0) {
+    s.updates.phase = 1;
+    s.updates.progress = 0;
+    invalidate(c);
+  }
+}
+
+void refresh(Rect c) {
+  UpdatesState& u = s.updates;
+  if (u.phase == 2 && random(3) == 0) {
+    u.generation++;
+    u.phase = 0;
+    notify("Mises à jour", "De nouvelles mises à jour sont arrivées.",
+           MintIcons::TileUpdates);
+    invalidateAll();
+  }
+  invalidate(c);
+}
+
+void click(int x, int y, bool right, Rect c) {
+  int ax = c.x + x, ay = c.y + y;
+  if (installRect(c).contains(ax, ay)) {
+    install(c);
+  } else if (refreshRect(c).contains(ax, ay) && s.updates.phase != 1) {
+    refresh(c);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  if (e == Events::OK || e == Events::EXE) {
+    install(c);
+    return true;
+  }
+  return false;
+}
+
+bool tick(Rect c) {
+  UpdatesState& u = s.updates;
+  if (u.phase != 1) {
+    return false;
+  }
+  u.progress += 40 + random(40);
+  if (u.progress >= 1000) {
+    u.progress = 1000;
+    u.phase = 2;
+    notify("Mises à jour", "Installées. Pas besoin de redémarrer !",
+           MintIcons::TileUpdates);
+    invalidateAll();
+  }
+  invalidate(c);
+  return true;
+}
