+// Games are only in the menu once installed
+bool windowAppAvailable(WindowApp app) {
+  switch (app) {
+    case WindowApp::Snake:
+      return isInstalled(Package::Snake);
+    case WindowApp::Game2048:
+      return isInstalled(Package::Game2048);
+    case WindowApp::Mines:
+      return isInstalled(Package::Mines);
+    default:
+      return true;
+  }
+}
+
+bool itemIsValid(Item item) {
+  switch (item.kind) {
+    case Item::Kind::Builtin:
+      for (int i = 0; i < s_numberOfBuiltin; i++) {
+        if (s_builtin[i] == item.index) {
+          return true;
+        }
+      }
+      return false;
+    case Item::Kind::Window:
+      return item.index >= 0 && item.index < k_numberOfWindowApps &&
+             windowAppAvailable(static_cast<WindowApp>(item.index));
+    case Item::Kind::External:
+      return item.index >= 0 && item.index < s_numberOfGames;
+    case Item::Kind::Action:
+      return item.index >= 0 && item.index < k_numberOfActions &&
+             (item.index != static_cast<int>(Action::XPenguins) ||
+              isInstalled(Package::XPenguins));
+    default:
+      return false;
+  }
+}
