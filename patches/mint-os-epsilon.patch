+
+void run(const char* cmd, bool root, Rect c) {
+  TerminalState& st = t();
+  Args a;
+  parse(cmd, &a);
+  if (a.argc == 0) {
+    return;
+  }
+  const char* name = a.argv[0];
+  char line[96];
+  // Output redirected to a Python script: echo only
+  if (a.redirect) {
+    if (!is(name, "echo")) {
+      print("bash: seul echo sait écrire dans un fichier", St::Red);
+      return;
+    }
+    if (!validScriptName(a.redirect)) {
+      out(St::Red, "bash: %s : seuls les scripts .py sont", a.redirect);
+      print("permis sur cette calculatrice", St::Red);
+      return;
+    }
+    const char* text = a.argc > 1 ? a.rest : "";
+    // Remove the quotes and the redirection from rest
+    char content[TerminalState::k_inputSize];
+    int n = 0;
+    for (const char* p = text; *p && *p != '>' && n < TerminalState::k_inputSize - 1; p++) {
+      if (*p != '"' && *p != '\'') {
+        content[n++] = *p;
+      }
+    }
+    while (n > 0 && content[n - 1] == ' ') {
+      n--;
+    }
+    content[n] = 0;
+    if (!writeScript(a.redirect, content, a.append)) {
+      print("bash: plus de place sur le périphérique", St::Red);
+    }
+    return;
+  }
+
+  if (is(name, "help")) {
+    print("Commandes (Boîte à outils = Tab) :", St::Bold);
+    printColumns(k_commands, k_numberOfCommands, nullptr, St::Normal);
+    print("Et : sudo, apt install, echo x > a.py...", St::Dim);
+  } else if (is(name, "ls") || is(name, "ll") || is(name, "dir")) {
+    if (is(name, "ll")) {
+      Args l = a;
+      l.argv[l.argc < k_maxArgs ? l.argc++ : k_maxArgs - 1] = "-la";
+      ls(l);
+    } else {
+      ls(a);
+    }
+  } else if (is(name, "sl")) {
+    if (!needsPackage("sl", Package::Sl)) {
+      startAnim(AnimSl);
+    }
+  } else if (is(name, "cd")) {
+    int dir = resolveDir(a.argc > 1 ? a.argv[1] : nullptr);
+    if (dir < 0) {
+      out(St::Normal, "bash: cd: %s: Aucun fichier ou dossier", a.argv[1]);
+      out(St::Normal, "de ce type");
+    } else {
+      st.cwd = dir;
+    }
+  } else if (is(name, "pwd")) {
+    const char* path = k_dirs[st.cwd].path;
+    if (path[0] == '~') {
+      out(St::Normal, "/home/numworks%s", path + 1);
+    } else {
+      print(path);
+    }
+  } else if (is(name, "cat") || is(name, "less") || is(name, "more")) {
+    cat(a);
+  } else if (is(name, "touch")) {
+    if (a.argc < 2) {
+      print("touch: opérande de fichier manquant");
+    } else if (!validScriptName(a.argv[1])) {
+      print("touch: seuls les scripts .py sont permis", St::Red);
+    } else {
+      Record r;
+      if (!findRecord(a.argv[1], &r) && !writeScript(a.argv[1], "", false)) {
+        print("touch: plus de place", St::Red);
+      }
+    }
+  } else if (is(name, "rm")) {
