diff --git a/epsilon/apps/home/mint/str.h b/epsilon/apps/home/mint/str.h
new file mode 100644
index 0000000000..b7a63f9139
--- /dev/null
+++ b/epsilon/apps/home/mint/str.h
@@ -0,0 +1,35 @@
+#pragma once
+
+/* The calculator's libc has no strstr nor strrchr: small versions. */
+
+#include <string.h>
+
+namespace Home {
+namespace Mint {
+
+inline const char* findLast(const char* s, char c) {
+  const char* found = nullptr;
+  for (; *s; s++) {
+    if (*s == c) {
+      found = s;
+    }
+  }
+  return found;
+}
+
+inline char* findLast(char* s, char c) {
+  return const_cast<char*>(findLast(const_cast<const char*>(s), c));
+}
+
+inline const char* findText(const char* s, const char* sub) {
+  size_t n = strlen(sub);
+  for (; *s; s++) {
+    if (strncmp(s, sub, n) == 0) {
+      return s;
+    }
+  }
+  return n == 0 ? s : nullptr;
+}
+
+}  // namespace Mint
+}  // namespace Home
