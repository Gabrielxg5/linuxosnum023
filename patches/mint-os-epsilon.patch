+void drawGrub(Band& b) {
+  fill(b, k_screen, KDBlack);
+  KDColor white = rgb(0xD8D8D8);
+  text(b, "GNU GRUB  version 2.12", 160, 8, white, Small, Align::Center);
+  Rect box = {6, 30, 308, 92};
+  frame(b, box, white);
+  constexpr const char* k_entries[5] = {
+      "Linux Mint 22 Cinnamon", "Advanced options for Linux Mint 22",
+      "Windows Boot Manager (on /dev/sda1)", "Memory test (memtest86+)",
+      "UEFI Firmware Settings"};
+  for (int i = 0; i < 5; i++) {
+    int y = box.y + 4 + i * 16;
+    bool sel = i == s.grubSelection;
+    if (sel) {
+      fill(b, {box.x + 3, y, box.w - 6, 15}, white);
+    }
+    char line[48];
+    fmt(line, sizeof(line), "%c%s", sel ? '*' : ' ', k_entries[i]);
+    text(b, line, box.x + 6, y + 1, sel ? KDBlack : white, Small, Align::Left,
+         box.w - 10);
+  }
+  KDColor dim = rgb(0xA8A8A8);
+  text(b, "Use the Up and Down keys to select which", 10, 132, dim);
+  text(b, "entry is highlighted. Press OK to boot", 10, 146, dim);
+  text(b, "the selected OS, 'e' to edit, 'c' for a", 10, 160, dim);
+  text(b, "command-line.", 10, 174, dim);
+  if (s.modeStart != 0) {
+    uint32_t elapsed = now() - s.modeStart;
+    int left = elapsed >= k_grubTimeout
+                   ? 0
+                   : static_cast<int>((k_grubTimeout - elapsed + 999) / 1000);
+    char line[48];
+    fmt(line, sizeof(line), "The highlighted entry will be executed");
+    text(b, line, 10, 196, dim);
+    fmt(line, sizeof(line), "automatically in %ds.", left);
+    text(b, line, 10, 210, dim);
+  }
+}
+
+void drawGrubMessage(Band& b) {
+  fill(b, k_screen, KDBlack);
+  KDColor white = rgb(0xD8D8D8);
+  const char* msg = s.grubMessage ? s.grubMessage : "";
+  int y = 8;
+  char line[48];
+  while (*msg && y < 230) {
+    const char* nl = strchr(msg, '\n');
+    int n = nl ? nl - msg : strlen(msg);
+    if (n > 46) {
+      n = 46;
+    }
+    memcpy(line, msg, n);
+    line[n] = 0;
+    text(b, line, 6, y, white);
+    y += 15;
+    msg += n + (nl && msg + n == nl ? 1 : 0);
+  }
+  text(b, "Press any key to continue...", 6, y + 15, white);
+}
+
+void drawMemtest(Band& b) {
+  fill(b, k_screen, rgb(0x0000AA));
+  KDColor white = KDWhite, yellow = rgb(0xFFFF55), cyan = rgb(0x55FFFF);
+  fill(b, {0, 0, 320, 16}, rgb(0xAAAAAA));
+  text(b, "Memtest86+ 7.00   |  NumWorks n0120", 6, 1, KDBlack);
+  uint32_t t = now() - s.modeStart;
+  int pct = static_cast<int>(t * 100 / k_memtestDuration);
+  if (pct > 100) {
+    pct = 100;
+  }
+  char line[48];
+  text(b, "CPU   : STM32F730 Cortex-M7 216 MHz", 6, 24, white);
+  text(b, "L1    : 16 Ko  I-cache + D-cache", 6, 38, white);
+  text(b, "Memory: 256 Ko SRAM  (pas beaucoup)", 6, 52, white);
+  fmt(line, sizeof(line), "Test  : #%d [Moving inversions]", 1 + pct / 15);
+  text(b, line, 6, 72, yellow);
+  fmt(line, sizeof(line), "Pass  : %d %%", pct);
+  text(b, line, 6, 86, white);
+  fill(b, {6, 104, 308, 10}, rgb(0x000066));
+  fill(b, {6, 104, 308 * pct / 100, 10}, cyan);
+  uint32_t addr = 0x20000000 + (t * 7919) % 0x40000;
+  fmt(line, sizeof(line), "Testing: 0x%u", addr);
+  // %x is not supported by fmt: print the address in hex by hand
+  {
+    char hex[16];
+    for (int i = 0; i < 8; i++) {
+      int v = (addr >> (28 - 4 * i)) & 15;
+      hex[i] = v < 10 ? '0' + v : 'A' + v - 10;
+    }
+    hex[8] = 0;
+    fmt(line, sizeof(line), "Testing : 0x%s", hex);
+  }
+  text(b, line, 6, 122, white);
+  text(b, "Errors  : 0", 6, 140, pct == 100 ? rgb(0x55FF55) : white);
+  if (pct == 100) {
+    text(b, "*** PASS : aucune erreur, RAM impeccable ***", 6, 164,
+         rgb(0x55FF55));
+  }
+  fill(b, {0, 224, 320, 16}, rgb(0xAAAAAA));
+  text(b, "Retour / OK : redémarrer", 6, 225, KDBlack);
+}
+
+void drawSplash(Band& b) {
+  fill(b, k_screen, KDBlack);
+  uint32_t t = now() - s.modeStart;
+  if (s.bootLog) {
+    // Verbose boot: systemd lines
+    constexpr const char* k_lines[] = {
+        "Started Journal Service.",
+        "Mounted /boot/efi.",
+        "Reached target Local File Systems.",
+        "Started Network Manager.",
+        "Started Kandinsky Display Server.",
+        "Started Poincare Math Engine.",
+        "Started Escher Window Toolkit.",
+        "Started Python 3 (MicroPython).",
+        "Started Battery Monitor.",
+        "Started CUPS (no printer, obviously).",
+        "Reached target Graphical Interface.",
+        "Starting LightDM Display Manager...",
+        "Started LightDM Display Manager.",
+    };
+    constexpr int n = sizeof(k_lines) / sizeof(k_lines[0]);
+    int shown = static_cast<int>(t / k_bootLogStep);
+    if (shown > n) {
+      shown = n;
+    }
+    int first = shown > 14 ? shown - 14 : 0;
+    for (int i = first; i < shown; i++) {
+      int y = 4 + (i - first) * 16;
+      text(b, "[", 4, y, rgb(0xCCCCCC));
+      text(b, "  OK  ", 11, y, rgb(0x55FF55));
+      text(b, "]", 53, y, rgb(0xCCCCCC));
+      text(b, k_lines[i], 64, y, rgb(0xCCCCCC), Small, Align::Left, 254);
+    }
+    return;
+  }
+  // Plymouth: the leaf and a row of dots
+  int fade = t < 500 ? static_cast<int>(t * 256 / 500) : 256;
+  mask(b, MintIcons::k_maskMintLogoBig, 134, 70, rgb(0x87CF3E), fade);
+  int active = static_cast<int>(t / 180) % 5;
+  for (int i = 0; i < 5; i++) {
+    int x = 136 + i * 12;
+    roundFill(b, {x, 148, 6, 6}, 3, i == active ? KDWhite : rgb(0x555555),
+              fade);
+  }
+}
