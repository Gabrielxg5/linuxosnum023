+Rect windowRect(int i) {
+  const Window& w = s.windows[i];
+  if (w.maximized) {
+    return {0, 0, k_screenWidth, k_panelY};
+  }
+  return {w.x, w.y, Apps::clientWidth(w.app) + 2,
+          Apps::clientHeight(w.app) + k_titleHeight + 1};
+}
+
+Rect clientRect(int i) {
+  Rect r = windowRect(i);
+  return {r.x + 1, r.y + k_titleHeight, r.w - 2, r.h - k_titleHeight - 1};
+}
+
+int windowIndexOf(WindowApp app) {
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    if (s.windows[i].app == app) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+bool windowVisible(int i) {
+  return !s.windows[i].minimized && s.windows[i].workspace == s.workspace;
+}
+
+void focusWindow(int i) {
+  if (i < 0 || i >= s.numberOfWindows) {
+    return;
+  }
+  if (s.windows[i].workspace != s.workspace) {
+    s.workspace = s.windows[i].workspace;
+    invalidateAll();
+  }
+  int top = s.numberOfWindows - 1;
+  bool changed = i != top || s.windows[i].minimized;
+  if (i != top) {
+    releaseKeyboard();
+    invalidate(windowRect(top).inset(-6));
+    Window w = s.windows[i];
+    for (int j = i; j < top; j++) {
+      s.windows[j] = s.windows[j + 1];
+    }
+    s.windows[top] = w;
+  }
+  s.windows[top].minimized = false;
+  if (changed) {
+    invalidate(windowRect(top).inset(-6));
+    invalidate(k_panel);
+  }
+}
+
+void openWindow(WindowApp app) {
+  if (!windowAppAvailable(app)) {
+    return;
+  }
+  int existing = windowIndexOf(app);
+  if (existing >= 0) {
+    focusWindow(existing);
+  } else {
+    if (s.numberOfWindows >= k_maxWindows) {
+      return;
+    }
+    releaseKeyboard();
+    if (s.numberOfWindows > 0) {
+      invalidate(windowRect(s.numberOfWindows - 1));
+    }
+    Window& w = s.windows[s.numberOfWindows++];
+    w.app = app;
+    w.minimized = false;
+    w.maximized = false;
+    w.workspace = s.workspace;
+    int offset = 10 * ((s.numberOfWindows - 1) % 4);
+    int width = Apps::clientWidth(app) + 2;
+    int height = Apps::clientHeight(app) + k_titleHeight + 1;
+    w.x = (k_screenWidth - width) / 2 - 12 + offset;
+    w.y = (k_panelY - height) / 2 - 8 + offset;
+    if (w.x + width > k_screenWidth - 1) {
+      w.x = k_screenWidth - 1 - width;
+    }
+    if (w.y + height > k_panelY - 1) {
+      w.y = k_panelY - 1 - height;
+    }
+    if (w.x < 1) {
+      w.x = 1;
+    }
+    if (w.y < 1) {
+      w.y = 1;
+    }
+    Apps::open(app);
+    invalidate(windowRect(s.numberOfWindows - 1).inset(-6));
+    invalidate(k_panel);
+  }
+  // Games and the terminal take the keyboard right away
+  if (Apps::wantsKeyboardOnClick(app)) {
+    s.keyboardFocus = true;
+    if (app == WindowApp::Terminal) {
+      setAlphaLock(true);
+    }
+    invalidate(windowRect(s.numberOfWindows - 1));
+  }
+}
+
+void closeWindow(int i) {
+  if (i < 0 || i >= s.numberOfWindows) {
+    return;
+  }
+  invalidate(windowRect(i).inset(-6));
+  if (i == s.numberOfWindows - 1) {
+    s.keyboardFocus = false;
+    s.dragging = false;
+    setAlphaLock(false);
+  }
+  for (int j = i; j + 1 < s.numberOfWindows; j++) {
+    s.windows[j] = s.windows[j + 1];
+  }
+  s.numberOfWindows--;
+  if (s.numberOfWindows > 0) {
+    invalidate(windowRect(s.numberOfWindows - 1));
+  }
+  invalidate(k_panel);
+}
